				local KeyFound = false
				local FoundKey = ''
				for _, Key in ipairs(WindowSettings.KeySettings.Key) do
					if KeySystem.Input.InputBox.Text == Key then
						KeyFound = true
						FoundKey = Key
						break
					end
				end
				if KeyFound then
					-- Parse access type from key prefix/content
					if string.find(string.lower(FoundKey), "lifetime") then
						PlayerAccessType = "lifetime"
					elseif string.find(string.lower(FoundKey), "month") then
						PlayerAccessType = "month"
					else
						PlayerAccessType = "lifetime" -- default fallback for untagged keys
