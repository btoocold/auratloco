}

local flyObjects = {}
local noclipConn, speedConn, jumpConn, bhopConn, staminaConn, godConn

local function StartFly()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    for _, obj in pairs(flyObjects) do pcall(function() obj:Destroy() end) end
    flyObjects = {}

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.new()
    bv.Parent = hrp
    table.insert(flyObjects, bv)

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 10000
    bg.CFrame = cam.CFrame
    bg.Parent = hrp
    table.insert(flyObjects, bg)

    hum:ChangeState(Enum.HumanoidStateType.Swimming)

    task.spawn(function()
        while MovementSettings.Fly and char.Parent do
            local h = char:FindFirstChildOfClass("Humanoid")
            if not h then break end
            local cf = cam.CFrame
            local vel = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + cf.LookVector * MovementSettings.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - cf.LookVector * MovementSettings.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - cf.RightVector * MovementSettings.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + cf.RightVector * MovementSettings.FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, MovementSettings.FlySpeed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - Vector3.new(0, MovementSettings.FlySpeed, 0) end
            bv.Velocity = vel
            bg.CFrame = cf
            if h:GetState() ~= Enum.HumanoidStateType.Swimming then h:ChangeState(Enum.HumanoidStateType.Swimming) end
            task.wait()
        end
        for _, obj in pairs(flyObjects) do pcall(function() obj:Destroy() end) end
        flyObjects = {}
    end)
end

local function StopFly()
    MovementSettings.Fly = false
    for _, obj in pairs(flyObjects) do pcall(function() obj:Destroy() end) end
    flyObjects = {}
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
end

