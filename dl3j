local function UpdateCrosshair()
    for _, l in pairs(crosshairLines) do pcall(function() l:Remove() end) end
    crosshairLines = {}
    if not VisualSettings.Crosshair then return end

    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    local s = VisualSettings.CrosshairSize
    local t = VisualSettings.CrosshairThickness
    local col = VisualSettings.CrosshairColor

    local function makeLine(x1, y1, x2, y2, color, thick)
        local out = Drawing.new("Line")
        out.Visible = true; out.From = Vector2.new(x1, y1); out.To = Vector2.new(x2, y2)
        out.Color = Color3.new(0, 0, 0); out.Thickness = thick + 1.5
        table.insert(crosshairLines, out)
        local l = Drawing.new("Line")
        l.Visible = true; l.From = Vector2.new(x1, y1); l.To = Vector2.new(x2, y2)
        l.Color = color; l.Thickness = thick
        table.insert(crosshairLines, l)
    end

    if VisualSettings.CrosshairStyle == "Cross" then
        makeLine(cx - s, cy, cx + s, cy, col, t)
        makeLine(cx, cy - s, cx, cy + s, col, t)
    elseif VisualSettings.CrosshairStyle == "Dot" then
        local dot = Drawing.new("Circle")
        dot.Visible = true; dot.Position = Vector2.new(cx, cy); dot.Radius = t + 2
        dot.Color = col; dot.Filled = true
        table.insert(crosshairLines, dot)
    elseif VisualSettings.CrosshairStyle == "Circle" then
        local c = Drawing.new("Circle")
        c.Visible = true; c.Position = Vector2.new(cx, cy); c.Radius = s
        c.Color = col; c.Filled = false; c.Thickness = t
        table.insert(crosshairLines, c)
    elseif VisualSettings.CrosshairStyle == "T-Shape" then
        makeLine(cx - s, cy, cx + s, cy, col, t)
        makeLine(cx, cy, cx, cy + s, col, t)
    elseif VisualSettings.CrosshairStyle == "Plus" then
        local g = 4
        makeLine(cx - s, cy, cx - g, cy, col, t)
        makeLine(cx + g, cy, cx + s, cy, col, t)
        makeLine(cx, cy - s, cx, cy - g, col, t)
        makeLine(cx, cy + g, cx, cy + s, col, t)
    end
end

