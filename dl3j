--   MACRO / AUTO CLICKER
-- ============================================================

local MacroSettings = {
    AutoClick = false, ClickDelay = 0.1, LoopMacro = false,
    Recording = false, Playing = false,
    Macros = {}, RecordedKeys = {},
}

local macroConns = {}
local cpsCount, cpsFrame, cpsTimer = 0, 0, tick()

local function StartAutoClick()
    if macroConns.click then macroConns.click:Disconnect() end
    macroConns.click = RunService.Heartbeat:Connect(function()
        if not MacroSettings.AutoClick then return end
        pcall(function()
            mouse1press()
            task.wait(MacroSettings.ClickDelay / 2)
            mouse1release()
            cpsCount = cpsCount + 1
        end)
        if tick() - cpsTimer >= 1 then
            cpsFrame = cpsCount; cpsCount = 0; cpsTimer = tick()
        end
        task.wait(MacroSettings.ClickDelay / 2)
    end)
end

local function StopAutoClick()
    MacroSettings.AutoClick = false
    if macroConns.click then macroConns.click:Disconnect(); macroConns.click = nil end
end

local macroRecordStart = 0

local function StartRecording()
    MacroSettings.Recording = true
    MacroSettings.RecordedKeys = {}
    macroRecordStart = tick()
    if macroConns.record then macroConns.record:Disconnect() end
    macroConns.record = UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not MacroSettings.Recording then return end
        local t = tick() - macroRecordStart
        if input.UserInputType == Enum.UserInputType.Keyboard then
            table.insert(MacroSettings.RecordedKeys, {Key = input.KeyCode, Type = "Down", Time = t})
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            table.insert(MacroSettings.RecordedKeys, {Key = "M1", Type = "Down", Time = t})
        end
    end)
end

local function StopRecording()
    MacroSettings.Recording = false
    if macroConns.record then macroConns.record:Disconnect(); macroConns.record = nil end
    if #MacroSettings.RecordedKeys > 0 then
        table.insert(MacroSettings.Macros, {Name = "Macro " .. #MacroSettings.Macros + 1, Keys = MacroSettings.RecordedKeys})
    end
    MacroSettings.RecordedKeys = {}
end

local function PlayMacro(idx)
    if idx < 1 or idx > #MacroSettings.Macros then return end
    MacroSettings.Playing = true
    local macro = MacroSettings.Macros[idx]
    task.spawn(function()
        local prev = 0
        for _, action in ipairs(macro.Keys) do
            if not MacroSettings.Playing then break end
            local delay = action.Time - prev
            if delay > 0 then task.wait(delay) end
            prev = action.Time
            pcall(function()
                if action.Type == "Down" then
                    if action.Key == "M1" then mouse1press()
                    else VirtualInputManager:SendKeyEvent(true, action.Key, false, nil) end
                else
                    if action.Key == "M1" then mouse1release()
                    else VirtualInputManager:SendKeyEvent(false, action.Key, false, nil) end
                end
            end)
        end
        MacroSettings.Playing = false
        if MacroSettings.LoopMacro then task.wait(0.1); PlayMacro(idx) end
    end)
end

