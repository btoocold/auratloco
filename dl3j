local function GetTeam(plr)
    local attr = plr:GetAttribute("TeamID")
    if attr then return tostring(attr) end
    return "Unknown"
end

local function FindTarget()
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestTarget, bestPos, bestScore = nil, nil, Aimbot.FOV / 2
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        if Aimbot.TeamCheck and GetTeam(plr) == GetTeam(player) then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(Aimbot.Hitbox) or char:FindFirstChild("Head")
        if not part then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local vel = root and root.AssemblyLinearVelocity or Vector3.new()
        local pos = part.Position
        if Aimbot.Prediction then
            local dist = (pos - cam.CFrame.Position).Magnitude
            pos = pos + (vel * (dist / 999) * Aimbot.PredStrength)
        end
        local screen, onScreen = cam:WorldToViewportPoint(pos)
        if not onScreen then continue end
        local dist2D = (Vector2.new(screen.X, screen.Y) - center).Magnitude
        local score = dist2D
        if Aimbot.Priority == "LowestHealth" then
            score = score * (hum.Health / hum.MaxHealth)
        elseif Aimbot.Priority == "Random" then
            score = math.random(1, 1000)
        end
        if score < bestScore then
            bestScore = score
            bestTarget = plr
            bestPos = pos
        end
    end
    return bestPos, bestTarget
end

local function StartAimbot()
    if aimConnection then return end
    aimConnection = RunService:BindToRenderStep("DiddyAimbot", Enum.RenderPriority.Camera.Value + 1, function()
        if not Aimbot.Enabled then currentTarget = nil return end
