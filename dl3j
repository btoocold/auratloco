    Tracer = Color3.fromRGB(160, 80, 255),
    HeadDot = Color3.fromRGB(255, 0, 255),
    Skeleton = Color3.fromRGB(255, 255, 255),
}

local espDrawings = {}

local function ClearESP()
    for _, d in pairs(espDrawings) do pcall(function() d:Remove() end) end
    espDrawings = {}
end

local function GetESPColor(plr)
    if not ESP.TeamColor then return ESPColors.Box end
    local team = GetTeam(plr)
    if team == "Police" or team == "1" then return Color3.fromRGB(0, 120, 255) end
    return Color3.fromRGB(255, 50, 50)
end

local function GetCharBounds(char)
    local camera = workspace.CurrentCamera
    if not char or not camera then return nil end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return nil end

    local headTopWorld = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
    local headScreen, headOnScreen = camera:WorldToViewportPoint(headTopWorld)
    if not headOnScreen and headScreen.Z > 0 then return nil end

    local lowestY = hrp.Position.Y - 3.2
    local parts = {"LeftFoot","RightFoot","LeftLowerLeg","RightLowerLeg"}
    for _, pName in pairs(parts) do
        local p = char:FindFirstChild(pName)
        if p and p:IsA("BasePart") then
            local bot = p.Position.Y - p.Size.Y / 2
            if bot < lowestY then lowestY = bot end
        end
    end

    local feetWorld = Vector3.new(hrp.Position.X, lowestY, hrp.Position.Z)
    local feetScreen = camera:WorldToViewportPoint(feetWorld)
    local rootScreen, rootOnScreen = camera:WorldToViewportPoint(hrp.Position)
    if not rootOnScreen then return nil end

    local screenTop = math.min(headScreen.Y, feetScreen.Y)
    local screenBot = math.max(headScreen.Y, feetScreen.Y)
    local height = math.max(screenBot - screenTop, 20)
    local width = height * 0.5

    return {
        cx = rootScreen.X,
        top = screenTop,
        bot = screenBot,
        width = width,
        height = height,
        x = rootScreen.X - width / 2,
        y = screenTop,
        headX = headScreen.X,
        headY = headScreen.Y,
    }
end

local function RenderESP()
    ClearESP()
    local active = ESP.Boxes or ESP.Names or ESP.Distance or ESP.Health or ESP.Tracers or ESP.HeadDot or ESP.Skeletons or ESP.Weapons
    if not active then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not hrp then continue end

        local myChar = player.Character
        if myChar then
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if myHrp and (hrp.Position - myHrp.Position).Magnitude > ESP.MaxDistance then continue end
        end

        local b = GetCharBounds(char)
        if not b then continue end

        local col = GetESPColor(plr)

        -- Box ESP (accurate player height)
        if ESP.Boxes then
            local outlineBox = Drawing.new("Square")
            outlineBox.Visible = true
            outlineBox.Position = Vector2.new(b.x - 1, b.y - 1)
            outlineBox.Size = Vector2.new(b.width + 2, b.height + 2)
            outlineBox.Color = Color3.new(0, 0, 0)
            outlineBox.Thickness = 3
            outlineBox.Filled = false
            table.insert(espDrawings, outlineBox)

            local mainBox = Drawing.new("Square")
            mainBox.Visible = true
            mainBox.Position = Vector2.new(b.x, b.y)
            mainBox.Size = Vector2.new(b.width, b.height)
            mainBox.Color = col
            mainBox.Thickness = 1.5
            mainBox.Filled = false
            table.insert(espDrawings, mainBox)

            -- Corner brackets
            local cS = b.width * 0.25
            local corners = {
                {Vector2.new(b.x, b.y), Vector2.new(b.x + cS, b.y)},
                {Vector2.new(b.x, b.y), Vector2.new(b.x, b.y + cS)},
                {Vector2.new(b.x + b.width, b.y), Vector2.new(b.x + b.width - cS, b.y)},
                {Vector2.new(b.x + b.width, b.y), Vector2.new(b.x + b.width, b.y + cS)},
                {Vector2.new(b.x, b.y + b.height), Vector2.new(b.x + cS, b.y + b.height)},
                {Vector2.new(b.x, b.y + b.height), Vector2.new(b.x, b.y + b.height - cS)},
                {Vector2.new(b.x + b.width, b.y + b.height), Vector2.new(b.x + b.width - cS, b.y + b.height)},
                {Vector2.new(b.x + b.width, b.y + b.height), Vector2.new(b.x + b.width, b.y + b.height - cS)},
            }
            for _, c in pairs(corners) do
                local cl = Drawing.new("Line")
                cl.Visible = true
                cl.From = c[1]
                cl.To = c[2]
                cl.Color = Color3.new(1, 1, 1)
                cl.Thickness = 2
                table.insert(espDrawings, cl)
            end
        end

        -- Health bar (left side, matches box height)
        if ESP.Health then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bx = b.x - 6

            local bgBar = Drawing.new("Square")
            bgBar.Visible = true
            bgBar.Position = Vector2.new(bx - 1, b.y - 1)
            bgBar.Size = Vector2.new(5, b.height + 2)
            bgBar.Color = Color3.new(0, 0, 0)
            bgBar.Filled = true
            table.insert(espDrawings, bgBar)

            if pct > 0 then
                local fillBar = Drawing.new("Square")
                fillBar.Visible = true
                fillBar.Position = Vector2.new(bx, b.y + b.height * (1 - pct))
                fillBar.Size = Vector2.new(3, b.height * pct)
                fillBar.Color = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 0)
                fillBar.Filled = true
                table.insert(espDrawings, fillBar)
            end
        end

        -- Name
        if ESP.Names then
            local nameText = Drawing.new("Text")
            nameText.Visible = true
            nameText.Text = plr.Name
            nameText.Position = Vector2.new(b.cx, b.y - 16)
            nameText.Size = 14
            nameText.Color = ESPColors.Name
            nameText.Outline = true
            nameText.Center = true
            nameText.Font = 2
            table.insert(espDrawings, nameText)
        end

        -- Distance
        if ESP.Distance then
            local myChar2 = player.Character
            if myChar2 then
                local myHrp2 = myChar2:FindFirstChild("HumanoidRootPart")
                if myHrp2 then
                    local d = math.floor((hrp.Position - myHrp2.Position).Magnitude)
                    local dText = Drawing.new("Text")
                    dText.Visible = true
                    dText.Text = "[" .. d .. "m]"
                    dText.Position = Vector2.new(b.cx, b.bot + 3)
                    dText.Size = 11
                    dText.Color = Color3.fromRGB(200, 200, 200)
                    dText.Outline = true
                    dText.Center = true
                    table.insert(espDrawings, dText)
                end
            end
        end

        -- Weapon
        if ESP.Weapons then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                local yOff = ESP.Distance and 15 or 3
                local wText = Drawing.new("Text")
                wText.Visible = true
                wText.Text = tool.Name
                wText.Position = Vector2.new(b.cx, b.bot + yOff)
                wText.Size = 11
                wText.Color = Color3.fromRGB(255, 200, 50)
                wText.Outline = true
                wText.Center = true
                table.insert(espDrawings, wText)
            end
        end

        -- Head dot
        if ESP.HeadDot then
            local dotOut = Drawing.new("Circle")
            dotOut.Visible = true
            dotOut.Position = Vector2.new(b.headX, b.headY)
            dotOut.Radius = 5
            dotOut.Color = Color3.new(0, 0, 0)
            dotOut.Filled = true
            table.insert(espDrawings, dotOut)

            local dot = Drawing.new("Circle")
            dot.Visible = true
            dot.Position = Vector2.new(b.headX, b.headY)
            dot.Radius = 3.5
            dot.Color = ESPColors.HeadDot
            dot.Filled = true
            table.insert(espDrawings, dot)
        end

        -- Tracers (bottom of screen to feet)
        if ESP.Tracers then
            local cx = camera.ViewportSize.X / 2
            local cy = camera.ViewportSize.Y

            local trOut = Drawing.new("Line")
            trOut.Visible = true
            trOut.From = Vector2.new(cx, cy)
            trOut.To = Vector2.new(b.cx, b.bot)
            trOut.Color = Color3.new(0, 0, 0)
            trOut.Thickness = 3
            table.insert(espDrawings, trOut)

            local tr = Drawing.new("Line")
            tr.Visible = true
            tr.From = Vector2.new(cx, cy)
            tr.To = Vector2.new(b.cx, b.bot)
            tr.Color = col
            tr.Thickness = 1.5
            table.insert(espDrawings, tr)
        end

        -- Skeleton
        if ESP.Skeletons then
            local bones = {
                {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
                {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
                {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
                {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
                {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
            }
            for _, bone in pairs(bones) do
                local p1 = char:FindFirstChild(bone[1])
                local p2 = char:FindFirstChild(bone[2])
                if p1 and p2 then
                    local s1, on1 = camera:WorldToViewportPoint(p1.Position)
                    local s2, on2 = camera:WorldToViewportPoint(p2.Position)
                    if on1 and on2 then
                        local sk = Drawing.new("Line")
                        sk.Visible = true
                        sk.From = Vector2.new(s1.X, s1.Y)
                        sk.To = Vector2.new(s2.X, s2.Y)
                        sk.Color = ESPColors.Skeleton
                        sk.Thickness = 1
                        table.insert(espDrawings, sk)
                    end
                end
            end
        end
    end
end

