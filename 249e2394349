local function BuildRainbowSequence()
    local seq = {}
    for i = 1, #VC_COLORS do
        local pos = (i - 1) / (#VC_COLORS - 1)
        table.insert(seq, ColorSequenceKeypoint.new(pos, VC_COLORS[i]))
    end
    return ColorSequence.new(seq)
