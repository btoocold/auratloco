local function DoTeleport(targetCF, holdTime)
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        NotificationLibrary:SendNotification("Teleport", "No character!", 2)
        return
    end
    _tpToken = _tpToken + 1
    local myToken = _tpToken
    task.spawn(function()
        local dur = holdTime or 3
        local startT = tick()
        while myToken == _tpToken and (tick() - startT) < dur do
            local c = LP.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then
                h.CFrame = targetCF
                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

