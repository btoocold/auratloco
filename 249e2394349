-- ANTI-TAMPER: HIDE PROXIMITY PROMPTS FROM DEX
-- ================================================
local function hideProximityPrompts()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt:SetAttribute("_hidden", true)
            prompt.RequiresLineOfSight = false
            prompt.Style = Enum.ProximityPromptStyle.Default
        end
    end
end

local function antiDex()
    if _G.Dex then
        local originalRefresh = _G.Dex.refresh
        _G.Dex.refresh = function(...)
            local args = {...}
            for i, obj in ipairs(args) do
                if obj and obj:IsA("ProximityPrompt") then
                    args[i] = nil
                end
            end
            return originalRefresh(unpack(args))
        end
    end
end

local function hideFromScans()
    local mt = getmetatable(workspace) or {}
    local oldGetChildren = mt.__index and mt.__index.GetChildren
    
    if oldGetChildren then
        mt.__index.GetChildren = function(self)
            local children = oldGetChildren(self)
            local filtered = {}
            for _, child in ipairs(children) do
                if not (child:IsA("ProximityPrompt") and child:GetAttribute("_hidden")) then
                    table.insert(filtered, child)
                end
            end
            return filtered
        end
    end
end

local function addTamperProtection()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local mt = getmetatable(prompt) or {}
            mt.__index = function(t, k)
                if k == "Enabled" or k == "MaxActivationDistance" or k == "HoldDuration" then
                    local defaults = {
                        Enabled = true,
                        MaxActivationDistance = 10,
                        HoldDuration = 1
                    }
                    return defaults[k] or rawget(t, k)
                end
                return rawget(t, k)
            end
            setmetatable(prompt, mt)
        end
    end
end

