-- ──────────────────────────────────────────────
--  STRAFE / BHOP
--  Uses AssemblyLinearVelocity (replaces deprecated .Velocity).
--  Only overrides XZ when a key is held — never touches Y so
--  normal jumping and falling work uninterrupted.
-- ──────────────────────────────────────────────
local STRAFE_SPEED   = 30
local BHOP_POWER     = 40
local StrafeConn     = nil

local StrafeKeys = { W=false, A=false, S=false, D=false, Space=false }

local strafeInputBegan = UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local k = inp.KeyCode
    if k == Enum.KeyCode.W     then StrafeKeys.W     = true
    elseif k == Enum.KeyCode.A then StrafeKeys.A     = true
    elseif k == Enum.KeyCode.S then StrafeKeys.S     = true
    elseif k == Enum.KeyCode.D then StrafeKeys.D     = true
    elseif k == Enum.KeyCode.Space then StrafeKeys.Space = true end
end)

local strafeInputEnded = UserInputService.InputEnded:Connect(function(inp)
    local k = inp.KeyCode
    if k == Enum.KeyCode.W     then StrafeKeys.W     = false
    elseif k == Enum.KeyCode.A then StrafeKeys.A     = false
    elseif k == Enum.KeyCode.S then StrafeKeys.S     = false
    elseif k == Enum.KeyCode.D then StrafeKeys.D     = false
    elseif k == Enum.KeyCode.Space then StrafeKeys.Space = false end
end)

local function StartStrafe()
    if StrafeConn then return end
    StrafeConn = RunService.Heartbeat:Connect(function()
        if not SelfConfig.StrafeEnabled then
            StrafeConn:Disconnect(); StrafeConn = nil; return
        end
        local c = lplayer.Character; if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        local hum  = c:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        -- Build move direction from held keys + camera facing
        local dir = Vector3.zero
        local cf  = Workspace.CurrentCamera.CFrame
        if StrafeKeys.W then dir = dir + cf.LookVector end
        if StrafeKeys.S then dir = dir - cf.LookVector end
        if StrafeKeys.A then dir = dir - cf.RightVector end
        if StrafeKeys.D then dir = dir + cf.RightVector end

        -- Only act when a directional key is held
        if dir.Magnitude > 0 then
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatDir.Magnitude > 0 then
                flatDir = flatDir.Unit
            end

            local isInAir = hum:GetState() == Enum.HumanoidStateType.Freefall
                         or hum:GetState() == Enum.HumanoidStateType.Jumping

            local speed = STRAFE_SPEED * (isInAir and 1.5 or 1)

            -- Preserve current Y so we never interfere with jump arc
            local curY = root.AssemblyLinearVelocity.Y
            root.AssemblyLinearVelocity = Vector3.new(
                flatDir.X * speed,
                curY,
                flatDir.Z * speed
            )
        end

        -- Bhop: only trigger when just landing (Y vel near 0 from above)
        if StrafeKeys.Space then
            local curY = root.AssemblyLinearVelocity.Y
            if curY > -2 and curY < 2 then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    BHOP_POWER,
                    root.AssemblyLinearVelocity.Z
                )
            end
        end
    end)
end

local function StopStrafe()
    if StrafeConn then StrafeConn:Disconnect(); StrafeConn = nil end
end

