-- ──────────────────────────────────────────────
--  FOV — Arsenal-specific fix
--  Arsenal controls zoom through its own CameraController, not FieldOfView.
--  We hook the zoom via MaxZoomDistance on the camera, AND patch any
--  Arsenal camera module we can find in PlayerScripts.
-- ──────────────────────────────────────────────
local FOV_STEP_NAME = "WapsFOVEnforce"
local FOVBound = false

-- Arsenal's default zoom is ~12.5 studs. We map FOV degrees to zoom distance:
-- higher FOV = smaller zoom distance (wider view). FOV 70 = zoom 12.5, FOV 120 = zoom ~5
local function fovToZoom(fov)
    return math.clamp(12.5 * (70 / math.max(fov, 1)), 0.5, 50)
end

-- Search PlayerScripts for Arsenal's camera/zoom module
local _camMod = nil
local function findCamMod()
    if _camMod then return _camMod end
    local ps = lplayer:FindFirstChild("PlayerScripts")
    if not ps then return nil end
    for _, obj in ipairs(ps:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local ok, mod = pcall(require, obj)
            if ok and type(mod) == "table" then
                if type(mod.zoom) == "number" or type(mod.Zoom) == "number"
                   or type(mod.currentZoom) == "number" then
                    _camMod = mod
                    return mod
                end
            end
        end
    end
    return nil
end

-- Tracks the FieldOfView intercept connection so we can disconnect on disable
local FOVIntercept = nil

local function applyFOVNow(cam, fov)
    -- 1) Direct write — works in lobby
    pcall(function() cam.FieldOfView = fov end)
    -- 2) sethiddenproperty bypass — bypasses Arsenal's LocalScript lock in-game
    pcall(function() sethiddenproperty(cam, "FieldOfView", fov) end)
    -- 3) Force zoom distances so Arsenal's zoom controller maps to our FOV
    local z = fovToZoom(fov)
    pcall(function()
        cam.MaxZoomDistance = z
        cam.MinZoomDistance = math.max(z - 0.1, 0.5)
    end)
    -- 4) Patch any zoom module found in PlayerScripts
    local mod = findCamMod()
    if mod then
        pcall(function() if mod.zoom        ~= nil then mod.zoom        = z end end)
        pcall(function() if mod.Zoom        ~= nil then mod.Zoom        = z end end)
        pcall(function() if mod.currentZoom ~= nil then mod.currentZoom = z end end)
    end
end

local function StartFOVEnforce()
    if FOVBound then return end
    FOVBound = true
    local cam = Workspace.CurrentCamera

    -- Intercept: every time Arsenal resets FieldOfView, slam it back instantly
    if FOVIntercept then FOVIntercept:Disconnect() end
    FOVIntercept = cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if not SelfConfig.CameraFOVOn then return end
        local cur = cam.FieldOfView
        local want = SelfConfig.CameraFOV
        if math.abs(cur - want) > 0.5 then
            task.defer(function()
                if SelfConfig.CameraFOVOn then applyFOVNow(cam, want) end
            end)
        end
    end)

    -- Also enforce every frame at highest possible priority as a backstop
    RunService:BindToRenderStep(FOV_STEP_NAME, Enum.RenderPriority.Last.Value + 1000, function()
        if not SelfConfig.CameraFOVOn then
            RunService:UnbindFromRenderStep(FOV_STEP_NAME)
            FOVBound = false
            if FOVIntercept then FOVIntercept:Disconnect(); FOVIntercept = nil end
            pcall(function() Workspace.CurrentCamera.FieldOfView = 70 end)
            pcall(function() Workspace.CurrentCamera.MaxZoomDistance = 12.5 end)
            return
        end
        applyFOVNow(Workspace.CurrentCamera, SelfConfig.CameraFOV)
    end)
end

local function ApplyCameraFOV()
    if SelfConfig.CameraFOVOn then
        _camMod = nil -- re-search on every enable
        if FOVBound then
            RunService:UnbindFromRenderStep(FOV_STEP_NAME)
            FOVBound = false
        end
        if FOVIntercept then FOVIntercept:Disconnect(); FOVIntercept = nil end
        StartFOVEnforce()
    else
        if FOVBound then
            RunService:UnbindFromRenderStep(FOV_STEP_NAME)
            FOVBound = false
        end
        if FOVIntercept then FOVIntercept:Disconnect(); FOVIntercept = nil end
        pcall(function() Workspace.CurrentCamera.FieldOfView = 70 end)
        pcall(function()
            Workspace.CurrentCamera.MaxZoomDistance = 12.5
            Workspace.CurrentCamera.MinZoomDistance = 0.5
        end)
    end
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Cam = Workspace.CurrentCamera
    if FOVBound then
        RunService:UnbindFromRenderStep(FOV_STEP_NAME)
        FOVBound = false
    end
    if FOVIntercept then FOVIntercept:Disconnect(); FOVIntercept = nil end
    if SelfConfig.CameraFOVOn then StartFOVEnforce() end
end)

