local RTXConfig   = { Enabled=false }
local RTXOriginal = {}
local RTXEffects  = {}

local function ApplyRTX()
    if RTXConfig.Enabled then
        if not RTXOriginal.saved then
            RTXOriginal.saved=true
            RTXOriginal.Ambient=Lighting.Ambient
            RTXOriginal.OutdoorAmbient=Lighting.OutdoorAmbient
            RTXOriginal.ClockTime=Lighting.ClockTime
            RTXOriginal.FogEnd=Lighting.FogEnd
            RTXOriginal.GlobalShadows=Lighting.GlobalShadows
            RTXOriginal.EnvDiff=Lighting.EnvironmentDiffuseScale
            RTXOriginal.EnvSpec=Lighting.EnvironmentSpecularScale
        end
        Lighting.Ambient=Color3.fromRGB(120,120,140)
        Lighting.OutdoorAmbient=Color3.fromRGB(160,170,200); Lighting.ClockTime=14
        Lighting.FogEnd=100000; Lighting.GlobalShadows=true
        Lighting.EnvironmentDiffuseScale=1; Lighting.EnvironmentSpecularScale=1
        if not RTXEffects.Bloom then
            local b=Instance.new("BloomEffect"); b.Name="RTX_Bloom"
            b.Intensity=1.2; b.Size=24; b.Threshold=0.85; b.Parent=Lighting
            RTXEffects.Bloom=b
        end
        if not RTXEffects.SunRays then
            local s=Instance.new("SunRaysEffect"); s.Name="RTX_SunRays"
            s.Intensity=0.25; s.Spread=0.5; s.Parent=Lighting
            RTXEffects.SunRays=s
        end
        if not RTXEffects.CC then
            local c=Instance.new("ColorCorrectionEffect"); c.Name="RTX_CC"
            -- No brightness boost, no tint — pure 100% saturation only
            c.Brightness=0; c.Contrast=0.15; c.Saturation=1
            c.TintColor=Color3.fromRGB(255,255,255); c.Parent=Lighting
            RTXEffects.CC=c
        end
        if not RTXEffects.DOF then
            local d=Instance.new("DepthOfFieldEffect"); d.Name="RTX_DOF"
            d.FarIntensity=0.35; d.NearIntensity=0; d.FocusDistance=50
            d.InFocusRadius=30; d.Parent=Lighting
            RTXEffects.DOF=d
        end
        if not RTXEffects.Atmo then
            local a=Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
            a.Name="RTX_Atmo"; a.Density=0.35; a.Offset=0.25
            a.Color=Color3.fromRGB(199,199,199); a.Decay=Color3.fromRGB(100,120,130)
            a.Glare=0.1; a.Haze=1.5; a.Parent=Lighting
            RTXEffects.Atmo=a
        end
    else
        for _,e in pairs(RTXEffects) do pcall(function() e:Destroy() end) end
        RTXEffects={}
        if RTXOriginal.saved then
            Lighting.Ambient=RTXOriginal.Ambient
            Lighting.OutdoorAmbient=RTXOriginal.OutdoorAmbient; Lighting.ClockTime=RTXOriginal.ClockTime
            Lighting.FogEnd=RTXOriginal.FogEnd; Lighting.GlobalShadows=RTXOriginal.GlobalShadows
            Lighting.EnvironmentDiffuseScale=RTXOriginal.EnvDiff
            Lighting.EnvironmentSpecularScale=RTXOriginal.EnvSpec
        end
    end
end

