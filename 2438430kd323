RunService.RenderStepped:Connect(function()
    AimAssist()
    if AimConfig.FOVCircleVisible then
        local t=tick(); local pulse=0.5+0.5*math.sin(t*3)
        local ac=Color3.fromHSV((t*0.1)%1,1,1)
        fovStroke.Thickness=1.5+pulse*2; fovStroke.Color=ac
        FOVCircle.BackgroundColor3=ac; FOVCircle.BackgroundTransparency=0.85
    end
end)

