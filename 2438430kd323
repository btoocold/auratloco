local function isSameTeam(plr)
    if lplayer.Team==nil or plr.Team==nil then return true end
    return lplayer.Team==plr.Team
end
local function isEnemy(plr)
    if plr==lplayer then return false end
    if AimConfig.TeamCheck and isSameTeam(plr) then return false end
    return true
end
local function isVisible(targetPos, targetChar)
    if not AimConfig.WallCheck then return true end
    local origin=Cam.CFrame.Position
    local rayParams=RaycastParams.new()
    rayParams.FilterType=Enum.RaycastFilterType.Exclude
    local ex={lplayer.Character}
    if targetChar then table.insert(ex,targetChar) end
    rayParams.FilterDescendantsInstances=ex
    return Workspace:Raycast(origin,(targetPos-origin),rayParams)==nil
end

