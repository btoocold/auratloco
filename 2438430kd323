                local t=ChamsSection:Toggle({Name="Enable",Flag="ChamsEnabled",Default=false,
                    Callback=function(v) ESPConfig.Drawing.Chams.Enabled=v; RefreshAllElements() end})
                t:Colorpicker({Name="Fill Color",Flag="ChamsFill",Default=Color3.fromRGB(119,120,255),
                    Callback=function(v,a) ESPConfig.Drawing.Chams.FillRGB=v; ESPConfig.Drawing.Chams.Fill_Transparency=a*100; RefreshAllElements() end})
                t:Colorpicker({Name="Outline Color",Flag="ChamsOutline",Default=Color3.fromRGB(255,255,255),
                    Callback=function(v,a) ESPConfig.Drawing.Chams.OutlineRGB=v; ESPConfig.Drawing.Chams.Outline_Transparency=a*100; RefreshAllElements() end})
                ChamsSection:Toggle({Name="Thermal",Flag="ChamsThermal",Default=false,
                    Callback=function(v) ESPConfig.Drawing.Chams.Thermal=v; RefreshAllElements() end})
                ChamsSection:Toggle({Name="Team Check",Flag="ChamsTeamCheck",Default=false,
                    Callback=function(v) ESPConfig.TeamCheck=v end})
            end

            -- RTX Mode
            local RTXSection=VisualsSub:Section({Name="RTX Mode",Side="Left"})
            RTXSection:Toggle({Name="RTX Mode",Flag="RTX_Enable",Default=false,
                Callback=function(v) RTXConfig.Enabled=v; ApplyRTX() end})

            -- Skybox
            local SkyboxSection=VisualsSub:Section({Name="Skybox",Side="Right"})
            SkyboxSection:Toggle({Name="Enable",Flag="SkyboxEnabled",Default=false,
                Callback=function(v) SkyboxConfig.Enabled=v; ApplySkybox() end})
            SkyboxSection:Dropdown({Name="Skybox",Flag="SkyboxPicker",Items=SkyboxNames,Multi=false,Default=1,
                Callback=function(v) SkyboxConfig.Current=v; ApplySkybox() end})

            -- World / Lighting
            local WorldLeft=VisualsSub:Section({Name="World Color",Side="Left"})
            do
                -- Ambient
                local ambTog=WorldLeft:Toggle({Name="Custom Ambient",Flag="World_AmbientTog",Default=false,
                    Callback=function(v) WorldConfig.AmbientEnabled=v; ApplyWorld() end})
                ambTog:Colorpicker({Name="Ambient Color",Flag="World_AmbientColor",Default=Color3.fromRGB(128,128,128),
                    Callback=function(v) WorldConfig.AmbientColor=v; ApplyWorld() end})

                -- Fog
                WorldLeft:Toggle({Name="Custom Fog",Flag="World_FogTog",Default=false,
                    Callback=function(v) WorldConfig.FogEnabled=v; ApplyWorld() end})
                -- Fog End distance slider (how far fog starts fading in)
                WorldLeft:Slider({Name="Fog Distance",Flag="World_FogEnd",Min=10,Default=1000,Max=5000,Suffix="st",Decimals=1,
                    Callback=function(v) WorldConfig.FogEnd=v; ApplyWorld() end})
            end

            local WorldRight=VisualsSub:Section({Name="World Lighting",Side="Right"})
            do
                -- Brightness
                WorldRight:Toggle({Name="Custom Brightness",Flag="World_BrightTog",Default=false,
                    Callback=function(v) WorldConfig.BrightnessEnabled=v; ApplyWorld() end})
                WorldRight:Slider({Name="Brightness",Flag="World_Brightness",Min=1,Default=20,Max=100,Suffix="%",Decimals=1,
                    Callback=function(v) WorldConfig.Brightness=v/10; ApplyWorld() end})

                -- Time of Day
                WorldRight:Toggle({Name="Custom Time",Flag="World_TimeTog",Default=false,
                    Callback=function(v) WorldConfig.TimeEnabled=v; ApplyWorld() end})
                WorldRight:Slider({Name="Time of Day",Flag="World_Time",Min=1,Default=140,Max=240,Suffix="h",Decimals=1,
                    Callback=function(v) WorldConfig.TimeOfDay=v/10; ApplyWorld() end})
            end
        end

        -- ── GUN MODS ─────────────────────────────────────────────────
        do
            local L=GunModsSub:Section({Name="Ammo & Fire",Side="Left"})
            local R=GunModsSub:Section({Name="Accuracy",Side="Right"})
            L:Toggle({Name="Infinite Ammo",Flag="GM_InfAmmo",Default=false,
                Callback=function(v) GunModsConfig.InfiniteAmmo=v; ApplyGunMods(GetCurrentTool()) end})
            L:Toggle({Name="Rapid Fire",Flag="GM_RapidFire",Default=false,
                Callback=function(v) GunModsConfig.RapidFire=v; ApplyGunMods(GetCurrentTool()) end})
            L:Toggle({Name="Always Auto",Flag="GM_AlwaysAuto",Default=false,
                Callback=function(v) GunModsConfig.AlwaysAuto=v; ApplyGunMods(GetCurrentTool()) end})
            R:Toggle({Name="No Spread",Flag="GM_NoSpread",Default=false,
                Callback=function(v) GunModsConfig.NoSpread=v; ApplyGunMods(GetCurrentTool()) end})
            R:Toggle({Name="No Recoil",Flag="GM_NoRecoil",Default=false,
                Callback=function(v) GunModsConfig.NoRecoil=v; ApplyGunMods(GetCurrentTool()) end})
            R:Toggle({Name="No Reload",Flag="GM_NoReload",Default=false,
                Callback=function(v) GunModsConfig.NoReload=v; PatchArsenalWeapons() end})
            R:Toggle({Name="Instant Equip",Flag="GM_InstantEquip",Default=false,
                Callback=function(v) GunModsConfig.InstantEquip=v; PatchArsenalWeapons() end})
        end

        -- ── SELF ─────────────────────────────────────────────────────
        do
            local Mov =SelfSub:Section({Name="Movement",Side="Left"})
            local Misc=SelfSub:Section({Name="Misc",Side="Right"})

            -- Walk Speed (Decimals=1 — library bug workaround for Decimals=0 showing NaN)
            Mov:Toggle({Name="Walk Speed",Flag="Self_WalkSpeedToggle",Default=false,
                Callback=function(v) SelfConfig.WalkSpeedOn=v; ApplyWalkSpeed() end})
            Mov:Slider({Name="Speed",Flag="Self_WalkSpeedValue",Min=1,Default=16,Max=250,Suffix=" WS",Decimals=1,
                Callback=function(v) SelfConfig.WalkSpeed=math.floor(v); ApplyWalkSpeed() end})

            -- Fly
            Mov:Toggle({Name="Fly",Flag="Self_Fly",Default=false,
                Callback=function(v) SelfConfig.FlyEnabled=v; if v then StartFly() else StopFly() end end})
            Mov:Slider({Name="Fly Speed",Flag="Self_FlySpeedValue",Min=5,Default=50,Max=500,Suffix=" FS",Decimals=1,
                Callback=function(v) SelfConfig.FlySpeed=math.floor(v) end})

            -- FOV
            Mov:Toggle({Name="Custom FOV",Flag="Self_FOVToggle",Default=false,
                Callback=function(v) SelfConfig.CameraFOVOn=v; ApplyCameraFOV() end})
            Mov:Slider({Name="FOV",Flag="Self_FOVValue",Min=30,Default=70,Max=170,Suffix="*",Decimals=1,
                Callback=function(v) SelfConfig.CameraFOV=math.floor(v); ApplyCameraFOV() end})

            -- Misc
            Misc:Toggle({Name="Infinite Jump",Flag="Self_InfJump",Default=true,
                Callback=function(v) SelfConfig.InfiniteJump=v end})
            Misc:Toggle({Name="No Clip",Flag="Self_NoClip",Default=false,
                Callback=function(v) SelfConfig.NoClip=v; if v then StartNoClip() end end})
            Misc:Toggle({Name="Strafe / Bhop",Flag="Self_Strafe",Default=false,
                Callback=function(v) SelfConfig.StrafeEnabled=v; if v then StartStrafe() else StopStrafe() end end})
        end
    end
end

