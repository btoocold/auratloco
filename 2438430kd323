local GunModsConfig = {
    InfiniteAmmo = false,
    RapidFire    = false,
    AlwaysAuto   = false,
    NoSpread     = false,
    NoRecoil     = false,
    NoReload     = false,
    InstantEquip = false,
}

-- Arsenal stores weapon values in ReplicatedStorage.Weapons — poll and patch them
local RepStorage = game:GetService("ReplicatedStorage")
local function PatchArsenalWeapons()
    pcall(function()
        local weapons = RepStorage:FindFirstChild("Weapons")
        if not weapons then return end
        for _, v in ipairs(weapons:GetDescendants()) do
            local n = v.Name
            if GunModsConfig.InfiniteAmmo then
                if n=="Ammo" or n=="MaxAmmo" or n=="StoredAmmo" or n=="MagSize" or n=="ammocount" or n=="ammocount2" then
                    pcall(function() v.Value = math.min(v.Value > 0 and 300 or v.Value, 300) end)
                end
            end
            if GunModsConfig.RapidFire then
                if n=="FireRate" or n=="fire_rate" or n=="Cooldown" then
                    pcall(function() v.Value = 0.02 end)
                end
                if n=="Auto" then pcall(function() v.Value = true end) end
            end
            if GunModsConfig.NoRecoil then
                if n=="RecoilControl" then pcall(function() v.Value = 0 end) end
                if n=="MaxSpread" or n=="Spread" then pcall(function() v.Value = 0 end) end
            end
            if GunModsConfig.NoReload then
                if n=="ReloadTime" then pcall(function() v.Value = 0 end) end
                if n=="ReloadSpeed" then pcall(function() v.Value = 999 end) end
            end
            if GunModsConfig.InstantEquip then
                if n=="EquipTime" then pcall(function() v.Value = 0 end) end
            end
        end
    end)
    -- Also patch PlayerGui ammo counters (Arsenal-specific)
    pcall(function()
        local gui = lplayer.PlayerGui:FindFirstChild("GUI")
        if gui then
            local vars = gui:FindFirstChild("Client") and gui.Client:FindFirstChild("Variables")
            if vars then
                if GunModsConfig.InfiniteAmmo then
                    if vars:FindFirstChild("ammocount") then vars.ammocount.Value = 300 end
                    if vars:FindFirstChild("ammocount2") then vars.ammocount2.Value = 300 end
                end
            end
        end
    end)
end

-- Run Arsenal patcher every 2 seconds when any gun mod is active
task.spawn(function()
    while true do
        task.wait(2)
        if GunModsConfig.InfiniteAmmo or GunModsConfig.RapidFire or GunModsConfig.NoRecoil
           or GunModsConfig.NoReload or GunModsConfig.InstantEquip then
            PatchArsenalWeapons()
        end
    end
end)

