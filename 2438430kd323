    WorldOriginal.FogEnd        = Lighting.FogEnd
    WorldOriginal.Brightness    = Lighting.Brightness
    WorldOriginal.ClockTime     = Lighting.ClockTime
end

local function ApplyWorld()
    SaveWorldOriginals()
    if WorldConfig.AmbientEnabled then
        Lighting.Ambient        = WorldConfig.AmbientColor
        Lighting.OutdoorAmbient = WorldConfig.AmbientColor
    else
        Lighting.Ambient        = WorldOriginal.Ambient
        Lighting.OutdoorAmbient = WorldOriginal.OutdoorAmbient
    end
    if WorldConfig.FogEnabled then
        Lighting.FogColor = WorldConfig.FogColor
        Lighting.FogStart = WorldConfig.FogStart
        Lighting.FogEnd   = WorldConfig.FogEnd
    else
        Lighting.FogColor = WorldOriginal.FogColor
        Lighting.FogStart = WorldOriginal.FogStart
        Lighting.FogEnd   = WorldOriginal.FogEnd
    end
    if WorldConfig.BrightnessEnabled then
        Lighting.Brightness = WorldConfig.Brightness
    else
        Lighting.Brightness = WorldOriginal.Brightness
    end
    if WorldConfig.TimeEnabled then
        Lighting.ClockTime = WorldConfig.TimeOfDay
