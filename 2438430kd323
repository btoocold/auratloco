local function AimAssist()
    if not AimConfig.Enabled then return end
    local closest,shortestAngle=nil,math.huge
    local cPos=Cam.CFrame.Position; local cLook=Cam.CFrame.LookVector
    local sc=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y/2)
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=lplayer and player.Character and isEnemy(player) then
            local tp=player.Character:FindFirstChild(AimConfig.AimPart)
            if tp then
                if not isVisible(tp.Position,player.Character) then continue end
                local sp,on=Cam:WorldToViewportPoint(tp.Position)
                if on then
                    local sd=(Vector2.new(sp.X,sp.Y)-sc).Magnitude
                    if sd<AimConfig.FOV then
                        local angle=math.acos(math.clamp(cLook:Dot((tp.Position-cPos).Unit),-1,1))
                        if angle<shortestAngle then shortestAngle=angle; closest=tp end
                    end
                end
            end
        end
    end
    if closest then Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(cPos,closest.Position),AimConfig.Smoothness) end
end

