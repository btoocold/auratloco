local GunModConnections={}
local function GetCurrentTool()
    local c=lplayer.Character; return c and c:FindFirstChildOfClass("Tool")
end

local function ApplyGunMods(tool)
    for _,c in pairs(GunModConnections) do pcall(function() c:Disconnect() end) end
    GunModConnections={}
    if not tool then return end

    local function hookAmmo(v)
        if not v then return end
        -- Clamp to 300 max so Arsenal guns don't break (game hard-caps at 300)
        local magSize = math.clamp(math.max(v.Value, 30), 1, 300)
        -- Immediately top up so Arsenal sees a full mag on equip
        if GunModsConfig.InfiniteAmmo then pcall(function() v.Value = magSize end) end
        local conn = v.Changed:Connect(function(nv)
            if GunModsConfig.InfiniteAmmo then
                -- Intercept the moment it drops below 2 — Arsenal checks for 0 before allowing shot
                if nv < 2 then
                    task.defer(function()
                        if v and v.Parent and GunModsConfig.InfiniteAmmo then
                            v.Value = magSize
                        end
                    end)
                end
            end
        end)
        table.insert(GunModConnections, conn)
    end

    if GunModsConfig.InfiniteAmmo then
        hookAmmo(tool:FindFirstChild("Ammo"))
        hookAmmo(tool:FindFirstChild("StoredAmmo"))
        for _,v in ipairs(tool:GetDescendants()) do
            if (v:IsA("IntValue") or v:IsA("NumberValue")) then
                local n=v.Name:lower()
                if n:find("ammo") or n:find("magazine") or n:find("clip") then hookAmmo(v) end
            end
        end
    end

    if GunModsConfig.RapidFire then
        local fr=tool:FindFirstChild("FireRate")
        if fr then
            fr.Value=0.01
            table.insert(GunModConnections,fr.Changed:Connect(function(v) if GunModsConfig.RapidFire and v>0.01 then fr.Value=0.01 end end))
        end
        for _,v in ipairs(tool:GetDescendants()) do
            if (v:IsA("NumberValue") or v:IsA("IntValue")) then
                local n=v.Name:lower()
                if n:find("firerate") or n:find("fire_rate") or n:find("cooldown") then
                    v.Value=0.01
                    table.insert(GunModConnections,v.Changed:Connect(function(val) if GunModsConfig.RapidFire and val>0.01 then v.Value=0.01 end end))
                end
            end
        end
    end

    if GunModsConfig.NoSpread then
        for _,name in ipairs({"Spread","MaxSpread"}) do
            local v=tool:FindFirstChild(name)
            if v then
                v.Value=0
                table.insert(GunModConnections,v.Changed:Connect(function(val) if GunModsConfig.NoSpread and val>0 then v.Value=0 end end))
            end
        end
    end

    if GunModsConfig.NoRecoil then
        local rc=tool:FindFirstChild("RecoilControl")
        if rc then
            rc.Value=100
            table.insert(GunModConnections,rc.Changed:Connect(function() if GunModsConfig.NoRecoil then rc.Value=100 end end))
        end
    end

    if GunModsConfig.AlwaysAuto then
        local av=tool:FindFirstChild("Auto")
        if av and av:IsA("BoolValue") then
            av.Value=true
            table.insert(GunModConnections,av.Changed:Connect(function(v) if GunModsConfig.AlwaysAuto and not v then av.Value=true end end))
        end
    end

    -- Zero ReloadTime on the tool itself so Arsenal can't block shots via reload state
    if GunModsConfig.InfiniteAmmo or GunModsConfig.NoReload then
        for _, v in ipairs(tool:GetDescendants()) do
            if v.Name == "ReloadTime" or v.Name == "ReloadSpeed" then
                pcall(function()
                    if v.Name == "ReloadTime" then v.Value = 0
                    else v.Value = 999 end
                end)
                local conn = v.Changed:Connect(function()
                    if GunModsConfig.InfiniteAmmo or GunModsConfig.NoReload then
                        pcall(function()
                            if v.Name == "ReloadTime" then v.Value = 0
                            else v.Value = 999 end
                        end)
                    end
                end)
                table.insert(GunModConnections, conn)
            end
        end
    end

    table.insert(GunModConnections,tool.DescendantAdded:Connect(function()
        task.wait(0.05); ApplyGunMods(tool)
    end))
end

