            if v then
                if game:GetService("UserInputService").TouchEnabled and not game:GetService("UserInputService").KeyboardEnabled then
                    NotificationLibrary:SendNotification("Sniper Scope", "PC only feature!", 3)
                    Toggles.CombatSniperScope:SetValue(false)
