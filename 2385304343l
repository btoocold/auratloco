        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = f

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(70, 70, 90)
        stroke.Thickness = 1.25
        stroke.Transparency = 0.15
        stroke.Parent = f

        f.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                _carFlyTouch[key] = true
            end
        end)

        f.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                _carFlyTouch[key] = false
            end
        end)

        buttons[key] = f
        return f
    end

    makeBtn("▼", "fwd")
    makeBtn("▼", "back")
    makeBtn("▼", "left")
    makeBtn("▼", "right")
    makeBtn("▼", "up")
    makeBtn("▼", "down")

    local function viewportSize()
        camera = workspace.CurrentCamera or camera
        return camera and camera.ViewportSize or Vector2.new(1280, 720)
    end

    local function setButton(btn, x, y, size)
        btn.Size = UDim2.fromOffset(size, size)
        btn.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
    end

    local function layoutButtons()
        if not _carFlyGui then return end

        local vp = viewportSize()
        local portrait = vp.Y > vp.X
        local size = portrait and 58 or 56
        local gap = portrait and 10 or 8

        -- Keep controls away from the very bottom on iPhone portrait,
        -- while still staying reachable with thumbs.
        local dpadW = (size * 3) + (gap * 2)
        local dpadH = dpadW
        local centerY = portrait and (vp.Y * 0.56) or (vp.Y * 0.6)

        local leftX = portrait and math.max(22, vp.X * 0.07) or 34
        local leftY = math.clamp(centerY - (dpadH / 2), 112, math.max(112, vp.Y - dpadH - (portrait and 210 or 105)))

        local centerX = leftX + size + gap
        local midY = leftY + size + gap

        setButton(buttons.fwd,  centerX,             leftY,              size)
        setButton(buttons.back, centerX,             leftY + (size+gap)*2, size)
        setButton(buttons.left, leftX,               midY,               size)
        setButton(buttons.right,leftX + (size+gap)*2, midY,               size)

        local vertH = (size * 2) + gap
        local rightX
        if portrait then
            -- iPhone portrait: put vertical controls higher on the right, not down by the home bar.
            rightX = vp.X - size - 24
        else
            -- iPhone landscape/tablet: keep it right side but not hidden under Roblox vehicle buttons.
            rightX = math.min(vp.X - size - 28, vp.X * 0.78)
        end

        local rightY = math.clamp(centerY - (vertH / 2), 112, math.max(112, vp.Y - vertH - (portrait and 210 or 105)))
        setButton(buttons.up,   rightX, rightY,            size)
        setButton(buttons.down, rightX, rightY + size + gap, size)
    end

    layoutButtons()
    task.defer(layoutButtons)

    if camera then
        table.insert(_carFlyGuiConnections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutButtons))
    end

    table.insert(_carFlyGuiConnections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        camera = workspace.CurrentCamera
        task.defer(layoutButtons)
        if camera then
            table.insert(_carFlyGuiConnections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutButtons))
        end
    end))
end

