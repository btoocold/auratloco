-- -- Explode All Cars -----------------------------------------
;(function()
    local ExplodeGroup = Tabs.Combat:AddLeftGroupbox('💥 Explode Cars')
    local _enabled     = false
    local _loopThread  = nil
    local _interval    = 0.1

    local CAR_FOLDERS = {"CivCars", "WorkTrucks", "PoliceCars"}

    local function getEquippedGun()
        local char = LP.Character
        if not char then return nil end
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                -- Must have GunScript_Local (confirms it's a gun, not a melee etc)
                if tool:FindFirstChild("GunScript_Local") then
                    return tool
                end
            end
        end
        return nil
    end

    local function nukeAllCars()
        local gun = getEquippedGun()
        if not gun then return false end

        local inflictCar = game.ReplicatedStorage:FindFirstChild("InflictCar")
        if not inflictCar then return false end

        local dmg = 9999

        for _, folderName in pairs(CAR_FOLDERS) do
            local folder = workspace:FindFirstChild(folderName)
            if folder then
                for _, car in pairs(folder:GetChildren()) do
                    local hitPart = car.PrimaryPart
                    if not hitPart then
                        for _, p in pairs(car:GetDescendants()) do
                            if p:IsA("BasePart") then hitPart = p break end
                        end
                    end
                    if hitPart then
                        -- fire every car at the same time instead of waiting for each one
                        task.spawn(function()
                            pcall(function()
                                inflictCar:InvokeServer(gun, car, hitPart, dmg)
                            end)
                        end)
                    end
                end
            end
        end
        return true
    end

    local function startLoop()
        if _loopThread then task.cancel(_loopThread) end
        _loopThread = task.spawn(function()
            while _enabled do
                local ok = nukeAllCars()
                if not ok then
                    -- No gun equipped -- notify and pause
                    NotificationLibrary:SendNotification("Explode Cars", "Equip a gun first!", 2)
                    task.wait(2)
                else
                    task.wait(_interval)
                end
            end
        end)
    end

    ExplodeGroup:AddToggle('ExplodeCarsToggle', {
        Text    = 'Explode All Cars',
        Default = false,
        Tooltip = nil,
        Callback = function(v)
            _enabled = v
            if v then
                startLoop()
                NotificationLibrary:SendNotification("Explode Cars", "ON — equip a gun! 💥", 3)
            else
                if _loopThread then task.cancel(_loopThread); _loopThread = nil end
                NotificationLibrary:SendNotification("Explode Cars", "OFF", 2)
            end
        end,
    })
end)()

-- -- Hitbox (Head Expand) --------------------------------------
;(function()
    local HitboxGroup  = Tabs.Combat:AddRightGroupbox('🎯 Hitbox')
    local _lp          = Players.LocalPlayer
    local _hitboxOn    = false
    local _hitboxSize  = 10
    local _origSizes   = {}
    local _expandedPlayers = {}  -- Track who we've expanded

    local function expandHead(player)
        if player == _lp then return end
        if _expandedPlayers[player] then return end  -- Already expanded, don't touch
        if not player.Character then return end
        
        local head = player.Character:FindFirstChild("Head")
        if not head then return end
        
        pcall(function()
            if not _origSizes[player] then
                _origSizes[player] = head.Size
            end
            head.Size = Vector3.new(_hitboxSize, _hitboxSize, _hitboxSize)
            _expandedPlayers[player] = true  -- Mark as expanded, never touch again
        end)
    end

    local function restoreHead(player)
        if not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        if head and _origSizes[player] then
            pcall(function()
                head.Size = _origSizes[player]
            end)
        end
        _origSizes[player] = nil
        _expandedPlayers[player] = nil
    end

    local function applyToAll()
        if _hitboxOn then
            for _, p in pairs(Players:GetPlayers()) do
                expandHead(p)
            end
        else
            for _, p in pairs(Players:GetPlayers()) do
                restoreHead(p)
            end
        end
    end

    -- Hook new players
    local function hookPlayer(p)
        if p == _lp then return end
        p.CharacterAdded:Connect(function(char)
            _expandedPlayers[p] = nil  -- Reset on respawn
            task.wait(0.1)  -- Small delay for head to load
            if _hitboxOn then expandHead(p) end
        end)
        if p.Character then
            if _hitboxOn then expandHead(p) end
        end
    end

    Players.PlayerAdded:Connect(hookPlayer)
    for _, p in pairs(Players:GetPlayers()) do
        hookPlayer(p)
    end

    HitboxGroup:AddToggle('HitboxToggle', {
        Text    = 'Expand Hitbox',
        Default = false,
        Tooltip = 'Enlarges every player\'s head',
        Callback = function(v)
            _hitboxOn = v
            applyToAll()
        end,
    })

    HitboxGroup:AddSlider('HitboxSizeSlider', {
        Text     = 'Hitbox Size',
        Default  = 5,
        Min      = 2,
        Max      = 5,
        Rounding = 0,
        Compact  = false,
        Callback = function(v)
            _hitboxSize = v
            -- Only re-expand if someone is already expanded and size changed
            if _hitboxOn then
                _expandedPlayers = {}  -- Reset tracking so we re-expand with new size
                applyToAll()
            end
        end,
    })
end)()

