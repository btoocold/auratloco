                    if _sniperScoped then return end
                    _sniperScoped = true
                    local c = workspace.CurrentCamera
                    if c then
                        c.CameraType = Enum.CameraType.Custom
                        TS:Create(c, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = 10 }):Play()
