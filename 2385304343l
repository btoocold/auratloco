    local function getMenuGui()
        local screenGui = Library.ScreenGui
        if screenGui and screenGui.Parent then
            return screenGui
        end

        if Library.Holder and Library.Holder.Parent then
            return Library.Holder.Parent
        end

        return nil
    end

    local function applyMenuState()
        local screenGui = getMenuGui()
        if screenGui then
            screenGui.Enabled = _menuOpen
        end

        _btn.Text = _menuOpen and "🟢 Close Menu" or "🔴 Open Menu"
        _btn.BackgroundColor3 = _menuOpen
