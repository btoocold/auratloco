-- Clean Linoria-style notifications only. No external boxed notification library.
NotificationLibrary = NotificationLibrary or {}
function NotificationLibrary:SendNotification(title, text, duration)
    duration = tonumber(duration) or 3
    local message = tostring(text or title or "")
    if title and text and tostring(title) ~= "" and tostring(title) ~= "Success" and tostring(title) ~= "Warning" and tostring(title) ~= "Info" then
        message = tostring(title) .. " | " .. message
    end
    local ok = pcall(function()
        Library:Notify(message, duration)
    end)
    if not ok then
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {Title = "GrimAIO", Text = message, Duration = duration})
        end)
    end
end
