;(function()
    local FOVGroup = Tabs.Visuals:AddRightGroupbox('🔭 Custom FOV')
    local _fovEnabled = false
    local _fovValue   = 70
    local _defaultFOV = 70

    -- Single heartbeat connection that runs once per frame and smoothly holds FOV
    local _fovConnection = nil

    local function _applyFOV()
        local cam = workspace.CurrentCamera
        if cam and _fovEnabled then
            -- Only set if different to avoid fighting other scripts
            if cam.FieldOfView ~= _fovValue then
                cam.FieldOfView = _fovValue
            end
        end
    end

    local function _startFOVLoop()
        if _fovConnection then return end
        _fovConnection = RunService.Heartbeat:Connect(_applyFOV)
    end

    local function _stopFOVLoop()
        if _fovConnection then
            _fovConnection:Disconnect()
            _fovConnection = nil
        end
        local cam = workspace.CurrentCamera
        if cam then
            cam.FieldOfView = _defaultFOV
        end
    end

    FOVGroup:AddToggle('FOVToggle', {
        Text    = 'Enable Custom FOV',
        Default = false,
        Tooltip = nil,
        Callback = function(v)
            _fovEnabled = v
            if v then
                _startFOVLoop()
                -- apply immediately
                _applyFOV()
            else
                _stopFOVLoop()
            end
        end
    })

    FOVGroup:AddSlider('FOVSlider', {
        Text     = 'FOV',
        Default  = 70,
        Min      = 30,
        Max      = 120,
        Rounding = 0,
        Compact  = false,
        Callback = function(v)
            _fovValue = v
            if _fovEnabled then
                _applyFOV()
            end
        end
    })

    -- Clean up if the menu unloads
    Library:OnUnload(function()
        _stopFOVLoop()
    end)
end)()

