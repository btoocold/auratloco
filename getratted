-- ── Car Tuning (A-Chassis) ────────────────────────────────────
do
    local _origTune = {}
    local _hpMult = 1
    local _steerSpeed = 0.05
    local _brakeForce = 3000
    local _finalDrive = 2.89

    local function getCurrentCar()
        local char = LP.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or not hum.SeatPart then return nil end
        local seat = hum.SeatPart
        if not seat:IsA("VehicleSeat") then return nil end
        return seat.Parent
    end

    local function getTune(car)
        if not car then return nil end
        local tune = car:FindFirstChild("A-Chassis Tune")
        if tune and tune:IsA("ModuleScript") then
            local ok, t = pcall(require, tune)
            if ok then return t end
        end
        return nil
    end

    local function applyTuning()
        local car = getCurrentCar()
        if not car then return end
        local tune = getTune(car)
        if not tune then return end
        if not _origTune[car] then
            _origTune[car] = {
                Horsepower = tune.Horsepower or 800,
                SteerSpeed = tune.SteerSpeed or 0.05,
                FBrakeForce = tune.FBrakeForce or 3000,
                RBrakeForce = tune.RBrakeForce or 3000,
                FinalDrive = tune.FinalDrive or 2.89,
            }
        end
        tune.Horsepower = _origTune[car].Horsepower * _hpMult
        tune.SteerSpeed = _steerSpeed
        tune.FBrakeForce = _brakeForce
        tune.RBrakeForce = _brakeForce
        tune.FinalDrive = _finalDrive
    end

    TabMovement:AddSlider('CarHPSlider', {
        Text = 'HP Multiplier', Default = 1, Min = 0.5, Max = 5, Rounding = 1, Compact = false,
        Callback = function(v) _hpMult = v; applyTuning() end,
    })

    TabMovement:AddSlider('CarSteerSlider', {
        Text = 'Steer Speed', Default = 5, Min = 1, Max = 30, Rounding = 0, Compact = false,
        Callback = function(v) _steerSpeed = v / 100; applyTuning() end,
    })

    TabMovement:AddSlider('CarBrakeSlider', {
        Text = 'Brake Force', Default = 3000, Min = 500, Max = 20000, Rounding = 0, Compact = false,
        Callback = function(v) _brakeForce = v; applyTuning() end,
    })

    TabMovement:AddSlider('CarFinalDriveSlider', {
        Text = 'Final Drive', Default = 289, Min = 100, Max = 600, Rounding = 0, Compact = false,
        Tooltip = 'Lower = faster top speed, Higher = faster acceleration',
        Callback = function(v) _finalDrive = v / 100; applyTuning() end,
    })

    TabMovement:AddButton({
        Text = 'Reset Car Settings',
        DoubleClick = false,
        Func = function()
            local car = getCurrentCar()
            if car and _origTune[car] then
                local tune = getTune(car)
                if tune then
                    tune.Horsepower = _origTune[car].Horsepower
                    tune.SteerSpeed = _origTune[car].SteerSpeed
                    tune.FBrakeForce = _origTune[car].FBrakeForce
                    tune.RBrakeForce = _origTune[car].RBrakeForce
                    tune.FinalDrive = _origTune[car].FinalDrive
                    NotificationLibrary:SendNotification("Car Tuning", "Reset to default!", 2)
                end
            else
                NotificationLibrary:SendNotification("Car Tuning", "Get in a car first!", 3)
            end
        end,
    })
end



