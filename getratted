local PromptCache = {}  -- actionText -> {prompt, ...}

local function getPromptRootPosition(prompt)
    local parent = prompt.Parent
    if not parent then return nil end
    if parent:IsA("Attachment") and parent.Parent and parent.Parent:IsA("BasePart") then
        return parent.Parent.Position
    end
    if parent:IsA("BasePart") then return parent.Position end
    local part = parent:FindFirstAncestorWhichIsA("BasePart")
    return part and part.Position or nil
end

local function rebuildPromptCache()
    table.clear(PromptCache)
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            local actionText = tostring(descendant.ActionText or "")
            if actionText ~= "" then
                if not PromptCache[actionText] then
                    PromptCache[actionText] = {}
                end
                table.insert(PromptCache[actionText], descendant)
            end
        end
    end
end

rebuildPromptCache()
workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") then
        local actionText = tostring(descendant.ActionText or "")
        if actionText ~= "" then
            if not PromptCache[actionText] then PromptCache[actionText] = {} end
            table.insert(PromptCache[actionText], descendant)
        end
    end
end)
workspace.DescendantRemoving:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") then
        local actionText = tostring(descendant.ActionText or "")
        if PromptCache[actionText] then
            for i, p in ipairs(PromptCache[actionText]) do
                if p == descendant then table.remove(PromptCache[actionText], i) break end
            end
        end
    end
end)

local function findPromptForItem(itemData)
    local actionText = tostring(itemData.PromptActionText or "")

    -- Build candidate list from cache + fresh scan
    rebuildPromptCache()
    local candidates = PromptCache[actionText] or {}

    if #candidates == 0 then return nil end
    if #candidates == 1 then return candidates[1] end

    -- Multiple prompts share the same ActionText — pick the one closest to ShopHint
    local hintPos = TeleportLocations[itemData.ShopHint]
    if not hintPos then
        -- No ShopHint location known, just return first valid
        for _, p in ipairs(candidates) do
            if p and p.Parent then return p end
        end
        return nil
    end

    local best, bestDist = nil, math.huge
    for _, p in ipairs(candidates) do
        if p and p.Parent then
            local pos = getPromptRootPosition(p)
            if pos then
                local d = (pos - hintPos).Magnitude
                if d < bestDist then bestDist = d best = p end
            end
        end
    end
    return best
end

local function firePromptDirect(prompt)
    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt, 0)
        end)
        if ok then return true end
        ok = pcall(function()
            fireproximityprompt(prompt)
        end)
        if ok then return true end
        ok = pcall(function()
            fireproximityprompt(prompt, true)
        end)
        if ok then return true end
        return false
    end

    local old = prompt.HoldDuration
    prompt.HoldDuration = 0
    task.wait(0.1)
    prompt:InputHoldBegin()
    task.wait(0.1)
    prompt:InputHoldEnd()
    prompt.HoldDuration = old
    return true
end

local function buyPromptItem(itemName, itemData)
    local prompt = findPromptForItem(itemData)
    if not prompt then
        NotificationLibrary:SendNotification("Warning", "Prompt not found for " .. itemName, 3)
        return
    end

    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local originalCFrame = hrp and hrp.CFrame

    -- Use TeleportHint if set (avoids wrong location), otherwise use prompt world pos
    local teleportPos = itemData.TeleportHint or getPromptRootPosition(prompt)

    if hrp and teleportPos then
        local facingCFrame = CFrame.new(teleportPos + Vector3.new(0, 0, 2), teleportPos)
        Teleport(facingCFrame)
        task.wait(1)
        hrp.CFrame = facingCFrame
        task.wait(0.3)
    end

    -- Set prompt properties
    local origHold = prompt.HoldDuration
    local origDist = prompt.MaxActivationDistance
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 50
    prompt.RequiresLineOfSight = false

    -- Fire multiple times to make sure server registers it
    for i = 1, 5 do
        pcall(function() fireproximityprompt(prompt, 0) end)
        task.wait(0.1)
    end

    -- Restore prompt properties
    prompt.HoldDuration = origHold
    prompt.MaxActivationDistance = origDist

    task.wait(0.5)

    if originalCFrame and hrp then
        Teleport(originalCFrame)
    end

    NotificationLibrary:SendNotification("Success", "Bought: " .. itemName, 3)
end

