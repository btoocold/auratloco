-- Track active trail parts so we can clean them up on disable
local ActiveTrailParts = {}

local function cleanupAllTrails()
    for _, part in ipairs(ActiveTrailParts) do
        pcall(function() part:Destroy() end)
    end
    ActiveTrailParts = {}
end

local function hasAmmo(tool)
    if not tool then return false end

    -- Game-specific: ammo is stored in Tool.GunScript_Server.Mag
    local gunScript = tool:FindFirstChild("GunScript_Server")
    if gunScript then
        local mag = gunScript:FindFirstChild("Mag")
        if mag and (mag:IsA("IntValue") or mag:IsA("NumberValue")) then
            return mag.Value > 0
        end
    end

    -- No GunScript_Server found — allow trail (non-gun tool)
    return true
end

local function createBulletTrail(startPos, endPos)
    if not BulletTrailsEnabled then
        return
    end

    local activeColor = BulletTrailRainbow and Color3.fromHSV(CurrentTrailHue, 1, 1) or BulletTrailColor
    local direction = (endPos - startPos)
    local distance = direction.Magnitude
    if distance < 0.1 then return end
    local unitDir = direction.Unit

    -- Use a moving sphere (paintball style) instead of a static beam line
    task.spawn(function()
        local speed = distance / BulletTrailLife -- travel full distance in lifetime
        local elapsed = 0
        local stepSize = 0.016 -- ~60fps

        -- Create the sphere projectile
        local sphere = Instance.new("Part")
        sphere.Name = "SynthXBulletSphere"
        sphere.Shape = Enum.PartType.Ball
        sphere.Anchored = true
        sphere.CanCollide = false
        sphere.CanQuery = false
        sphere.CanTouch = false
        sphere.Size = Vector3.new(BulletTrailWidth * 3, BulletTrailWidth * 3, BulletTrailWidth * 3)
        sphere.Color = activeColor
        sphere.Material = Enum.Material.Neon
        sphere.CFrame = CFrame.new(startPos)
        sphere.Parent = workspace
        table.insert(ActiveTrailParts, sphere)

        if BulletTrailGlow then
            local light = Instance.new("PointLight")
            light.Color = activeColor
            light.Brightness = BulletTrailLight * 2
            light.Range = 10
            light.Parent = sphere
        end

        -- Leave a fading trail behind as it moves
        local trailAttach0 = Instance.new("Attachment")
        trailAttach0.Name = "A0"
        trailAttach0.Parent = sphere

        local trailAttach1 = Instance.new("Attachment")
        trailAttach1.Name = "A1"
        trailAttach1.Position = Vector3.new(0, 0, BulletTrailWidth * 2)
        trailAttach1.Parent = sphere

        local trail = Instance.new("Trail")
        trail.Attachment0 = trailAttach0
        trail.Attachment1 = trailAttach1
        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, activeColor),
            ColorSequenceKeypoint.new(1, activeColor)
        })
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, BulletTrailOpacity),
            NumberSequenceKeypoint.new(1, 1)
        })
        trail.Lifetime = BulletTrailLife * 0.5
        trail.WidthScale = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0)
        })
        trail.LightEmission = BulletTrailLight
        trail.Parent = sphere

        if BulletTrailSparkles then
            local emitter = Instance.new("ParticleEmitter")
            emitter.Color = ColorSequence.new(activeColor)
            emitter.LightEmission = 1
            emitter.Lifetime = NumberRange.new(0.04, 0.10)
            emitter.Rate = 60
            emitter.Speed = NumberRange.new(0, 0.5)
            emitter.SpreadAngle = Vector2.new(30, 30)
            emitter.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, BulletTrailWidth * 1.5),
                NumberSequenceKeypoint.new(1, 0)
            })
            emitter.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1)
            })
            emitter.Parent = sphere
        end

        -- Animate the sphere moving from startPos to endPos
        while elapsed < BulletTrailLife do
            if not BulletTrailsEnabled then
                pcall(function() sphere:Destroy() end)
                return
            end
            elapsed = elapsed + stepSize
            local t = math.clamp(elapsed / BulletTrailLife, 0, 1)
            local currentPos = startPos + unitDir * (distance * t)
            sphere.CFrame = CFrame.new(currentPos)

            -- Fade out as it travels
            sphere.Transparency = t * 0.8

            task.wait(stepSize)
        end

        -- Impact burst at end
        createImpactBurst(endPos, unitDir)

        pcall(function() sphere:Destroy() end)
        -- Remove from active list
        for i, p in ipairs(ActiveTrailParts) do
            if p == sphere then
                table.remove(ActiveTrailParts, i)
                break
            end
        end
    end)
end

