function Library:CreateWindow(...)
    local cfg={}
    if type(...)=="table" then cfg=... else local a={...}; cfg.Title=a[1]; cfg.AutoShow=a[2] or false end
    cfg.Title        = type(cfg.Title)=="string"       and cfg.Title        or "Menu"
    cfg.TabPadding   = type(cfg.TabPadding)=="number"  and cfg.TabPadding   or 2
    cfg.MenuFadeTime = type(cfg.MenuFadeTime)=="number" and cfg.MenuFadeTime or 0.2
    if cfg.Center then cfg.AnchorPoint=Vector2.new(0.5,0.5); cfg.Position=UDim2.fromScale(0.5,0.5)
    else cfg.AnchorPoint=cfg.AnchorPoint or Vector2.zero; cfg.Position=cfg.Position or UDim2.fromOffset(160,50) end
    cfg.Size=cfg.Size or UDim2.fromOffset(560,370)

    local Window={Tabs={}}

    -- Outer shell with neon glow
    local outer=Library:Create("Frame",{AnchorPoint=cfg.AnchorPoint;BackgroundColor3=Library.BackgroundColor;
        BorderSizePixel=0;Position=cfg.Position;Size=cfg.Size;Visible=false;ZIndex=10;ClipsDescendants=false;Parent=ScreenGui})
    Rnd(outer,12)
    -- outer has NO ClipsDescendants so the glow image behind it isn't clipped
    MkStroke(outer, Color3.fromRGB(0,80,255), 1.5, 0)
    Glow(outer, 40)
    Library:MakeDraggable(outer,30)

    local inner=Library:Create("Frame",{BackgroundColor3=Library.MainColor;BorderSizePixel=0;
        Position=UDim2.fromOffset(0,0);Size=UDim2.fromScale(1,1);ZIndex=11;ClipsDescendants=true;Parent=outer})
    Rnd(inner,12); Library:AddToRegistry(inner,{BackgroundColor3="MainColor"})

    -- Top accent bar inside inner — ClipsDescendants rounds the top corners cleanly
    local topBar=Library:Create("Frame",{BackgroundColor3=Library.AccentColor;BorderSizePixel=0;Size=UDim2.new(1,0,0,2);ZIndex=12;Parent=inner})
    Library:AddToRegistry(topBar,{BackgroundColor3="AccentColor"})

    local titleBar=Library:Create("Frame",{BackgroundColor3=Library.MainColor;BorderSizePixel=0;Size=UDim2.new(1,0,0,28);ZIndex=12;Parent=inner})
    Grad(titleBar,Color3.fromRGB(28,28,42),Color3.fromRGB(18,18,28),90)
    Library:AddToRegistry(titleBar,{BackgroundColor3="MainColor"})
    local titleLbl=Library:MakeLabel({Position=UDim2.fromOffset(12,0);Size=UDim2.new(1,-12,1,0);TextSize=14;
        Font=Library.FontBold;Text=cfg.Title;TextXAlignment=Enum.TextXAlignment.Left;ZIndex=13;Parent=titleBar})

    -- Separator
    local sep=Library:Create("Frame",{BackgroundColor3=Library.OutlineColor;BorderSizePixel=0;
        Position=UDim2.fromOffset(0,28);Size=UDim2.new(1,0,0,1);ZIndex=12;Parent=inner})
    Library:AddToRegistry(sep,{BackgroundColor3="OutlineColor"})

    local mainOuter=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;
        Position=UDim2.fromOffset(8,35);Size=UDim2.new(1,-16,1,-43);ZIndex=11;Parent=inner})
    Rnd(mainOuter,9); MkStroke(mainOuter,Library.OutlineColor,1)
    Library:AddToRegistry(mainOuter,{BackgroundColor3="BackgroundColor"})
    local mainInner=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;
        Size=UDim2.fromScale(1,1);ZIndex=12;Parent=mainOuter})
    Rnd(mainInner,9); Library:AddToRegistry(mainInner,{BackgroundColor3="BackgroundColor"})

    -- Tab buttons
    local tabArea=Library:Create("Frame",{BackgroundTransparency=1;Position=UDim2.fromOffset(8,7);
        Size=UDim2.new(1,-16,0,22);ZIndex=13;Parent=mainInner})
    Library:Create("UIListLayout",{Padding=UDim.new(0,cfg.TabPadding);FillDirection=Enum.FillDirection.Horizontal;
        SortOrder=Enum.SortOrder.LayoutOrder;Parent=tabArea})

    local tabContainer=Library:Create("Frame",{BackgroundColor3=Library.MainColor;BorderSizePixel=0;
        Position=UDim2.fromOffset(8,31);Size=UDim2.new(1,-16,1,-39);ZIndex=13;Parent=mainInner})
    Rnd(tabContainer,8); MkStroke(tabContainer,Library.OutlineColor,1)
    Library:AddToRegistry(tabContainer,{BackgroundColor3="MainColor"})

    function Window:SetWindowTitle(t) titleLbl.Text=t end

    function Window:AddTab(name)
        local Tab={Groupboxes={};Tabboxes={}}
        local tw=Library:GetTextBounds(name,Library.FontBold,13)
        local tabBtn=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;
            Size=UDim2.new(0,tw+18,1,0);ZIndex=14;Parent=tabArea})
        Rnd(tabBtn,6); Library:AddToRegistry(tabBtn,{BackgroundColor3="BackgroundColor"})
        Library:MakeLabel({Size=UDim2.fromScale(1,1);Text=name;TextSize=13;Font=Library.FontBold;ZIndex=15;Parent=tabBtn})
        local blocker=Library:Create("Frame",{BackgroundColor3=Library.MainColor;BorderSizePixel=0;
            Position=UDim2.new(0,0,1,-1);Size=UDim2.new(1,0,0,2);BackgroundTransparency=1;ZIndex=16;Parent=tabBtn})
        Library:AddToRegistry(blocker,{BackgroundColor3="MainColor"})
        local tabFrame=Library:Create("Frame",{BackgroundTransparency=1;ClipsDescendants=true;Size=UDim2.fromScale(1,1);Visible=false;ZIndex=14;Parent=tabContainer})

        local ColPad,ColGap=7,6
        local function makeSide(xscale,xoff)
            local s=Library:Create("ScrollingFrame",{BackgroundTransparency=1;BorderSizePixel=0;
                Position=UDim2.new(xscale,xoff,0,ColPad);Size=UDim2.new(0.5,-ColPad*2-ColGap/2,1,-ColPad*2);
                CanvasSize=UDim2.new(0,0,0,0);AutomaticCanvasSize=Enum.AutomaticSize.None;
                BottomImage="";TopImage="";ScrollBarThickness=3;ScrollBarImageTransparency=0;
                ScrollBarImageColor3=Library.AccentColor;ScrollingDirection=Enum.ScrollingDirection.Y;
                ClipsDescendants=true;ZIndex=15;Parent=tabFrame})
            Library:Create("UIListLayout",{Padding=UDim.new(0,8);FillDirection=Enum.FillDirection.Vertical;
                SortOrder=Enum.SortOrder.LayoutOrder;HorizontalAlignment=Enum.HorizontalAlignment.Center;Parent=s})
            Library:AddToRegistry(s,{ScrollBarImageColor3="AccentColor"})
            s.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                s.CanvasSize=UDim2.fromOffset(0,s.UIListLayout.AbsoluteContentSize.Y+6) end)
            return s
        end
        local leftSide=makeSide(0,ColPad); local rightSide=makeSide(0.5,ColGap/2)

        function Tab:ShowTab()
            for _,t in next,Window.Tabs do t:HideTab() end
            blocker.BackgroundTransparency=0; Tween(tabBtn,{BackgroundColor3=Library.MainColor},0.12)
            Library.RegistryMap[tabBtn].Properties.BackgroundColor3="MainColor"; tabFrame.Visible=true
        end
        function Tab:HideTab()
            blocker.BackgroundTransparency=1; Tween(tabBtn,{BackgroundColor3=Library.BackgroundColor},0.12)
            Library.RegistryMap[tabBtn].Properties.BackgroundColor3="BackgroundColor"; tabFrame.Visible=false
        end

        function Tab:AddGroupbox(info)
            local GB={}; local side=info.Side==1 and leftSide or rightSide
            local boxO=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;
                Size=UDim2.new(1,0,0,30);ZIndex=15;Parent=side})
            Rnd(boxO,9); MkStroke(boxO,Library.OutlineColor,1)
            Library:AddToRegistry(boxO,{BackgroundColor3="BackgroundColor"})
            local gbTop=Library:Create("Frame",{BackgroundColor3=Library.AccentColor;BorderSizePixel=0;Size=UDim2.new(1,0,0,2);ZIndex=16;Parent=boxO})
            Rnd(gbTop,9); Library:AddToRegistry(gbTop,{BackgroundColor3="AccentColor"})
            Library:MakeLabel({Size=UDim2.new(1,-6,0,18);Position=UDim2.fromOffset(7,2);TextSize=12;Font=Library.FontBold;Text=info.Name;
                TextXAlignment=Enum.TextXAlignment.Left;ZIndex=17;Parent=boxO})
            local cont=Library:Create("Frame",{BackgroundTransparency=1;Position=UDim2.fromOffset(4,22);Size=UDim2.new(1,-4,1,-22);ZIndex=1;Parent=boxO})
            Library:Create("UIListLayout",{FillDirection=Enum.FillDirection.Vertical;SortOrder=Enum.SortOrder.LayoutOrder;Parent=cont})
            function GB:Resize()
                local h=0; for _,e in next,GB.Container:GetChildren() do if not e:IsA("UIListLayout") and e.Visible then h=h+e.Size.Y.Offset end end
                boxO.Size=UDim2.new(1,0,0,24+h+4) end
            GB.Container=cont; setmetatable(GB,BaseGroupbox); GB:AddBlank(3); GB:Resize(); Tab.Groupboxes[info.Name]=GB; return GB
        end
        function Tab:AddLeftGroupbox(n) return Tab:AddGroupbox({Side=1;Name=n}) end
        function Tab:AddRightGroupbox(n) return Tab:AddGroupbox({Side=2;Name=n}) end

        function Tab:AddTabbox(info)
            local Tabbox={Tabs={}}; local side=info.Side==1 and leftSide or rightSide
            local tbO=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;Size=UDim2.new(1,0,0,0);ZIndex=15;Parent=side})
            Rnd(tbO,9); MkStroke(tbO,Library.OutlineColor,1); Library:AddToRegistry(tbO,{BackgroundColor3="BackgroundColor"})
            local tbAcc=Library:Create("Frame",{BackgroundColor3=Library.AccentColor;BorderSizePixel=0;Size=UDim2.new(1,0,0,2);ZIndex=16;Parent=tbO})
            Rnd(tbAcc,9); Library:AddToRegistry(tbAcc,{BackgroundColor3="AccentColor"})
            local btnRow=Library:Create("Frame",{BackgroundTransparency=1;Position=UDim2.fromOffset(0,1);Size=UDim2.new(1,0,0,20);ZIndex=16;Parent=tbO})
            Library:Create("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal;SortOrder=Enum.SortOrder.LayoutOrder;Parent=btnRow})
            function Tabbox:AddTab(name)
                local T={}
                local btn=Library:Create("Frame",{BackgroundColor3=Library.MainColor;BorderSizePixel=0;Size=UDim2.new(0.5,0,1,0);ZIndex=17;Parent=btnRow})
                Rnd(btn,6); Library:AddToRegistry(btn,{BackgroundColor3="MainColor"})
                Library:MakeLabel({Size=UDim2.fromScale(1,1);TextSize=12;Text=name;ZIndex=18;Parent=btn})
                local block=Library:Create("Frame",{BackgroundColor3=Library.BackgroundColor;BorderSizePixel=0;
                    Position=UDim2.new(0,0,1,0);Size=UDim2.new(1,0,0,2);Visible=false;ZIndex=19;Parent=btn})
                Library:AddToRegistry(block,{BackgroundColor3="BackgroundColor"})
                local tCont=Library:Create("Frame",{BackgroundTransparency=1;Position=UDim2.fromOffset(4,22);
                    Size=UDim2.new(1,-4,1,-22);ZIndex=1;Visible=false;Parent=tbO})
                Library:Create("UIListLayout",{FillDirection=Enum.FillDirection.Vertical;SortOrder=Enum.SortOrder.LayoutOrder;Parent=tCont})
                function T:Show()
                    for _,tb in next,Tabbox.Tabs do tb:Hide() end; tCont.Visible=true; block.Visible=true
                    Tween(btn,{BackgroundColor3=Library.BackgroundColor},0.1); Library.RegistryMap[btn].Properties.BackgroundColor3="BackgroundColor"; T:Resize()
                end
                function T:Hide()
                    tCont.Visible=false; block.Visible=false
                    Tween(btn,{BackgroundColor3=Library.MainColor},0.1); Library.RegistryMap[btn].Properties.BackgroundColor3="MainColor"
                end
                function T:Resize()
                    local cnt=0; for _ in next,Tabbox.Tabs do cnt=cnt+1 end
                    for _,b in next,btnRow:GetChildren() do if not b:IsA("UIListLayout") then b.Size=UDim2.new(1/cnt,0,1,0) end end
                    if not tCont.Visible then return end
                    local h=0; for _,e in next,T.Container:GetChildren() do if not e:IsA("UIListLayout") and e.Visible then h=h+e.Size.Y.Offset end end
                    tbO.Size=UDim2.new(1,0,0,22+h+4) end
                btn.InputBegan:Connect(function(inp)
                    if IsPress(inp) and not Library:MouseIsOverOpenedFrame() then T:Show(); T:Resize() end end)
                T.Container=tCont; Tabbox.Tabs[name]=T; setmetatable(T,BaseGroupbox); T:AddBlank(3); T:Resize()
                if #btnRow:GetChildren()==2 then T:Show() end; return T
            end
            Tab.Tabboxes[info.Name or ""]=Tabbox; return Tabbox
        end
        function Tab:AddLeftTabbox(n) return Tab:AddTabbox({Name=n;Side=1}) end
        function Tab:AddRightTabbox(n) return Tab:AddTabbox({Name=n;Side=2}) end

        tabBtn.InputBegan:Connect(function(inp) if IsPress(inp) then Tab:ShowTab() end end)
        if #tabContainer:GetChildren()==1 then Tab:ShowTab() end
        Window.Tabs[name]=Tab; return Tab
    end

    -- Mobile toggle button
    local mobileBtn=nil
    if InputService:GetTouchEnabled() then
        mobileBtn=Library:Create("TextButton",{BackgroundColor3=Library.AccentColor;BorderSizePixel=0;
            Position=UDim2.fromOffset(8,8);Size=UDim2.fromOffset(56,26);Text="☰ UI";
            TextColor3=Color3.new(1,1,1);Font=Library.FontBold;TextSize=12;ZIndex=600;Parent=ScreenGui})
        Rnd(mobileBtn,7); MkStroke(mobileBtn,Library:GetDarkerColor(Library.AccentColor),1)
        Library:MakeDraggable(mobileBtn)
    end

    local tCache={};local toggled=false;local fading=false
    function Library:Toggle()
        if fading then return end
        local ft=cfg.MenuFadeTime; fading=true; toggled=not toggled
        if toggled then outer.Visible=true end
        for _,desc in next,outer:GetDescendants() do
            local props={}
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then table.insert(props,"ImageTransparency");table.insert(props,"BackgroundTransparency")
            elseif desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then table.insert(props,"TextTransparency");table.insert(props,"BackgroundTransparency")
            elseif desc:IsA("Frame") or desc:IsA("ScrollingFrame") then table.insert(props,"BackgroundTransparency")
            elseif desc:IsA("UIStroke") then table.insert(props,"Transparency") end
            local cache=tCache[desc]; if not cache then cache={}; tCache[desc]=cache end
            for _,p in next,props do
                if not cache[p] then cache[p]=desc[p] end
                if cache[p]==1 then continue end
                TweenService:Create(desc,TweenInfo.new(ft,Enum.EasingStyle.Quad),{[p]=toggled and cache[p] or 1}):Play()
            end
        end
        task.wait(ft); outer.Visible=toggled; fading=false
        if mobileBtn then
            mobileBtn.Text=toggled and "✕ UI" or "☰ UI"
            Tween(mobileBtn,{BackgroundColor3=toggled and Library:GetDarkerColor(Library.AccentColor) or Library.AccentColor},0.15)
        end
    end

    if mobileBtn then
        mobileBtn.InputBegan:Connect(function(inp) if IsPress(inp) then task.spawn(Library.Toggle) end end)
    end
    Library:GiveSignal(InputService.InputBegan:Connect(function(inp,processed)
        if type(Library.ToggleKeybind)=="table" and Library.ToggleKeybind.Type=="KeyPicker" then
            if inp.UserInputType==Enum.UserInputType.Keyboard and inp.KeyCode.Name==Library.ToggleKeybind.Value then task.spawn(Library.Toggle) end
        elseif inp.KeyCode==Enum.KeyCode.RightControl
        or (inp.KeyCode==Enum.KeyCode.RightShift and not processed) then task.spawn(Library.Toggle) end
    end))

    if cfg.AutoShow then task.spawn(Library.Toggle) end
    Window.Holder=outer; return Window
end

-- Player/team dropdown auto-update
local function OnPlayerChange()
    local pl=GetPlayers()
    for _,v in next,Options do if v.Type=="Dropdown" and v.SpecialType=="Player" then v:SetValues(pl) end end
end
Players.PlayerAdded:Connect(OnPlayerChange); Players.PlayerRemoving:Connect(OnPlayerChange)

getgenv().Library=Library
return Library
