    emitter.Lifetime = NumberRange.new(0.10, 0.18)
    emitter.Rate = 0
    emitter.Speed = NumberRange.new(2 * BulletImpactBurstScale, 6 * BulletImpactBurstScale)
    emitter.RotSpeed = NumberRange.new(-180, 180)
    emitter.SpreadAngle = Vector2.new(140, 140)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.12 * BulletImpactBurstScale),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    emitter.Parent = burstPart
