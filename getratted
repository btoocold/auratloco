;(function()
    local HitboxGroup  = Tabs.Combat:AddRightGroupbox('🎯 Hitbox')
    local _lp          = Players.LocalPlayer
    local _hitboxOn    = false
    local _hitboxSize  = 10   -- studs, default
    local _origSizes   = {}   -- player → original head size

    local function expandHead(player)
        if player == _lp then return end
        if not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        if not head then return end
        if not _origSizes[player] then
            _origSizes[player] = head.Size
        end
        head.Size = Vector3.new(_hitboxSize, _hitboxSize, _hitboxSize)
    end

    local function restoreHead(player)
        if not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        if head and _origSizes[player] then
            head.Size = _origSizes[player]
        end
        _origSizes[player] = nil
    end

    local function applyToAll()
        for _, p in pairs(Players:GetPlayers()) do
            if _hitboxOn then expandHead(p)
            else restoreHead(p) end
        end
    end

    -- Re-expand on respawn
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function()
            task.wait(0.15)
            _origSizes[p] = nil  -- fresh size for new char
            if _hitboxOn then expandHead(p) end
        end)
    end)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= _lp then
            p.CharacterAdded:Connect(function()
                task.wait(0.15)
                _origSizes[p] = nil
                if _hitboxOn then expandHead(p) end
            end)
        end
    end

    -- Keep heads expanded every heartbeat (some games reset part sizes)
    RunService.Heartbeat:Connect(function()
        if not _hitboxOn then return end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= _lp and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head and head.Size.X ~= _hitboxSize then
                    if not _origSizes[p] then _origSizes[p] = Vector3.new(1,1,1) end
                    head.Size = Vector3.new(_hitboxSize, _hitboxSize, _hitboxSize)
                end
            end
        end
    end)

    HitboxGroup:AddToggle('HitboxToggle', {
        Text    = 'Expand Hitbox',
        Default = false,
        Tooltip = 'Enlarges every player\'s head to make them easier to hit',
        Callback = function(v)
            _hitboxOn = v
            applyToAll()
        end,
    })

    HitboxGroup:AddSlider('HitboxSizeSlider', {
        Text     = 'Hitbox Size',
        Default  = 10,
        Min      = 2,
        Max      = 50,
        Rounding = 0,
        Compact  = false,
        Callback = function(v)
            _hitboxSize = v
            if _hitboxOn then applyToAll() end
        end,
    })
end)()

