-- dXtg8 enhanced WalkSpeed backend
local speed = 16
local boostMultiplier = 2
local enhancedWalk = false

local ewCharacter, ewHumanoid, ewHumanoidRootPart
local bodyGyro
local movementConnection
local freezeConnection
local animationTrack

local ewAnimation = Instance.new("Animation")
ewAnimation.AnimationId = "rbxassetid://78828590676720"

getgenv().SwimMethod = false

task.spawn(function()
    while task.wait() do
        if enhancedWalk then
            if not getgenv().SwimMethod then
                getgenv().SwimMethod = true
            end
            if ewHumanoid then
                ewHumanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
            end
        end
    end
end)

local function updateEnhancedWalkRefs()
    ewCharacter = LP.Character or LP.CharacterAdded:Wait()
    ewHumanoidRootPart = ewCharacter:WaitForChild("HumanoidRootPart")
    ewHumanoid = ewCharacter:WaitForChild("Humanoid")
end

local function cleanupEnhancedWalk()
    if movementConnection then movementConnection:Disconnect() movementConnection = nil end
    if freezeConnection then freezeConnection:Disconnect() freezeConnection = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    if animationTrack then animationTrack:Stop() animationTrack = nil end
end

local function setupEnhancedWalkMovement()
    if not ewHumanoidRootPart then return end

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 50000
    bodyGyro.D = 1000
    bodyGyro.CFrame = ewHumanoidRootPart.CFrame
    bodyGyro.Parent = ewHumanoidRootPart

    movementConnection = RunService.RenderStepped:Connect(function()
        if not enhancedWalk or not ewHumanoidRootPart or not ewHumanoid then return end

        local camera = workspace.CurrentCamera
        local dir = Vector3.zero
        local usingKeys = false

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            dir += Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            dir -= Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            dir -= camera.CFrame.RightVector
            usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            dir += camera.CFrame.RightVector
            usingKeys = true
        end

        if not usingKeys then
            local md = ewHumanoid.MoveDirection
            dir = Vector3.new(md.X, 0, md.Z)
        end

        local moveSpeed = speed
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveSpeed = moveSpeed * boostMultiplier
        end

        if dir.Magnitude > 0 then
            dir = dir.Unit * moveSpeed
        end

        local currentY = ewHumanoidRootPart.AssemblyLinearVelocity.Y
        local groundedY = math.clamp(currentY, -100, -2)
        ewHumanoidRootPart.AssemblyLinearVelocity = Vector3.new(dir.X, groundedY, dir.Z)

        if dir.Magnitude > 0 then
            local look = dir.Unit
            bodyGyro.CFrame = CFrame.new(ewHumanoidRootPart.Position, ewHumanoidRootPart.Position + Vector3.new(look.X, 0, look.Z))
        end

        ewHumanoidRootPart.RotVelocity = Vector3.zero
        ewHumanoidRootPart.AssemblyAngularVelocity = Vector3.zero

        if animationTrack then
            if dir.Magnitude > 0 then
                if not animationTrack.IsPlaying then animationTrack:Play() end
            else
                if animationTrack.IsPlaying then animationTrack:Stop() end
            end
        end
    end)
end

local function startWalkSpeed()
    enhancedWalk = true
    updateEnhancedWalkRefs()
    cleanupEnhancedWalk()
    ewHumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    getgenv().SwimMethod = true

    NotificationLibrary:SendNotification("WalkSpeed", "Anti cheat bypass starting...", 3)

    freezeConnection = RunService.RenderStepped:Connect(function()
        if enhancedWalk and ewHumanoidRootPart then
            if not getgenv().SwimMethod then
                getgenv().SwimMethod = true
            end
            ewHumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        end
    end)

    local animator = ewHumanoid:FindFirstChildWhichIsA("Animator") or Instance.new("Animator", ewHumanoid)
    animationTrack = animator:LoadAnimation(ewAnimation)
    animationTrack.Looped = true

    task.delay(1, function()
        if freezeConnection then freezeConnection:Disconnect() freezeConnection = nil end
        if enhancedWalk then
            setupEnhancedWalkMovement()
            NotificationLibrary:SendNotification("WalkSpeed", "Enhanced walk speed enabled", 3)
        end
    end)
end

local function stopWalkSpeed()
    enhancedWalk = false
    cleanupEnhancedWalk()
    getgenv().SwimMethod = false
    if LP.Character then
        local hum = LP.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end
end

LP.CharacterAdded:Connect(function()
    task.wait(1)
    updateEnhancedWalkRefs()
    if enhancedWalk then
        startWalkSpeed()
    end
end)


