local Camera = workspace.CurrentCamera
local LastTrailShot = 0
local TrailFireRate = 1 / 12

local MUZZLE_NAME_KEYWORDS = {
    "muzzle", "barrel", "tip", "firepoint", "fire_point", "shootpos", "shoot_pos", "origin"
}

local function getEquippedWeaponTool()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and isEligibleWeaponTool(child) then
            return child
        end
    end

    return nil
end

local function findBestMuzzlePosition(tool)
    if not tool then
        return nil
    end

    local bestAttachment = nil
    local bestPart = nil

    for _, descendant in ipairs(tool:GetDescendants()) do
        local lowerName = string.lower(descendant.Name)

        if descendant:IsA("Attachment") then
            for _, keyword in ipairs(MUZZLE_NAME_KEYWORDS) do
                if string.find(lowerName, keyword, 1, true) then
                    bestAttachment = descendant
                    break
                end
            end
        elseif descendant:IsA("BasePart") then
            for _, keyword in ipairs(MUZZLE_NAME_KEYWORDS) do
                if string.find(lowerName, keyword, 1, true) then
                    bestPart = descendant
                    break
                end
            end
        end
    end

    if bestAttachment then
        return bestAttachment.WorldPosition
    end

    if bestPart then
        return bestPart.Position
    end

    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        return handle.Position + handle.CFrame.LookVector * (handle.Size.Z * 0.5)
    end

    local firstBasePart = tool:FindFirstChildWhichIsA("BasePart", true)
    if firstBasePart then
        return firstBasePart.Position + firstBasePart.CFrame.LookVector * (firstBasePart.Size.Z * 0.5)
    end

    return nil
end

local function getTrailEndPosition(origin)
    local camera = workspace.CurrentCamera
    if not camera then
        return origin + Vector3.new(0, 0, -200)
    end

    local mousePos = UserInputService:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
    if result then
        return result.Position
    end

    return ray.Origin + ray.Direction * 400
end

local function tryCreateAutomaticTrail()
    if not BulletTrailsEnabled then
        return
    end

    local now = tick()

    if now < TrailSuppressUntil then
        return
    end

    if not isTrailReady() then
        return
    end

    if now - LastTrailShot < TrailFireRate then
        return
    end
    LastTrailShot = now

    local tool = getEquippedWeaponTool()
    if not tool then
        return
    end

    -- Don't fire trail if weapon has no ammo
    if not hasAmmo(tool) then
        return
    end

    local startPos = findBestMuzzlePosition(tool)
    if not startPos then
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then
            return
        end
        startPos = root.Position + Camera.CFrame.LookVector * 2 + Vector3.new(0, 1.3, 0)
    end

    local endPos = getTrailEndPosition(startPos)
    createBulletTrail(startPos, endPos)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.E then
            local now = tick()
            if now - LastReadyToggleAt < 0.2 then
                return
            end
            LastReadyToggleAt = now

            -- E cycle:
            -- click 1 = tracers off / safe
            -- click 2 = tracers on / ready
            -- click 3 = tracers off / safe again
            setTrailReadyState(not TrailReadyState)
            suppressTrails(0.18)
            return
        elseif input.KeyCode == Enum.KeyCode.F then
            -- Only force READY when a weapon is actually equipped.
            if getEquippedWeaponTool() then
                setTrailReadyState(true)
                suppressTrails(0.12)
            end
            return
        end
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        tryCreateAutomaticTrail()
    end
end)

