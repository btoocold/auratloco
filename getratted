    end
    local function rsize(y)
        listFrame.Size=UDim2.fromOffset(dOuter.AbsoluteSize.X, y or MAX*22+6)
    end
    rpos(); rsize()
    -- Track position changes (scrolling the groupbox moves the dropdown)
    dOuter:GetPropertyChangedSignal("AbsolutePosition"):Connect(rpos)
    dOuter:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() rpos(); rsize() end)

    local scroll=Library:Create("ScrollingFrame",{BackgroundTransparency=1;BorderSizePixel=0;
        CanvasSize=UDim2.new(0,0,0,0);Size=UDim2.fromScale(1,1);ZIndex=81;Parent=listFrame;
        TopImage="";BottomImage="";ScrollBarThickness=3;ScrollBarImageTransparency=0;
