local ExemptItems = {"Phone","Fist","Shiesty","Bandage","Lemonade","Car keys"}
local function MarketHasItem(n)
    local m = RepS:FindFirstChild("MarketItems") if not m then return false end
    for _, i in ipairs(m:GetChildren()) do
        if i.Name==n and i:FindFirstChild("owner") and i.owner.Value==LP.Name then return true end
    end return false
end
local function BackpackHasItem(n)
    for _, t in ipairs(LP.Backpack:GetChildren()) do if t:IsA("Tool") and t.Name==n then return true end end return false
end
local function ForcePutToMarket(n)
    local e=os.clock()+12
    while os.clock()<e do
        if MarketHasItem(n) then return true end
        pcall(function() RepS.ListWeaponRemote:FireServer(n,999999) end) task.wait(0.15)
    end
end
local function ForceRetrieve(n)
    local m=RepS:WaitForChild("MarketItems",10) if not m then return end
    local e=os.clock()+12
    while os.clock()<e do
        for _, item in ipairs(m:GetChildren()) do
            if item.Name==n and item:FindFirstChild("owner") and item.owner.Value==LP.Name and item:GetAttribute("SpecialId") then
                local sp=item:GetAttribute("SpecialId")
                pcall(function() RepS.BuyItemRemote:FireServer(n,"Remove",sp) end) task.wait(0.2)
                pcall(function() RepS.BackpackRemote:InvokeServer("Grab",n) end) task.wait(0.2)
                if BackpackHasItem(n) then return end
            end
        end task.wait(0.2)
    end
