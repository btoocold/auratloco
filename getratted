-- ── Input helpers (PC + Mobile) ───────────────────────────────
local function IsPress(inp)
    return inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch
end
local function IsMove(inp)
    return inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch
end
local function CursorPos()
    local ok, p = pcall(function() return InputService:GetMouseLocation() end)
    return ok and p or Vector2.zero
end
local function IsMobile()
    return InputService.TouchEnabled and not InputService.KeyboardEnabled
end

-- ── Tween ─────────────────────────────────────────────────────
local function Tween(inst, props, t, sty, dir)
    TweenService:Create(inst,
        TweenInfo.new(t or 0.12, sty or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end

-- ── Visual helpers ────────────────────────────────────────────
local function Rnd(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = parent; return c
end

local function MkStroke(parent, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(0, 80, 255)
    s.Thickness = thick or 1.5
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent; return s
end

local function Glow(parent, size)
    -- Glow parented to ScreenGui so it sits BEHIND the frame without clipping into it
    local g = Instance.new("ImageLabel")
    g.Name              = "GlowBehind"
    g.BackgroundTransparency = 1
    g.Image             = "rbxassetid://6015897843"
    g.ImageColor3       = Color3.fromRGB(0, 60, 220)
    g.ImageTransparency = 0.45
    g.AnchorPoint       = Vector2.new(0.5, 0.5)
    g.ZIndex            = (parent.ZIndex or 1) - 1
    g.Parent            = ScreenGui

    -- Track parent position/size and keep glow centered on it
    local function update()
        if not parent or not parent.Parent then g:Destroy(); return end
        local ap = parent.AbsolutePosition
        local as = parent.AbsoluteSize
        g.Position = UDim2.fromOffset(ap.X + as.X/2, ap.Y + as.Y/2)
        g.Size     = UDim2.fromOffset(as.X + (size or 28), as.Y + (size or 28))
    end

    update()
    parent:GetPropertyChangedSignal("AbsolutePosition"):Connect(update)
    parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
    parent:GetPropertyChangedSignal("Visible"):Connect(function()
        g.Visible = parent.Visible
    end)

    return g
end

local function Grad(parent, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color    = ColorSequence.new(c0, c1)
    g.Rotation = rot or 90
    g.Parent   = parent; return g
end

