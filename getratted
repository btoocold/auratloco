    end

    local _btn = Instance.new("TextButton")
    _btn.Name                  = "MenuToggleButton"
    _btn.Size                  = IsMobileDevice() and UDim2.new(0, 144, 0, 42) or UDim2.new(0, 110, 0, 30)
    _btn.Position              = IsMobileDevice() and UDim2.new(0, 560, 0, 18) or UDim2.new(0, 560, 0, 18)
    _btn.BackgroundColor3      = Color3.fromRGB(20, 20, 20)
    _btn.BorderSizePixel       = 0
    _btn.TextColor3            = Color3.fromRGB(255, 255, 255)
    _btn.Font                  = Enum.Font.GothamBold
    _btn.TextSize              = IsMobileDevice() and 14 or 12
    _btn.Text                  = "🟢 Close Menu"
    _btn.AutoButtonColor       = false
    _btn.Active                = true
    _btn.Parent                = _sg

    local _corner = Instance.new("UICorner")
    _corner.CornerRadius = UDim.new(0, IsMobileDevice() and 10 or 6)
    _corner.Parent = _btn

    local _stroke = Instance.new("UIStroke")
    _stroke.Color     = Color3.fromRGB(80, 80, 200)
    _stroke.Thickness = IsMobileDevice() and 2 or 1.5
    _stroke.Parent    = _btn

    local function getMenuGui()
        local screenGui = Library.ScreenGui
        if screenGui and screenGui.Parent then
            return screenGui
        end

        if Library.Holder and Library.Holder.Parent then
            return Library.Holder.Parent
        end

        return nil
    end

    local function applyMenuState()
        local screenGui = getMenuGui()
        if screenGui then
            screenGui.Enabled = _menuOpen
        end

        _btn.Text = _menuOpen and "🟢 Close Menu" or "🔴 Open Menu"
        _btn.BackgroundColor3 = _menuOpen
            and Color3.fromRGB(20, 20, 20)
            or  Color3.fromRGB(40, 10, 10)
    end

    _btn.InputEnded:Connect(function(inp)
        if not IsPrimaryInput(inp) then
            return
        end

        _menuOpen = not _menuOpen
        applyMenuState()
    end)

    task.defer(function()
        _btn.Position = ClampToViewport(_btn, _btn.Position)
        applyMenuState()
    end)
end

-- Scale: 1.0 = native size. Bump up for bigger, down for smaller.
task.spawn(function()
    task.wait(0.5)
    local screenGui = Library.ScreenGui or (Library.Holder and Library.Holder.Parent)
    if screenGui then
        local scale = screenGui:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
        if IsMobileDevice() then
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            -- iPad: short side >= 768, use full size
            local isIPad = math.min(vp.X, vp.Y) >= 768
            if isIPad then
                scale.Scale = 1.0
            else
                -- Phone: scale down to fit screen
                local windowX = 550
                local windowY = 350
                local scaleX = (vp.X * 0.95) / windowX
                local scaleY = (vp.Y * 0.85) / windowY
                local s = math.min(scaleX, scaleY, 0.62)
                scale.Scale = math.clamp(s, 0.35, 0.6)
            end
        else
            scale.Scale = 1.0
        end
        scale.Parent = screenGui
    end
end)

