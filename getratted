                            Toggles.CarBugToggle:SetValue(false)
                            return
                        end

                        if not car.PrimaryPart then
                            car.PrimaryPart = car:FindFirstChild("#Weight", true)
                                or car:FindFirstChildWhichIsA("BasePart")
                        end

                        -- Sit in car to make server register it as occupied/usable
                        car:SetPrimaryPartCFrame(c.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5))
                        task.wait(0.2)
                        seat:Sit(hum)
                        car:SetAttribute("Usable", true)
                        task.wait(0.8)
                        -- Eject so we're free
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        hum.Jump = true
                        hum.Sit  = false
                        task.wait(0.3)

                        NotificationLibrary:SendNotification("Car Bug", "Bugging " .. _target.Name .. "!", 3)

                        -- Spam car CFrame onto target — server sees occupied car collision
                        while _carBugEnabled do
                            local tChar = _target and _target.Character
                            local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            if tHRP and car and car.PrimaryPart then
                                local targetCF = tHRP.CFrame * CFrame.new(0, 2, 0)
                                pcall(function() car:SetPrimaryPartCFrame(targetCF) end)
                            end
                            task.wait(0.05)
                        end
                    end)
                else
                    _carBugEnabled = false
                    NotificationLibrary:SendNotification("Car Bug", "Car bug disabled", 3)
                end
            end,
        })
