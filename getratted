local Teleport = function(C, D)
    if not LP.Character or not LP.Character:FindFirstChild("Humanoid") then return end
    local h = LP.Character:FindFirstChild("Humanoid")
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if not h or not hrp then return end
    h:ChangeState(0)
    repeat task.wait() until not LP:GetAttribute("LastACPos")
    hrp.CFrame = C
    task.wait()
    h:ChangeState(2)
    task.wait()
    hrp.Anchored = false
    h.PlatformStand = false
    return true
end

PPS.PromptButtonHoldBegan:Connect(function(p, plr)
