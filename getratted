                NotificationLibrary:SendNotification("Emote", "Playing: " .. v, 2)
            end
        end,
    })

    EmoteGroup:AddButton({
        Text = 'Stop Emote',
        DoubleClick = false,
        Func = function()
            stopEmote()
            NotificationLibrary:SendNotification("Emote", "Stopped", 2)
        end,
    })

