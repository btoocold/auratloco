    local burstPart = Instance.new("Part")
    burstPart.Name = "SynthXImpactBurst"
    burstPart.Anchored = true
    burstPart.CanCollide = false
    burstPart.CanQuery = false
    burstPart.CanTouch = false
    burstPart.Transparency = 1
    burstPart.Size = Vector3.new(0.1, 0.1, 0.1)
    burstPart.CFrame = CFrame.new(position, position + (normal or Vector3.new(0, 1, 0)))
    burstPart.Parent = workspace

    local activeColor = BulletTrailRainbow and Color3.fromHSV(CurrentTrailHue, 1, 1) or BulletTrailColor

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "ImpactEmitter"
    emitter.Color = ColorSequence.new(activeColor)
