RunService.RenderStepped:Connect(function()
    if not Config.TheBronx.carfly then
        CarCleanup()
        return
    end

    if not carHum or carHum.SeatPart ~= carSeat then return end
    if not carRoot or not carBV or not carBG then CarSetup() return end

    local speed = Config.TheBronx.carflyspeed or 120
    local cam = workspace.CurrentCamera
    local camCF = cam.CFrame
    local camLook  = Vector3.new(camCF.LookVector.X,  0, camCF.LookVector.Z)
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    if camLook.Magnitude  > 0 then camLook  = camLook.Unit  end
    if camRight.Magnitude > 0 then camRight = camRight.Unit end

    if not UserInputService.TouchEnabled then
        -- PC
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            carBG.CFrame = CFrame.lookAt(carRoot.Position, carRoot.Position + cam.CFrame.LookVector)
        end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += camLook  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= camLook  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= camRight end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += camRight end
        if move.Magnitude > 0 then
            local rawLook = cam.CFrame.LookVector
            local vertical = rawLook.Y * (
                (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) +
                (UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0)
            )
            carBV.Velocity = Vector3.new(move.Unit.X*speed, vertical*speed, move.Unit.Z*speed)
        else
            carBV.Velocity = Vector3.zero
        end
    else
        -- Mobile — use our own touch buttons
        carBG.CFrame = CFrame.lookAt(carRoot.Position, carRoot.Position + cam.CFrame.LookVector)

        local move = Vector3.zero
        if _carFlyTouch.fwd   then move += camLook  end
        if _carFlyTouch.back  then move -= camLook  end
        if _carFlyTouch.left  then move -= camRight end
        if _carFlyTouch.right then move += camRight end

        local vert = 0
        if _carFlyTouch.up   then vert =  1 end
        if _carFlyTouch.down then vert = -1 end

        if move.Magnitude > 0 or vert ~= 0 then
            local flatV = move.Magnitude > 0 and move.Unit * speed or Vector3.zero
            carBV.Velocity = Vector3.new(flatV.X, vert*speed, flatV.Z)
        else
            carBV.Velocity = Vector3.zero
        end
    end
end)


local function GetNearestCar(hrp)
    local CivCars=workspace:FindFirstChild("CivCars") if not CivCars then return nil end
    local nearest, nearDist = nil, math.huge
    for _, car in ipairs(CivCars:GetChildren()) do
        if not car:IsA("Model") then continue end
        local seat=car:FindFirstChild("DriveSeat") if not seat then continue end
        if seat.Occupant then continue end
        if not car.PrimaryPart then
            local body=car:FindFirstChild("Body")
            car.PrimaryPart=(body and body:FindFirstChild("#Weight")) or seat
        end
        if not car.PrimaryPart then continue end
        local dist=(car.PrimaryPart.Position-hrp.Position).Magnitude
        if dist<nearDist then nearDist=dist nearest=car end
    end
    return nearest
end

