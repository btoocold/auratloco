    Library:Create("UIGradient",{Color=ColorSequence.new(hSeq);Rotation=90;Parent=hueBar})
    local hueCur=Library:Create("Frame",{AnchorPoint=Vector2.new(0.5,0.5);BackgroundColor3=Color3.new(1,1,1);
