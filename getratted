local PerfGroup = Tabs.Visuals:AddLeftGroupbox('🎮 Performance & Visuals')

do
    local _lighting = game:GetService("Lighting")

    -- Save ALL original lighting properties at script load
    local _origProps = {
        Brightness           = _lighting.Brightness,
        Ambient              = _lighting.Ambient,
        OutdoorAmbient       = _lighting.OutdoorAmbient,
        ColorShift_Bottom    = _lighting.ColorShift_Bottom,
        ColorShift_Top       = _lighting.ColorShift_Top,
        ExposureCompensation = _lighting.ExposureCompensation,
        FogEnd               = _lighting.FogEnd,
        FogStart             = _lighting.FogStart,
        FogColor             = _lighting.FogColor,
        GlobalShadows        = _lighting.GlobalShadows,
    }
    local _origEffectStates = {}
    for _, v in pairs(_lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            local entry = {enabled = v.Enabled}
            if v:IsA("ColorCorrectionEffect") then
                entry.saturation = v.Saturation
                entry.contrast   = v.Contrast
                entry.brightness = v.Brightness
                entry.tintColor  = v.TintColor
            end
            _origEffectStates[v] = entry
        end
    end

    local function restoreAllLighting()
        _lighting.Brightness           = _origProps.Brightness
        _lighting.Ambient              = _origProps.Ambient
        _lighting.OutdoorAmbient       = _origProps.OutdoorAmbient
        _lighting.ColorShift_Bottom    = _origProps.ColorShift_Bottom
        _lighting.ColorShift_Top       = _origProps.ColorShift_Top
        _lighting.ExposureCompensation = _origProps.ExposureCompensation
        _lighting.FogEnd               = _origProps.FogEnd
        _lighting.FogStart             = _origProps.FogStart
        _lighting.FogColor             = _origProps.FogColor
        _lighting.GlobalShadows        = _origProps.GlobalShadows
        for v, entry in pairs(_origEffectStates) do
            if v and v.Parent then
                pcall(function()
                    v.Enabled = entry.enabled
                    if v:IsA("ColorCorrectionEffect") then
                        v.Saturation = entry.saturation
                        v.Contrast   = entry.contrast
                        v.Brightness = entry.brightness
                        v.TintColor  = entry.tintColor
                    end
                end)
            end
        end
    end

    local function applyFPS()
        for _, v in pairs(_lighting:GetChildren()) do
            if v:IsA("PostEffect") then pcall(function() v.Enabled = false end) end
        end
        _lighting.Brightness     = math.max(_origProps.Brightness, 1.5)
        _lighting.Ambient        = Color3.fromRGB(110,110,110)
        _lighting.OutdoorAmbient = Color3.fromRGB(130,130,130)
        _lighting.GlobalShadows  = false
        NotificationLibrary:SendNotification("Visuals", "FPS Boost ON", 3)
    end

    PerfGroup:AddButton({
        Text        = '⚡ FPS Boost',
        DoubleClick = false,
        Tooltip     = 'Disables all lighting effects for more FPS',
        Func        = function() applyFPS() end,
    })

    PerfGroup:AddButton({
        Text        = '↩️ Restore Lighting',
        DoubleClick = false,
        Tooltip     = 'Restores lighting back to original after FPS boost',
        Func        = function()
            restoreAllLighting()
            NotificationLibrary:SendNotification("Visuals", "Lighting restored", 3)
        end,
    })

    PerfGroup:AddButton({
        Text        = '🌈 More Vibrant [RTX]',
        DoubleClick = false,
        Tooltip     = 'Makes the game more vibrant and colorful',
        Func        = function()
            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/DracoSwagBaby/ScriptsBanger/refs/heads/main/RTX"))()
                end)
            end)
            NotificationLibrary:SendNotification("Success", "RTX Mode Applied!", 3)
        end,
    })
end





-- ── Visuals Tab ───────────────────────────────────────────────
local VisualsRight = Tabs.Visuals:AddRightGroupbox('Gun Mods')

local SelectedGunColor = Color3.fromRGB(229, 129, 129)
local GunColorEnabled = false
local RainbowGunEnabled = false
local CurrentRainbowHue = 0

local OriginalGunParts = {}
local OriginalGunTextures = {}
local TrackedWeaponConnections = {}

local WEAPON_EXCLUDE_KEYWORDS = {
    "phone", "radio", "boombox", "camera", "medkit", "flashlight",
    "spray", "food", "cola", "drink", "burger", "bag", "key", "card",
    "wallet", "toy", "gift", "present", "flower", "seed", "gear",
    "watering can", "trowel", "recall wrench", "sprinkler", "rod",
    "favorite tool", "harvest tool"
}

local function disconnectTrackedWeaponConnections()
    for _, connection in ipairs(TrackedWeaponConnections) do
        if connection and connection.Disconnect then
            connection:Disconnect()
        end
    end
    table.clear(TrackedWeaponConnections)
end

local function getPlayerContainers()
    local LocalPlayer = game:GetService("Players").LocalPlayer
    return {
        LocalPlayer.Character,
        LocalPlayer:FindFirstChildOfClass("Backpack")
    }
end

local function isEligibleWeaponTool(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    local toolName = string.lower(tool.Name)

    for _, word in ipairs(WEAPON_EXCLUDE_KEYWORDS) do
        if string.find(toolName, word, 1, true) then
            return false
        end
    end

    return true
end

local function isWeaponPart(instance)
    return instance:IsA("BasePart") and instance.Name ~= "Handle"
end

local function saveOriginalPart(part)
    if not part or not part:IsA("BasePart") or OriginalGunParts[part] then
        return
    end

    local saved = {
        Color = part.Color,
        Material = part.Material
    }

    if part:IsA("MeshPart") then
        saved.TextureID = part.TextureID
    end

    OriginalGunParts[part] = saved
end

local function saveOriginalTexture(obj)
    if not obj or OriginalGunTextures[obj] then
        return
    end

    local saved = {}

    if obj:IsA("Decal") or obj:IsA("Texture") then
        saved.Transparency = obj.Transparency
        saved.Color3 = obj.Color3
    elseif obj:IsA("SurfaceAppearance") then
        saved.Parent = obj.Parent
    end

    OriginalGunTextures[obj] = saved
end

local function eachWeaponDescendant(callback)
    for _, container in ipairs(getPlayerContainers()) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if isEligibleWeaponTool(item) then
                    for _, descendant in ipairs(item:GetDescendants()) do
                        callback(descendant, item)
                    end
                end
            end
        end
    end
end

local function saveOriginalGunData()
    eachWeaponDescendant(function(descendant)
        if isWeaponPart(descendant) then
            saveOriginalPart(descendant)
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") or descendant:IsA("SurfaceAppearance") then
            saveOriginalTexture(descendant)
        end
    end)
end

local function cacheOriginalsForTool(tool)
    if not tool or not tool:IsA("Tool") then
        return
    end

    for _, descendant in ipairs(tool:GetDescendants()) do
        if isWeaponPart(descendant) then
            saveOriginalPart(descendant)
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") or descendant:IsA("SurfaceAppearance") then
            saveOriginalTexture(descendant)
        end
    end
end


local function hideWeaponTextures()
    eachWeaponDescendant(function(descendant)
        if descendant:IsA("Decal") or descendant:IsA("Texture") then
            saveOriginalTexture(descendant)
            descendant.Transparency = 1
        elseif descendant:IsA("SurfaceAppearance") then
            saveOriginalTexture(descendant)
            descendant.Parent = nil
        end
    end)
end

local function applyGunColor(color)
    saveOriginalGunData()
    hideWeaponTextures()

    eachWeaponDescendant(function(descendant)
        if isWeaponPart(descendant) then
            descendant.Color = color
            descendant.Material = Enum.Material.Neon

            if descendant:IsA("MeshPart") then
                descendant.TextureID = ""
            end
        end
    end)
end

local function restoreGunColors()
    for part, data in pairs(OriginalGunParts) do
        if part and part.Parent then
            part.Color = data.Color
            part.Material = data.Material

            if part:IsA("MeshPart") and data.TextureID ~= nil then
                part.TextureID = data.TextureID
            end
        end
    end

    for obj, data in pairs(OriginalGunTextures) do
        if obj then
            if obj:IsA("Decal") or obj:IsA("Texture") then
                if obj.Parent then
                    obj.Transparency = data.Transparency
                    obj.Color3 = data.Color3
                end
            elseif obj:IsA("SurfaceAppearance") then
                if not obj.Parent and data.Parent then
                    obj.Parent = data.Parent
                end
            end
        end
    end
end

local function restoreSingleTool(tool)
    if not tool or not tool:IsA("Tool") then
        return
    end

    for _, descendant in ipairs(tool:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local saved = OriginalGunParts[descendant]
            if saved then
                descendant.Color = saved.Color
                descendant.Material = saved.Material

                if descendant:IsA("MeshPart") and saved.TextureID ~= nil then
                    descendant.TextureID = saved.TextureID
                end
            end
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            local saved = OriginalGunTextures[descendant]
            if saved then
                descendant.Transparency = saved.Transparency
                descendant.Color3 = saved.Color3
            end
        elseif descendant:IsA("SurfaceAppearance") then
            local saved = OriginalGunTextures[descendant]
            if saved and not descendant.Parent and saved.Parent then
                descendant.Parent = saved.Parent
            end
        end
    end
end

local function getPickerColor(Value)
    if typeof(Value) == "Color3" then
        return Value
    end

    if typeof(Value) == "table" then
        if typeof(Value.Value) == "Color3" then
            return Value.Value
        end

        if typeof(Value.Color) == "Color3" then
            return Value.Color
        end
    end

    return SelectedGunColor
end

local function refreshGunColor()
    if RainbowGunEnabled then
        applyGunColor(Color3.fromHSV(CurrentRainbowHue, 1, 1))
        return
    end

    if GunColorEnabled then
        applyGunColor(SelectedGunColor)
    else
        restoreGunColors()
    end
end

local function applyModeToSingleTool(tool)
    if not isEligibleWeaponTool(tool) then
        return
    end

    task.wait(0.05)

    if not RainbowGunEnabled and not GunColorEnabled then
        cacheOriginalsForTool(tool)
        return
    end

    for _, descendant in ipairs(tool:GetDescendants()) do
        if isWeaponPart(descendant) then
            saveOriginalPart(descendant)

            if RainbowGunEnabled then
                descendant.Color = Color3.fromHSV(CurrentRainbowHue, 1, 1)
                descendant.Material = Enum.Material.Neon
                if descendant:IsA("MeshPart") then
                    descendant.TextureID = ""
                end
            elseif GunColorEnabled then
                descendant.Color = SelectedGunColor
                descendant.Material = Enum.Material.Neon
                if descendant:IsA("MeshPart") then
                    descendant.TextureID = ""
                end
            end
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            saveOriginalTexture(descendant)
            if RainbowGunEnabled or GunColorEnabled then
                descendant.Transparency = 1
            end
        elseif descendant:IsA("SurfaceAppearance") then
            saveOriginalTexture(descendant)
            if RainbowGunEnabled or GunColorEnabled then
                descendant.Parent = nil
            end
        end
    end

    if not RainbowGunEnabled and not GunColorEnabled then
        restoreSingleTool(tool)
    end

