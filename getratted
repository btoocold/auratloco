;(function()
    local CombatRight = Tabs.Combat:AddRightGroupbox('Gun Mods')
    local _lp      = Players.LocalPlayer
    local _infAmmo = false
    local _noRecoil= false
    local _autoGun = false
    local _noRate  = false
    local _infDmg  = false
    local _noJam   = false
    local _infClips = false
    local _quickReload = false
    local MIN_RATE = 0.07
    local _orig    = nil

    local function getSettings()
        local char = _lp.Character
        if not char then return nil end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return nil end
        local mod = tool:FindFirstChild("Setting")
        if not mod then return nil end
        local ok, s = pcall(require, mod)
        return ok and type(s) == "table" and s or nil
    end

    local function capture(s)
        if _orig then return end
        _orig = {
            LimitedAmmoEnabled = s.LimitedAmmoEnabled,
            MaxAmmo            = s.MaxAmmo,
            AmmoPerMag         = s.AmmoPerMag,
            Ammo               = s.Ammo,
            Recoil             = s.Recoil,
            Auto               = s.Auto,
            FireRate           = s.FireRate,
            BaseDamage         = s.BaseDamage,
            JamChance          = s.JamChance,
            ReloadTime         = s.ReloadTime,
        }
    end

    local function apply()
        local s = getSettings()
        if not s then return end
        capture(s)

        -- Infinite Ammo
        if _infAmmo then
            s.LimitedAmmoEnabled = false
            s.MaxAmmo    = 10000
            s.AmmoPerMag = 10000
            s.Ammo       = 10000
        else
            s.LimitedAmmoEnabled = _orig.LimitedAmmoEnabled
            s.MaxAmmo            = _orig.MaxAmmo
            s.AmmoPerMag         = _orig.AmmoPerMag
            s.Ammo               = _orig.Ammo
        end

        -- No Recoil
        s.Recoil = _noRecoil and 0 or _orig.Recoil

        -- Auto / Fire Rate
        if _autoGun and _noRate then
            s.Auto = true s.FireRate = MIN_RATE
        elseif _autoGun then
            s.Auto = true s.FireRate = _orig.FireRate
        elseif _noRate then
            s.Auto = _orig.Auto s.FireRate = 0
        else
            s.Auto = _orig.Auto s.FireRate = _orig.FireRate
        end

        -- Infinite Damage
        s.BaseDamage = _infDmg and 9e9 or _orig.BaseDamage

        -- No Jam
        s.JamChance = _noJam and 0 or (_orig.JamChance or s.JamChance)

        -- Quick Reload
        s.ReloadTime = _quickReload and 0.1 or (_orig.ReloadTime or s.ReloadTime)
    end

    -- Inf Clips: hook shared.ReloadMag so it always succeeds without needing a mag in backpack
    local _origReloadMag = nil
    local function hookInfClips()
        if _infClips then
            if not _origReloadMag and shared.ReloadMag then
                _origReloadMag = shared.ReloadMag
            end
            shared.ReloadMag = function(tool)
                -- Skip the clip check, just return true so reload always works
                return true
            end
        else
            if _origReloadMag then
                shared.ReloadMag = _origReloadMag
            end
        end
    end

    local function onToolAdded(child)
        if child:IsA("Tool") then
            _orig = nil  -- clear so next apply() re-captures originals
            task.delay(0.15, apply)
        end
    end

    _lp.CharacterAdded:Connect(function(char)
        _orig = nil
        char.ChildAdded:Connect(onToolAdded)
    end)
    if _lp.Character then
        _lp.Character.ChildAdded:Connect(onToolAdded)
    end

    CombatRight:AddToggle('CombatInfAmmo', {
        Text = 'Infinite Ammo', Default = false,
        Tooltip = 'Equip a gun first. Toggle off restores original ammo.',
        Callback = function(v) _infAmmo = v apply() end,
    })
    CombatRight:AddToggle('CombatNoRecoil', {
        Text = 'No Recoil', Default = false,
        Tooltip = 'Toggle off restores original recoil.',
        Callback = function(v) _noRecoil = v apply() end,
    })
    CombatRight:AddToggle('CombatAutoGun', {
        Text = 'Automatic Gun', Default = false,
        Tooltip = 'Toggle off restores original fire mode.',
        Callback = function(v) _autoGun = v apply() end,
    })
    CombatRight:AddToggle('CombatNoFireRate', {
        Text = 'No Fire Rate', Default = false,
        Tooltip = 'Toggle off restores original fire rate.',
        Callback = function(v) _noRate = v apply() end,
    })
    CombatRight:AddToggle('CombatInfDmg', {
        Text = 'Infinite Damage', Default = false,
        Tooltip = 'Toggle off restores original damage.',
        Callback = function(v) _infDmg = v apply() end,
    })
    CombatRight:AddToggle('CombatNoJam', {
        Text = 'No Jam', Default = false,
        Tooltip = 'Gun will never jam. Toggle off restores original jam chance.',
        Callback = function(v) _noJam = v apply() end,
    })
    CombatRight:AddToggle('CombatInfClips', {
        Text = 'Infinite Clips', Default = false,
        Tooltip = 'Reload without needing a mag in your backpack.',
        Callback = function(v) _infClips = v hookInfClips() end,
    })
    CombatRight:AddToggle('CombatQuickReload', {
        Text = 'Quick Reload', Default = false,
        Tooltip = 'Reload speed set to near-instant. Toggle off restores original.',
        Callback = function(v) _quickReload = v apply() end,
    })
end)()

