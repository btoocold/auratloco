        enabled     = false;
        speed       = 60;
        velocity    = nil;
        gyro        = nil;
        seat        = nil;
        connections = {};
        move        = { W=false, A=false, S=false, D=false, Space=false, Shift=false };
    }

    local function cleanupFly()
        -- Save current fly position BEFORE anything is destroyed
        local savedCF = nil
        local _c = LP.Character
        local _hrp = _c and _c:FindFirstChild("HumanoidRootPart")
        if _hrp then savedCF = _hrp.CFrame end

        getgenv().flyData.enabled = false
        for _, c in pairs(getgenv().flyData.connections) do pcall(function() c:Disconnect() end) end
        getgenv().flyData.connections = {}

        -- Destroy velocity + gyro first to stop physics before unsitting
        if getgenv().flyData.velocity then pcall(function() getgenv().flyData.velocity:Destroy() end); getgenv().flyData.velocity = nil end
        if getgenv().flyData.gyro     then pcall(function() getgenv().flyData.gyro:Destroy() end);     getgenv().flyData.gyro     = nil end
        if getgenv().flyData.seat     then pcall(function() getgenv().flyData.seat:Destroy() end);     getgenv().flyData.seat     = nil end

        getgenv().SwimMethod = false

        -- Use the script's existing Teleport function which bypasses AC snapback
        if savedCF then
            task.wait()
            pcall(function() Teleport(savedCF) end)
        end

        local c = LP.Character
        if c then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
        end
    end

    local function setupFly()
        cleanupFly()
        getgenv().flyData.enabled = true

        local c   = LP.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not c or not hum or not hrp then return end

        getgenv().SwimMethod = true

        -- Invisible VehicleSeat welded to HRP so AC sees us as seated not flying
        local seat = Instance.new("VehicleSeat")
        seat.Name           = "FlySeat"
        seat.Anchored       = false
        seat.CanCollide     = false
        seat.Transparency   = 1
        seat.TopSurface     = Enum.SurfaceType.Smooth
        seat.BottomSurface  = Enum.SurfaceType.Smooth
        seat.CFrame         = hrp.CFrame * CFrame.new(0, -3, 0)
        seat.Parent         = workspace

        local weld = Instance.new("Weld")
        weld.Part0 = seat; weld.Part1 = hrp
        weld.C0    = CFrame.new(0, 3, 0)
        weld.Parent = seat

        seat:Sit(hum)

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9,1e9,1e9)
        bv.Velocity = Vector3.zero
        bv.Parent   = hrp
        getgenv().flyData.velocity = bv

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e9,1e9,1e9)
        bg.P         = 50000
        bg.D         = 1000
        bg.CFrame    = hrp.CFrame
        bg.Parent    = hrp
        getgenv().flyData.gyro = bg
        getgenv().flyData.seat = seat

        -- Input
        local ib = UserInputService.InputBegan:Connect(function(i, g)
            if g then return end
            if i.KeyCode == Enum.KeyCode.W     then getgenv().flyData.move.W     = true end
            if i.KeyCode == Enum.KeyCode.A     then getgenv().flyData.move.A     = true end
            if i.KeyCode == Enum.KeyCode.S     then getgenv().flyData.move.S     = true end
            if i.KeyCode == Enum.KeyCode.D     then getgenv().flyData.move.D     = true end
            if i.KeyCode == Enum.KeyCode.Space then getgenv().flyData.move.Space = true end
            if i.KeyCode == Enum.KeyCode.LeftShift then getgenv().flyData.move.Shift = true end
            if i.KeyCode == Enum.KeyCode.E then getgenv().flyData.speed = math.clamp(getgenv().flyData.speed+10, 20, 300) end
            if i.KeyCode == Enum.KeyCode.Q then getgenv().flyData.speed = math.clamp(getgenv().flyData.speed-10, 20, 300) end
        end)
        local ie = UserInputService.InputEnded:Connect(function(i)
            if i.KeyCode == Enum.KeyCode.W     then getgenv().flyData.move.W     = false end
            if i.KeyCode == Enum.KeyCode.A     then getgenv().flyData.move.A     = false end
            if i.KeyCode == Enum.KeyCode.S     then getgenv().flyData.move.S     = false end
            if i.KeyCode == Enum.KeyCode.D     then getgenv().flyData.move.D     = false end
            if i.KeyCode == Enum.KeyCode.Space then getgenv().flyData.move.Space = false end
            if i.KeyCode == Enum.KeyCode.LeftShift then getgenv().flyData.move.Shift = false end
        end)
        local rs = RunService.RenderStepped:Connect(function()
            if not getgenv().flyData.enabled or not getgenv().flyData.velocity or not getgenv().flyData.gyro then return end
            if not getgenv().SwimMethod then getgenv().SwimMethod = true end
            local cam = workspace.CurrentCamera
            getgenv().flyData.gyro.CFrame = cam.CFrame
            local dir = Vector3.zero

            if IsMobileDevice() then
                -- Mobile: use humanoid MoveDirection (driven by on-screen thumbstick)
                local mc   = LP.Character
                local mhum = mc and mc:FindFirstChildOfClass("Humanoid")
                local md   = mhum and mhum.MoveDirection or Vector3.zero
                if md.Magnitude > 0.1 then
                    dir = Vector3.new(md.X, 0, md.Z)
                end
                -- Tilt camera up/down to go up/down
                local tilt = cam.CFrame.LookVector.Y
                if math.abs(tilt) > 0.3 then
                    dir += Vector3.new(0, tilt, 0)
                end
            else
                if getgenv().flyData.move.W     then dir += cam.CFrame.LookVector end
                if getgenv().flyData.move.S     then dir -= cam.CFrame.LookVector end
                if getgenv().flyData.move.A     then dir -= cam.CFrame.RightVector end
                if getgenv().flyData.move.D     then dir += cam.CFrame.RightVector end
                if getgenv().flyData.move.Space then dir += Vector3.new(0,1,0) end
                if getgenv().flyData.move.Shift then dir -= Vector3.new(0,1,0) end
            end

            getgenv().flyData.velocity.Velocity = dir.Magnitude > 0 and dir.Unit * getgenv().flyData.speed or Vector3.zero
        end)
        table.insert(getgenv().flyData.connections, ib)
        table.insert(getgenv().flyData.connections, ie)
        table.insert(getgenv().flyData.connections, rs)
