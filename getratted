    -- ── Car Punch ───────────────────────────────────────────────
    do
        local _carBugEnabled = false

        CombatLeft:AddToggle('CarBugToggle', {
            Text    = 'Car Punch',
            Default = false,
            Tooltip = 'Launches ALL cars at the target from every direction',
            Callback = function(s)
                if s then
                    if not _target then
                        NotificationLibrary:SendNotification("Car Punch", "Select a player first!", 3)
                        Toggles.CarBugToggle:SetValue(false)
                        return
                    end

                    _carBugEnabled = true

                    task.spawn(function()
                        local c   = _lp.Character
                        local hum = c and c:FindFirstChildOfClass("Humanoid")
                        local hrp = c and c:FindFirstChild("HumanoidRootPart")
                        if not c or not hum or not hrp then
                            _carBugEnabled = false
                            Toggles.CarBugToggle:SetValue(false)
                            return
                        end

                        local civCars = workspace:FindFirstChild("CivCars")
                        if not civCars then
                            NotificationLibrary:SendNotification("Car Punch", "No CivCars found!", 3)
                            _carBugEnabled = false; Toggles.CarBugToggle:SetValue(false); return
                        end

                        -- Collect ALL available cars
                        local cars = {}
                        for _, v in pairs(civCars:GetChildren()) do
                            local seat = v:FindFirstChild("DriveSeat")
                            if seat then
                                -- Fix PrimaryPart if missing
                                if not v.PrimaryPart then
                                    v.PrimaryPart = v:FindFirstChild("#Weight", true)
                                        or v:FindFirstChildWhichIsA("BasePart")
                                end
                                if v.PrimaryPart then
                                    table.insert(cars, { model = v, seat = seat })
                                end
                            end
                        end

                        if #cars == 0 then
                            NotificationLibrary:SendNotification("Car Punch", "No cars found!", 3)
                            _carBugEnabled = false; Toggles.CarBugToggle:SetValue(false); return
                        end

                        -- Sit in first free car briefly to mark all as usable
                        local initCar = nil
                        for _, entry in pairs(cars) do
                            if not entry.seat.Occupant then
                                initCar = entry; break
                            end
                        end
                        if initCar then
                            pcall(function()
                                initCar.model:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0, 0, -5))
                            end)
                            task.wait(0.2)
                            pcall(function() initCar.seat:Sit(hum) end)
                            -- Mark ALL cars usable while seated
                            for _, entry in pairs(cars) do
                                entry.model:SetAttribute("Usable", true)
                            end
                            task.wait(0.8)
                            pcall(function()
                                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                                hum.Jump = true; hum.Sit = false
                            end)
                            task.wait(0.3)
                        end

                        NotificationLibrary:SendNotification("Car Punch", "Bugging " .. _target.Name .. " with " .. #cars .. " cars!", 3)

                        -- Sit in every car one by one to register them server-side
                        for _, entry in pairs(cars) do
                            local c2  = _lp.Character
                            local hum2 = c2 and c2:FindFirstChildOfClass("Humanoid")
                            local hrp2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                            if not hum2 or not hrp2 then break end
                            if entry.seat.Occupant then continue end
                            pcall(function()
                                entry.model:SetPrimaryPartCFrame(CFrame.new(hrp2.Position + Vector3.new(0,0,-4)))
                                entry.seat:Sit(hum2)
                                entry.model:SetAttribute("Usable", true)
                            end)
                            task.wait(0.3)
                            pcall(function()
                                hum2:ChangeState(Enum.HumanoidStateType.Jumping)
                                hum2.Jump = true; hum2.Sit = false
                            end)
                            task.wait(0.2)
                        end

                        -- Now continuously launch all cars at target from random directions
                        while _carBugEnabled do
                            local tChar = _target and _target.Character
                            local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
                            if tHRP then
                                local total = #cars
                                for i, entry in pairs(cars) do
                                    if entry.model and entry.model.PrimaryPart then
                                        pcall(function()
                                            local angle  = (i / total) * math.pi * 2 + (tick() * 0.7)
                                            local oy     = math.random(2, 8)
                                            local dist   = 55
                                            local spawnPos = tHRP.Position + Vector3.new(
                                                math.cos(angle) * dist, oy, math.sin(angle) * dist)
                                            entry.model:SetPrimaryPartCFrame(CFrame.new(spawnPos))
                                            local dir = (tHRP.Position - spawnPos).Unit
                                            for _, part in pairs(entry.model:GetDescendants()) do
                                                if part:IsA("BasePart") and not part.Anchored then
                                                    part.AssemblyLinearVelocity = dir * 300
                                                end
                                            end
                                        end)
                                    end
                                end
                            end
                            task.wait(0.5)
                        end
                    end)
                else
                    _carBugEnabled = false
                    NotificationLibrary:SendNotification("Car Punch", "Car Punch disabled", 3)
                end
            end,
        })
    end

    -- ── Bring Clone ───────────────────────────────────────────
