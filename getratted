                        NotificationLibrary:SendNotification("Car Bug", "Select a player first!", 3)
                        Toggles.CarBugToggle:SetValue(false)
                        return
                    end

                    _carBugEnabled = true

                    task.spawn(function()
                        local c   = _lp.Character
                        local hum = c and c:FindFirstChildOfClass("Humanoid")
                        if not c or not hum then
                            _carBugEnabled = false
                            Toggles.CarBugToggle:SetValue(false)
                            return
                        end

                        -- Find free car
                        local car, seat
                        for _, v in pairs(workspace.CivCars:GetChildren()) do
                            local s = v:FindFirstChild("DriveSeat")
                            if s and not s.Occupant then
                                car = v; seat = s; break
                            end
