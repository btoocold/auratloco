local function formatMoney(value)
    local formatted = tostring(value)
    repeat
        formatted, k = formatted:gsub("^(%-?%d+)(%d%d%d)", "%1,%2")
    until k == 0
    return "$" .. formatted
end

local function buildDisplayName(itemName)
    local itemData = ShopItems[itemName]
