        Position=UDim2.fromOffset(207,26);Size=UDim2.fromOffset(14,196);ZIndex=51;Parent=picker})
    Rnd(hueOuter,5); MkStroke(hueOuter,Library.OutlineColor,1)
    local hueBar=Library:Create("Frame",{BackgroundColor3=Color3.new(1,1,1);BorderSizePixel=0;
