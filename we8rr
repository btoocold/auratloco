		Parameter = ""
	}, WindowSettings.KeySettings.SecondAction)

	local Passthrough = false
	local PlayerAccessType = "lifetime"

	-- Fetch real key expiry from Junkie API and set PlayerAccessType
	do
		local junkieKey = getgenv and getgenv().SCRIPT_KEY
		if junkieKey and junkieKey ~= "KEYLESS" and junkieKey ~= "" then
			local httpFunc = request or http_request or (syn and syn.request)
			if httpFunc then
				local ok, response = pcall(function()
					return httpFunc({
						Url = "https://api.jnkie.com/api/v2/keys?key=" .. junkieKey,
						Method = "GET",
						Headers = {
							["Authorization"] = "Bearer 384c858c-8255-4f43-bd45-5e70b5aad879",
							["Content-Type"] = "application/json"
						}
					})
				end)
				if ok and response and response.StatusCode == 200 then
					local parseOk, parsed = pcall(function()
						return HttpService:JSONDecode(response.Body)
					end)
					if parseOk and parsed and parsed.keys and parsed.keys[1] then
						local keyData = parsed.keys[1]
						local expiresAt = keyData.expires_at
						local validityMinutes = keyData.validity_minutes
						if expiresAt == nil and (validityMinutes == nil or validityMinutes == 0) then
							PlayerAccessType = "lifetime"
						else
							PlayerAccessType = "timed"
							getgenv().SCRIPT_KEY_EXPIRY = expiresAt
						end
					end
				end
			end
		end
	end

	local Window = { Bind = Enum.KeyCode.K, CurrentTab = nil, State = true, Size = false, Settings = nil }

	Main.Title.Title.Text = WindowSettings.Name
	Main.Title.subtitle.Text = WindowSettings.Subtitle
