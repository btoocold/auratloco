        PinkCamoGloves = {'PinkCamoGloves', 'Pink Camo Gloves'},
        PurpleCamoGloves = {'PurpleCamoGloves', 'Purple Camo Gloves'},
        RedCamoGloves = {'RedCamoGloves', 'Red Camo Gloves'},
        YelloCamoGloves = {'YelloCamoGloves', 'YellowCamoGloves', 'Yellow Camo Gloves', 'Yello Camo Gloves'},
    }

    local _activeFitGlove = nil
    local _ownedGloveCache = {}

    local function _findToolAny(names)
        local char = _lp.Character
        local bag = _lp:FindFirstChildOfClass('Backpack') or _lp:FindFirstChild('Backpack')
        for _, root in ipairs({char, bag}) do
            if root then
                for _, n in ipairs(names) do
                    local t = root:FindFirstChild(n)
                    if t and t:IsA('Tool') then return t end
                end
                for _, t in ipairs(root:GetChildren()) do
                    if t:IsA('Tool') then
                        local low = t.Name:lower():gsub('%s+', '')
                        for _, n in ipairs(names) do
                            if low == tostring(n):lower():gsub('%s+', '') then return t end
                        end
                    end
                end
            end
        end
        return nil
    end

    local function _findGenericGloveTool()
        local char = _lp.Character
        local bag = _lp:FindFirstChildOfClass('Backpack') or _lp:FindFirstChild('Backpack')
        for _, root in ipairs({char, bag}) do
            if root then
                for _, t in ipairs(root:GetChildren()) do
                    if t:IsA('Tool') and tostring(t.Name):lower():gsub('%s+', '') == 'gloves' then
                        return t
                    end
                end
            end
        end
        return nil
    end

    local function _grabOwnedGlove(itemName)
        -- If the glove is already owned but stored, BackpackRemote:Grab should pull it
        -- back without needing to buy again. If it is not owned, this fails quietly.
        local r = _rep:FindFirstChild('BackpackRemote')
        if r and r:IsA('RemoteFunction') then
            pcall(function()
                r:InvokeServer('Grab', itemName)
            end)
            task.wait(0.2)
        end
    end

    local function _tryEquipTool(itemName)
        local char = _lp.Character
        local hum = char and char:FindFirstChildOfClass('Humanoid')
        if not hum then return false end
        local names = _gloveAlias[itemName] or {itemName}
        local tool = _findToolAny(names)
        if tool then
            pcall(function() hum:EquipTool(tool) end)
            return true
        end
        return false
    end

    local function _activateTool(tool)
        if not tool or not tool:IsA('Tool') then return false end
        local ok = pcall(function()
            tool:Activate()
        end)
        return ok
    end

    local function _equipAndActivateTool(itemName)
        local char = _lp.Character
        local hum = char and char:FindFirstChildOfClass('Humanoid')
        if not hum then return false end

        local names = _gloveAlias[itemName] or {itemName}
        for i = 1, 12 do
            local tool = _findToolAny(names)
            if tool then
                pcall(function() hum:EquipTool(tool) end)
                task.wait(0.12)
                tool = _findToolAny(names) or tool
                _activateTool(tool) -- same as left-clicking the glove after it equips
                return true
            end
            task.wait(0.12)
        end
        return false
    end

    local function _forceEquipGlove(itemName)
        -- Gloves are weird in this game: after wearing, the tool can turn into a
        -- generic "Gloves" tool, so color detection from the instance name is not reliable.
        -- This keeps the uploaded file behavior where WhiteGloves works, but stops
        -- buying BlackGloves again when the menu already applied/knows black is active.

        -- Same requested glove already active from this menu session: skip everything.
        -- This is the important no-rebuy fix for BlackGloves presets.
        if _activeFitGlove == itemName then
            return true
        end

        local names = _gloveAlias[itemName] or {itemName}
        local exactTool = _findToolAny(names)

        -- Exact color exists in Backpack/Character, so do not buy again.
        if exactTool then
            _ownedGloveCache[itemName] = true
            local ok = _equipAndActivateTool(itemName)
            if ok then _activeFitGlove = itemName end
            return ok
        end

        -- Do NOT use generic "Gloves" as ownership proof. It hides color and breaks
        -- black/white switching. Also do not let old cache block color switching.

        -- Buy the requested color. This preserves the version you said works for WhiteGloves.
        _callRemote('ShopRemote', itemName)
        _ownedGloveCache[itemName] = true
        task.wait(0.28)

        local ok = _equipAndActivateTool(itemName)

        -- Generic fallback only after buying. Never use generic "Gloves" to skip a buy.
        if not ok then
            local char = _lp.Character
            local hum = char and char:FindFirstChildOfClass('Humanoid')
            local generic = _findGenericGloveTool()
            if hum and generic then
                pcall(function() hum:EquipTool(generic) end)
                task.wait(0.12)
                pcall(function() generic:Activate() end)
                ok = true
            end
        end

        if ok then
            _activeFitGlove = itemName
        end
        return ok
    end

    local function _buyAndEquipItem(itemName)
        if tostring(itemName):lower():find('glove') then
            _forceEquipGlove(itemName)
        else
            _callRemote('ShopRemote', itemName)
            task.wait(0.15)
            _tryEquipTool(itemName)
        end
    end

