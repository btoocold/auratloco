    local function _pickRandom(list)
        if not list or #list == 0 then return nil end
        return list[math.random(1, #list)]
    end

    local function _clearLastShuffle(resetDefaults)
        -- Full cleanup used when auto-shuffle stops or a preset/reset is applied.
        -- Do NOT use this inside every shuffle tick, because it flashes the default outfit.
        if resetDefaults == nil then resetDefaults = true end
        for category, itemName in pairs(_lastShuffleWear) do
            if itemName and itemName ~= '' then
                _removeCloth(category, itemName)
                task.wait(0.0)
            end
        end
        table.clear(_lastShuffleWear)
        if resetDefaults then
            _resetShirtPantsToDefault()
        end
    end

    local function _resetAutoShuffleClothes()
        -- Hard reset after auto-shuffle turns off so random masks/hats/glasses/shiestys do not stay behind.
        -- This intentionally does NOT touch gloves, so the working glove preset logic stays safe.
        local seen = {}
        for category, lastItem in pairs(_lastShuffleWear) do
            if lastItem and lastItem ~= '' then
                local key = category .. '|' .. lastItem
                if not seen[key] then
                    seen[key] = true
                    _removeCloth(category, lastItem)
                    task.wait(0.0)
                end
            end
        end

        -- Remove anything that auto-shuffle could have worn. This makes toggle-off feel like a real reset.
        for category, list in pairs(_shuffleClothesPool) do
            if category ~= 'Shirts' and category ~= 'Pants' then
                for _, itemName in ipairs(list) do
                    local key = category .. '|' .. itemName
                    if not seen[key] then
                        seen[key] = true
                        _removeCloth(category, itemName)
                        task.wait(0.0)
                    end
                end
            end
        end

        table.clear(_lastShuffleWear)
        _resetShirtPantsToDefault()
    end

    local function _doOneAutoShuffle()
        -- Live shuffle should NOT reset the outfit between rolls.
        -- For exclusive accessories, remove only the previous item in that same category first.
        local order = {'Masks', 'Shiestys', 'Glasses', 'Hats', 'Shirts', 'Pants'}
        local exclusive = {Masks = true, Shiestys = true, Glasses = true, Hats = true}

        for _, category in ipairs(order) do
            local choice = _pickRandom(_shuffleClothesPool[category])
            if choice then
                local previous = _lastShuffleWear[category]
                if exclusive[category] and previous and previous ~= '' and previous ~= choice then
                    _removeCloth(category, previous)
                    task.wait(0.0)
                end

                _wearCloth(category, choice)
                _lastShuffleWear[category] = choice
                task.wait(0.0)
            end
        end
    end

    local function _stopAutoShuffle(cleanup)
        _autoShuffleClothes = false
        _autoShuffleToken = _autoShuffleToken + 1
        if cleanup then
            task.spawn(function()
                _resetAutoShuffleClothes()
            end)
        end
    end

    local function _startAutoShuffle()
        _autoShuffleClothes = true
        _autoShuffleToken = _autoShuffleToken + 1
        local token = _autoShuffleToken
        task.spawn(function()
            while _autoShuffleClothes and token == _autoShuffleToken do
                pcall(_doOneAutoShuffle)

                local waited = 0
                while _autoShuffleClothes and token == _autoShuffleToken and waited < _autoShuffleDelay do
                    local step = math.min(0.05, _autoShuffleDelay - waited)
                    task.wait(step)
                    waited = waited + step
                end
            end
        end)
    end

    local function _applyFit(name)
        local preset = _fitPresets[name]
        if not preset then
            NotificationLibrary:SendNotification('Fits', 'Select a fit preset first.', 3)
            return
        end
        task.spawn(function()
            if _autoShuffleClothes then
                _stopAutoShuffle(true)
                task.wait(0.18)
            else
                _clearLastShuffle()
                task.wait(0.08)
            end
            _removeAllPresetClothes(true, true)
            task.wait(0.12)
            if preset.Cloth then
                for _, data in ipairs(preset.Cloth) do
                    _wearCloth(data[1], data[2])
                    task.wait(0.07)
                end
            end
            if preset.Items then
                for _, itemName in ipairs(preset.Items) do
                    _buyAndEquipItem(itemName)
                    task.wait(0.06)
                end
            end
            NotificationLibrary:SendNotification('Fits', 'Equipped: '.. tostring(name), 3)
        end)
    end

    local function _resetPresetClothes()
        task.spawn(function()
            if _autoShuffleClothes then
                _stopAutoShuffle(true)
                task.wait(0.18)
            else
                _clearLastShuffle()
            end
            _removeAllPresetClothes(false)
        end)
    end

