;(function()
    local NameGroup   = Tabs.Misc:AddRightGroupbox('✏️ Name Changer')
    local _lp         = Players.LocalPlayer
    local _nameGui    = nil
    local _nameLabel  = nil
    local _nameOn     = false
    local _rainbowOn  = false
    local _nameColor  = Color3.fromRGB(255, 255, 255)
    local _rainbowHue = 0
    local _currentName = ""

    local function removeNameGui()
        if _nameGui and _nameGui.Parent then _nameGui:Destroy() end
        _nameGui   = nil
        _nameLabel = nil
    end

    local function applyNameGui(customName)
        removeNameGui()
        local char = _lp.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayName = customName end

        local bg = Instance.new("BillboardGui")
        bg.Name         = "_CustomName"
        bg.Adornee      = head
        bg.AlwaysOnTop  = true
        -- Bigger custom-name billboard only; does not affect Name ESP labels.
        bg.Size         = UDim2.new(0, 420, 0, 90)
        bg.StudsOffset  = Vector3.new(0, 3.4, 0)
        bg.Parent       = head

        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3             = _nameColor
        lbl.TextStrokeTransparency = 0.3
        lbl.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        lbl.Font                   = Enum.Font.GothamBold
        lbl.TextSize               = 38
        lbl.Text                   = customName
        lbl.Parent                 = bg

        _nameGui   = bg
        _nameLabel = lbl
    end

    -- Rainbow heartbeat loop
    local _rainbowNameTick = 0
    RunService.Heartbeat:Connect(function()
        if not _rainbowOn or not _nameLabel or not _nameLabel.Parent then return end
        local now = tick()
        if now - _rainbowNameTick < 0.05 then return end
        _rainbowNameTick = now
        _rainbowHue = (_rainbowHue + 0.01) % 1
        _nameLabel.TextColor3 = Color3.fromHSV(_rainbowHue, 1, 1)
    end)

    -- Re-apply on respawn
    _lp.CharacterAdded:Connect(function()
        if not _nameOn or _currentName == "" then return end
        task.wait(0.5)
        applyNameGui(_currentName)
    end)

    NameGroup:AddInput('NameChangerInput', {
        Default     = '',
        Numeric     = false,
        Finished    = false,
        Text        = 'Custom Name',
        Placeholder = 'Enter name...',
        Callback    = function(v)
            _currentName = v
            if _nameOn and v ~= "" then applyNameGui(v) end
        end,
    })

    NameGroup:AddToggle('NameChangerToggle', {
        Text    = 'Show Custom Name',
        Default = false,
        Tooltip = 'Displays your custom name above your head',
        Callback = function(v)
            _nameOn = v
