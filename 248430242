            return _cam
        end

        local function _viewportSize()
            local cam = _getCamera()
            return cam and cam.ViewportSize or Vector2.new(1280, 720)
        end

        local function _setFreeCamButton(btn, x, y, w, h)
            btn.Size = UDim2.fromOffset(math.floor(w), math.floor(h or w))
            btn.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
        end

        local function _makeFreeCamButton(parent, text, key)
            local b = Instance.new("TextButton")
            b.Name = "FreeCam_" .. key
            b.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
            b.BackgroundTransparency = 0.18
            b.Text = text
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
            b.Font = Enum.Font.GothamBold
            b.TextScaled = true
            b.AutoButtonColor = false
            b.Active = true
            b.ZIndex = 60
            b.Parent = parent

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 14)
            corner.Parent = b

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(95, 95, 145)
            stroke.Thickness = 1.4
            stroke.Transparency = 0.1
            stroke.Parent = b

            b.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                    _freeCamMove[key] = true
                end
            end)

            b.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                    _freeCamMove[key] = false
                end
            end)

            return b
        end

        local function _createFreeCamGui()
            _destroyFreeCamGui()

            if not IsMobileDevice() then
                return
            end

            local playerGui = _lp:FindFirstChildOfClass("PlayerGui") or _lp:WaitForChild("PlayerGui", 5)
            if not playerGui then return end

            local sg = Instance.new("ScreenGui")
            sg.Name = "GrimAIO_FreeCamMobile"
            sg.IgnoreGuiInset = true
            sg.ResetOnSpawn = false
            sg.DisplayOrder = 9997
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            sg.Parent = playerGui
            _freeCamGui = sg

            local buttons = {
                fwd   = _makeFreeCamButton(sg, "▼", "fwd"),
                back  = _makeFreeCamButton(sg, "▼", "back"),
                left  = _makeFreeCamButton(sg, "▼", "left"),
                right = _makeFreeCamButton(sg, "▼", "right"),
                up    = _makeFreeCamButton(sg, "▼", "up"),
                down  = _makeFreeCamButton(sg, "▼", "down"),
            }

            local hint = Instance.new("TextLabel")
            hint.Name = "FreeCamHint"
            hint.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
            hint.BackgroundTransparency = 0.28
            hint.TextColor3 = Color3.fromRGB(235, 235, 255)
            hint.Font = Enum.Font.GothamSemibold
            hint.TextScaled = true
            hint.Text = "Drag right side to look"
            hint.ZIndex = 59
            hint.Parent = sg
            local hCorner = Instance.new("UICorner")
            hCorner.CornerRadius = UDim.new(0, 10)
            hCorner.Parent = hint

            local draggingLook = false
            local lastTouchPos = nil

            table.insert(_freeCamConnections, _uis.TouchStarted:Connect(function(touch, processed)
                if not _freeCamOn or processed then return end
                local vp = _viewportSize()
                -- right half is reserved for camera look, but ignore the far right up/down button area
                if touch.Position.X > vp.X * 0.45 and touch.Position.Y > 72 then
                    draggingLook = true
                    lastTouchPos = touch.Position
                end
            end))

            table.insert(_freeCamConnections, _uis.TouchMoved:Connect(function(touch, processed)
                if not _freeCamOn or not draggingLook or not lastTouchPos then return end
                local delta = touch.Position - lastTouchPos
                lastTouchPos = touch.Position

                local sensitivity = 0.0
                _yaw = _yaw - (delta.X * sensitivity)
                _pitch = math.clamp(_pitch - (delta.Y * sensitivity), math.rad(-82), math.rad(82))
            end))

            table.insert(_freeCamConnections, _uis.TouchEnded:Connect(function()
                draggingLook = false
                lastTouchPos = nil
            end))

            local function layout()
                if not _freeCamGui then return end
                local vp = _viewportSize()
                local portrait = vp.Y > vp.X

                local size = portrait and math.clamp(vp.X * 0.14, 48, 62) or math.clamp(vp.Y * 0.13, 48, 58)
                local gap = portrait and 9 or 8
                local bottomPad = portrait and math.max(170, vp.Y * 0.17) or math.max(82, vp.Y * 0.12)
                local dpadW = (size * 3) + (gap * 2)
                local dpadH = dpadW

                -- Put the D-pad in the lower-middle left, above iPhone bottom/toolbars.
                local leftX = portrait and math.max(20, vp.X * 0.06) or math.max(24, vp.X * 0.04)
                local leftY = vp.Y - bottomPad - dpadH
                leftY = math.clamp(leftY, 105, math.max(105, vp.Y - dpadH - 74))

                local centerX = leftX + size + gap
                local midY = leftY + size + gap

                _setFreeCamButton(buttons.fwd,   centerX, leftY, size, size)
                _setFreeCamButton(buttons.back,  centerX, leftY + ((size + gap) * 2), size, size)
                _setFreeCamButton(buttons.left,  leftX,   midY, size, size)
                _setFreeCamButton(buttons.right, leftX + ((size + gap) * 2), midY, size, size)

                -- Vertical buttons stay on right side, above the vehicle/home controls.
                local rightX = portrait and (vp.X - size - 24) or math.min(vp.X - size - 32, vp.X * 0.8)
                local rightY = leftY + math.max(0, (dpadH - ((size * 2) + gap)) / 2)
                rightY = math.clamp(rightY, 105, math.max(105, vp.Y - ((size * 2) + gap) - 74))

                _setFreeCamButton(buttons.up,   rightX, rightY, size, size)
                _setFreeCamButton(buttons.down, rightX, rightY + size + gap, size, size)

                local hintW = portrait and math.min(vp.X * 0.48, 230) or math.min(vp.X * 0.26, 250)
                local hintH = 30
                hint.Size = UDim2.fromOffset(hintW, hintH)
                hint.Position = UDim2.fromOffset(math.floor((vp.X - hintW) / 2), portrait and 82 or 58)
            end

            layout()
            task.defer(layout)

            local cam = _getCamera()
            if cam then
                table.insert(_freeCamConnections, cam:GetPropertyChangedSignal("ViewportSize"):Connect(layout))
            end
            table.insert(_freeCamConnections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
                task.defer(layout)
                local cam2 = _getCamera()
                if cam2 then
                    table.insert(_freeCamConnections, cam2:GetPropertyChangedSignal("ViewportSize"):Connect(layout))
                end
            end))
        end

        local function _startFreeCam()
            local cam = _getCamera()
            if not cam then return end

            _freeCamOn = true
            _oldCamType = cam.CameraType
            _oldCamSubject = cam.CameraSubject
            cam.CameraType = Enum.CameraType.Scriptable

            local cf = cam.CFrame
            _pos = cf.Position
            local look = cf.LookVector
            _yaw = math.atan2(-look.X, -look.Z)
            _pitch = math.asin(math.clamp(look.Y, -1, 1))

            _createFreeCamGui()

            RunService:UnbindFromRenderStep("SynthFreeCam")
            RunService:BindToRenderStep("SynthFreeCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
                local camNow = _getCamera()
                if not camNow then return end

                local spd = _speed * dt
                local rot = CFrame.fromOrientation(_pitch, _yaw, 0)
                local lookVec = rot.LookVector
                local rightVec = rot.RightVector
                local upVec = Vector3.new(0, 1, 0)

                local move = Vector3.zero

                if _uis:IsKeyDown(Enum.KeyCode.W) or _freeCamMove.fwd then move += lookVec end
                if _uis:IsKeyDown(Enum.KeyCode.S) or _freeCamMove.back then move -= lookVec end
                if _uis:IsKeyDown(Enum.KeyCode.D) or _freeCamMove.right then move += rightVec end
                if _uis:IsKeyDown(Enum.KeyCode.A) or _freeCamMove.left then move -= rightVec end
                if _uis:IsKeyDown(Enum.KeyCode.E) or _freeCamMove.up then move += upVec end
                if _uis:IsKeyDown(Enum.KeyCode.Q) or _freeCamMove.down then move -= upVec end

                if move.Magnitude > 0 then
                    _pos += move.Unit * spd
                end

                -- Desktop mouse look while holding right click, mobile drag is handled above.
                if not IsMobileDevice() then
                    if _uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                        _uis.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                        local delta = _uis:GetMouseDelta()
                        local sensitivity = 0.003  -- Fixed - was 0.0!
                        _yaw -= delta.X * sensitivity
                        _pitch = math.clamp(_pitch - delta.Y * sensitivity, math.rad(-82), math.rad(82))
                    else
                        _uis.MouseBehavior = Enum.MouseBehavior.Default
                    end
                end

                local finalRot = CFrame.fromOrientation(_pitch, _yaw, 0)
                camNow.CFrame = CFrame.new(_pos) * finalRot
            end)
        end

        local function _stopFreeCam()
            _freeCamOn = false
            RunService:UnbindFromRenderStep("SynthFreeCam")
            _destroyFreeCamGui()
            if not IsMobileDevice() then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end

            local cam = _getCamera()
            if cam then
                cam.CameraType = _oldCamType or Enum.CameraType.Custom
                if _oldCamSubject then
                    cam.CameraSubject = _oldCamSubject
                else
                    local char = _lp.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then cam.CameraSubject = hum end
                    end
                end
            end
        end

        FreeCamGroup:AddToggle('FreeCamToggle', {
            Text    = '🎥 Free Camera',
            Default = false,
            Tooltip = IsMobileDevice() and 'Mobile buttons + drag right side to look' or 'WASD/Q/E to move, hold right click to look',
            Callback = function(v)
                if v then _startFreeCam() else _stopFreeCam() end
            end
        })

        FreeCamGroup:AddSlider('FreeCamSpeed', {
            Text = 'Free Cam Speed', Default = 50, Min = 10, Max = 300, Rounding = 0, Compact = false,
            Callback = function(v) _speed = v end
        })

        _lp.CharacterAdded:Connect(function()
            if _freeCamOn then
                task.defer(_stopFreeCam)
            end
        end)
    end
end)()

