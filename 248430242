-- -- Hitbox (Head Expand) --------------------------------------
;(function()
    local HitboxGroup  = Tabs.Combat:AddRightGroupbox('🎯 Hitbox')
    local _lp          = Players.LocalPlayer
    local _hitboxOn    = false
    local _hitboxSize  = 10
    local _origSizes   = {}
    local _expandedPlayers = {}  -- Track who we've expanded

    local function expandHead(player)
        if player == _lp then return end
        if _expandedPlayers[player] then return end  -- Already expanded, don't touch
        if not player.Character then return end
        
        local head = player.Character:FindFirstChild("Head")
        if not head then return end
        
        pcall(function()
            if not _origSizes[player] then
                _origSizes[player] = head.Size
            end
            head.Size = Vector3.new(_hitboxSize, _hitboxSize, _hitboxSize)
            _expandedPlayers[player] = true  -- Mark as expanded, never touch again
        end)
    end

    local function restoreHead(player)
        if not player.Character then return end
        local head = player.Character:FindFirstChild("Head")
        if head and _origSizes[player] then
            pcall(function()
                head.Size = _origSizes[player]
            end)
        end
        _origSizes[player] = nil
        _expandedPlayers[player] = nil
    end

    local function applyToAll()
        if _hitboxOn then
            for _, p in pairs(Players:GetPlayers()) do
                expandHead(p)
            end
        else
            for _, p in pairs(Players:GetPlayers()) do
                restoreHead(p)
            end
        end
    end

    -- Hook new players
    local function hookPlayer(p)
        if p == _lp then return end
        p.CharacterAdded:Connect(function(char)
            _expandedPlayers[p] = nil  -- Reset on respawn
            task.wait(0.1)  -- Small delay for head to load
            if _hitboxOn then expandHead(p) end
        end)
        if p.Character then
            if _hitboxOn then expandHead(p) end
        end
    end

    Players.PlayerAdded:Connect(hookPlayer)
    for _, p in pairs(Players:GetPlayers()) do
        hookPlayer(p)
    end

    HitboxGroup:AddToggle('HitboxToggle', {
        Text    = 'Expand Hitbox',
        Default = false,
        Tooltip = 'Enlarges every player\'s head',
        Callback = function(v)
            _hitboxOn = v
            applyToAll()
        end,
    })

    HitboxGroup:AddSlider('HitboxSizeSlider', {
        Text     = 'Hitbox Size',
        Default  = 5,
        Min      = 2,
        Max      = 5,
        Rounding = 0,
        Compact  = false,
        Callback = function(v)
            _hitboxSize = v
            -- Only re-expand if someone is already expanded and size changed
            if _hitboxOn then
                _expandedPlayers = {}  -- Reset tracking so we re-expand with new size
                applyToAll()
            end
        end,
    })
end)()

