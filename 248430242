-- -- Auto Drop / Auto Pass -------------------------------------
do
    local DropItemRemote = ReplicatedStorage:WaitForChild("DropItemRemote")
    local DropRemote = ReplicatedStorage:WaitForChild("DropRemote")

    DupeGroup:AddDivider()
    DupeGroup:AddLabel('Auto drop / pass held tools')

    -- Auto Drop specific item
    local autoDropEnabled = false
    local dropLoopTask    = nil
    local selectedDropItem = nil

    -- Get all unique tool names from backpack + character

    -- Drop all copies of selected item
    local _dropBusy = false
    local function dropSelected()
        if not autoDropEnabled or not selectedDropItem then return end
        if _dropBusy then return end
        _dropBusy = true

        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not humanoid then _dropBusy = false; return end

        -- Snapshot backpack tools matching selected item
        local tools = {}
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == selectedDropItem then
                table.insert(tools, tool)
            end
        end

        for _, tool in pairs(tools) do
            if not autoDropEnabled then break end
            pcall(function()
                humanoid:EquipTool(tool)
                task.wait(0.6) -- wait for server to register equip before dropping
                DropItemRemote:FireServer(tool)
                task.wait(0.5) -- wait before cycling to next gun
            end)
        end

        _dropBusy = false
    end

    -- Build item list from backpack
    local function getBackpackItems()
        local items = {}
        local seen = {}
        local function scan(parent)
            for _, tool in pairs(parent:GetChildren()) do
                if tool:IsA("Tool") and not seen[tool.Name] then
                    seen[tool.Name] = true
                    table.insert(items, tool.Name)
                end
            end
        end
        if LocalPlayer.Character then scan(LocalPlayer.Character) end
        scan(LocalPlayer.Backpack)
        table.sort(items)
        return #items > 0 and items or {"(empty)"}
    end

    local itemDropdown = DupeGroup:AddDropdown("AutoDropItemDropdown", {
        Values   = getBackpackItems(),
        Default  = 1,
        Text     = "Item to Drop",
        Tooltip  = "Pick which item to drop all copies of",
        Callback = function(v)
            selectedDropItem = v ~= "(empty)" and v or nil
        end,
    })

    DupeGroup:AddButton({
        Text = "🔄 Refresh Item List",
        Func = function()
            local items = getBackpackItems()
            itemDropdown:SetValues(items)
            NotificationLibrary:SendNotification("Auto Drop", "Refreshed!", 2)
        end,
    })

    DupeGroup:AddToggle("AutoDropToggle", {
        Text    = "Auto Drop Selected Item",
        Default = false,
        Tooltip = "Equips and drops all copies of the selected item",
        Callback = function(state)
            autoDropEnabled = state
            if dropLoopTask then task.cancel(dropLoopTask); dropLoopTask = nil end
            if state then
                if not selectedDropItem then
                    -- Auto select first item in dropdown
                    local items = getBackpackItems()
                    selectedDropItem = items[1] ~= "(empty)" and items[1] or nil
                end
                if not selectedDropItem then
                    NotificationLibrary:SendNotification("Auto Drop", "No items in backpack!", 3)
                    autoDropEnabled = false
                    return
                end
                task.spawn(dropSelected)
                dropLoopTask = task.spawn(function()
                    while autoDropEnabled do
                        task.wait(1.5)
                        dropSelected()
                    end
                end)
                NotificationLibrary:SendNotification("Auto Drop", "Dropping: " .. tostring(selectedDropItem), 2)
            else
                NotificationLibrary:SendNotification("Auto Drop", "Disabled", 2)
            end
        end
    })

    -- Auto Pass to closest player
    local autoPassEnabled = false
    local passConnection = nil

    local function passItem()
        if not autoPassEnabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        local tool = character:FindFirstChildWhichIsA("Tool")
            or LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
        if tool then
            DropRemote:FireServer("Drop")
        end
    end

    DupeGroup:AddToggle("AutoPassToggle", {
        Text = "Auto Pass to Closest Player",
        Default = false,
        Tooltip = "Automatically passes tools to the nearest player",
        Callback = function(state)
            autoPassEnabled = state
            if passConnection then
                passConnection:Disconnect()
                passConnection = nil
            end
            if state then
                passItem()
                local char = LocalPlayer.Character
                if char then
                    passConnection = char.ChildAdded:Connect(function(child)
                        if child:IsA("Tool") then
                            task.wait(0.1)
                            passItem()
                        end
                    end)
                end
                NotificationLibrary:SendNotification("Auto Pass", "Enabled", 2)
            else
                NotificationLibrary:SendNotification("Auto Pass", "Disabled", 2)
            end
        end
    })

    -- Reconnect on respawn
    LocalPlayer.CharacterAdded:Connect(function(char)
        if autoDropEnabled then
            task.wait(0.5)
            dropSelected()
        end
        if autoPassEnabled then
            if passConnection then passConnection:Disconnect() end
            passConnection = char.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                    task.wait(0.1)
                    passItem()
                end
            end)
        end
    end)
end

