-- dXtg8 enhanced WalkSpeed backend
local speed = 16
local boostMultiplier = 2
local enhancedWalk = false

local ewCharacter, ewHumanoid, ewHumanoidRootPart
local bodyGyro
local movementConnection
local freezeConnection
local animationTrack

local ewAnimation = Instance.new("Animation")
ewAnimation.AnimationId = "rbxassetid://78828590676720"

getgenv().SwimMethod = false

task.spawn(function()
