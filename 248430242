    local function _findGunConfig()
        _gunConfig = nil
        local _method = "none"
        -- Primary: filtergc
        pcall(function()
            for _, t in next, filtergc("table", {}) do
                if type(t) == "table" and rawget(t, "Ammo") and rawget(t, "MuzzleFlashEnabled") then
                    _gunConfig = t; _method = "filtergc"; break
                end
            end
        end)
        -- Fallback 1: getsenv
        if not _gunConfig then pcall(function()
            local char = Players.LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool then return end
            local gs = tool:FindFirstChild("GunScript_Local") or tool:FindFirstChild("GunScript")
            if not gs then return end
            local env = getsenv and getsenv(gs)
            if not env then return end
            for _, v in pairs(env) do
                if type(v) == "table" and rawget(v, "Ammo") and rawget(v, "MuzzleFlashEnabled") then
                    _gunConfig = v; _method = "getsenv"; break
                end
            end
        end) end
        -- Fallback 2: require Setting
        if not _gunConfig then pcall(function()
            local char = Players.LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool then return end
            local mod = tool:FindFirstChild("Setting")
            if not mod then return end
            local prev = _hookActive; _hookActive = false
            local ok, s = pcall(require, mod)
            _hookActive = prev
            if ok and type(s) == "table" and s.MuzzleFlashEnabled ~= nil then
                _gunConfig = s; _method = "require:Setting"
            end
        end) end
        -- Fallback 3: require all ModuleScripts
        if not _gunConfig then pcall(function()
            local char = Players.LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not tool then return end
            for _, mod in ipairs(tool:GetDescendants()) do
                if mod:IsA("ModuleScript") then
                    local prev = _hookActive; _hookActive = false
                    local ok, s = pcall(require, mod)
                    _hookActive = prev
                    if ok and type(s) == "table" and s.MuzzleFlashEnabled ~= nil and s.Ammo ~= nil then
                        _gunConfig = s; _method = "require:scan"; break
                    end
                end
            end
        end) end
        -- Fallback 4: getgc(true)
        if not _gunConfig then pcall(function()
            for _, t in ipairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "Ammo") and rawget(t, "MuzzleFlashEnabled") then
                    _gunConfig = t; _method = "getgc(true)"; break
                end
            end
        end) end
        -- Fallback 5: getgc()
        if not _gunConfig then pcall(function()
            for _, t in ipairs(getgc()) do
                if type(t) == "table" and rawget(t, "Ammo") and rawget(t, "MuzzleFlashEnabled") then
                    _gunConfig = t; _method = "getgc()"; break
                end
            end
        end) end
        if _gunConfig then _scrubGunConfig(_gunConfig) _lastKnownConfig = _gunConfig end
    end
    local function _hookChar(char)
