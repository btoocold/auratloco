task.spawn(function()
    if not _loadGui or not _loadGui.Parent then return end
    repeat task.wait(0.05) until _barDone
    task.wait(0.4)
    -- fade the whole gui out in one tween, then destroy
    local fade = TS:Create(_loadBg,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundTransparency = 1 }
    )
    -- also fade children that have their own color
    for _, d in ipairs(_loadBg:GetDescendants()) do
        if d:IsA("TextLabel") then
            TS:Create(d, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
        elseif d:IsA("Frame") then
            TS:Create(d, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
        elseif d:IsA("ImageLabel") then
            TS:Create(d, TweenInfo.new(0.5), { ImageTransparency = 1 }):Play()
        end
    end
    fade:Play()
    fade.Completed:Connect(function()
        pcall(function() _loadGui:Destroy() end)
        pcall(function() if _menuSG then _menuSG.Enabled = true end end)
        pcall(function()
            local sg = game:GetService("CoreGui"):FindFirstChild("SynthMenuToggle")
            if sg then local b = sg:FindFirstChild("MenuToggleButton") if b then b.Visible = true end end
        end)
    end)
end)

