    sg.Name = "CarFlyButtons"
    sg.IgnoreGuiInset = true
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 9998
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = LP:FindFirstChildOfClass("PlayerGui") or LP.PlayerGui
    _carFlyGui = sg

    local camera = workspace.CurrentCamera
    local buttons = {}

    local function makeBtn(text, key)
        local f = Instance.new("TextButton")
        f.Name = "CarFly_" .. key
        f.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        f.BackgroundTransparency = 0.22
        f.Text = text
        f.TextColor3 = Color3.new(1, 1, 1)
        f.Font = Enum.Font.GothamBold
        f.TextScaled = true
        f.AutoButtonColor = false
        f.Active = true
        f.ZIndex = 50
        f.Parent = sg

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = f

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(70, 70, 90)
        stroke.Thickness = 1.25
        stroke.Transparency = 0.15
        stroke.Parent = f

        f.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                _carFlyTouch[key] = true
            end
        end)

        f.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                _carFlyTouch[key] = false
            end
        end)

        buttons[key] = f
        return f
    end

    makeBtn("▼", "fwd")
    makeBtn("▼", "back")
    makeBtn("▼", "left")
    makeBtn("▼", "right")
    makeBtn("▼", "up")
    makeBtn("▼", "down")

    local function viewportSize()
        camera = workspace.CurrentCamera or camera
        return camera and camera.ViewportSize or Vector2.new(1280, 720)
    end

    local function setButton(btn, x, y, size)
        btn.Size = UDim2.fromOffset(size, size)
        btn.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
    end

    local function layoutButtons()
        if not _carFlyGui then return end

        local vp = viewportSize()
        local portrait = vp.Y > vp.X
        local size = portrait and 58 or 56
        local gap = portrait and 10 or 8

        -- Keep controls away from the very bottom on iPhone portrait,
        -- while still staying reachable with thumbs.
        local dpadW = (size * 3) + (gap * 2)
        local dpadH = dpadW
        local centerY = portrait and (vp.Y * 0.56) or (vp.Y * 0.6)

        local leftX = portrait and math.max(22, vp.X * 0.07) or 34
        local leftY = math.clamp(centerY - (dpadH / 2), 112, math.max(112, vp.Y - dpadH - (portrait and 210 or 105)))

        local centerX = leftX + size + gap
        local midY = leftY + size + gap

        setButton(buttons.fwd,  centerX,             leftY,              size)
        setButton(buttons.back, centerX,             leftY + (size+gap)*2, size)
        setButton(buttons.left, leftX,               midY,               size)
        setButton(buttons.right,leftX + (size+gap)*2, midY,               size)

        local vertH = (size * 2) + gap
        local rightX
        if portrait then
            -- iPhone portrait: put vertical controls higher on the right, not down by the home bar.
            rightX = vp.X - size - 24
        else
            -- iPhone landscape/tablet: keep it right side but not hidden under Roblox vehicle buttons.
            rightX = math.min(vp.X - size - 28, vp.X * 0.78)
        end

        local rightY = math.clamp(centerY - (vertH / 2), 112, math.max(112, vp.Y - vertH - (portrait and 210 or 105)))
        setButton(buttons.up,   rightX, rightY,            size)
        setButton(buttons.down, rightX, rightY + size + gap, size)
    end

    layoutButtons()
    task.defer(layoutButtons)

    if camera then
        table.insert(_carFlyGuiConnections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutButtons))
    end

    table.insert(_carFlyGuiConnections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        camera = workspace.CurrentCamera
        task.defer(layoutButtons)
        if camera then
            table.insert(_carFlyGuiConnections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutButtons))
        end
    end))
end

local function destroyCarFlyButtons()
    _carFlyTouch = { fwd=false, back=false, left=false, right=false, up=false, down=false }

    for _, conn in ipairs(_carFlyGuiConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(_carFlyGuiConnections)

    if _carFlyGui then
        _carFlyGui:Destroy()
        _carFlyGui = nil
    end
end

local _carFlyTick = 0
local _carFlyWasOn = false
RunService.RenderStepped:Connect(function()
    if not Config.TheBronx.carfly then
        if _carFlyWasOn then
            _carFlyWasOn = false
            CarCleanup()
        end
        return
    end
    _carFlyWasOn = true
    -- throttle to 30fps on mobile instead of full 60fps
    if IsMobileDevice() then
        local now = tick()
        if now - _carFlyTick < 0.03 then return end
        _carFlyTick = now
    end

    if not carHum or carHum.SeatPart ~= carSeat then return end
    if not carRoot or not carBV or not carBG then CarSetup() return end

    local speed = Config.TheBronx.carflyspeed or 120
    local cam = workspace.CurrentCamera
    local camCF = cam.CFrame
    local camLook  = Vector3.new(camCF.LookVector.X,  0, camCF.LookVector.Z)
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
    if camLook.Magnitude  > 0 then camLook  = camLook.Unit  end
    if camRight.Magnitude > 0 then camRight = camRight.Unit end

    if not UserInputService.TouchEnabled then
        -- PC
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            carBG.CFrame = CFrame.lookAt(carRoot.Position, carRoot.Position + cam.CFrame.LookVector)
        end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += camLook  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= camLook  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= camRight end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += camRight end
        if move.Magnitude > 0 then
            local rawLook = cam.CFrame.LookVector
            local vertical = rawLook.Y * (
                (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) +
                (UserInputService:IsKeyDown(Enum.KeyCode.S) and -1 or 0)
            )
            carBV.Velocity = Vector3.new(move.Unit.X*speed, vertical*speed, move.Unit.Z*speed)
        else
            carBV.Velocity = Vector3.zero
        end
    else
        -- Mobile -- use our own touch buttons
        carBG.CFrame = CFrame.lookAt(carRoot.Position, carRoot.Position + cam.CFrame.LookVector)

        local move = Vector3.zero
        if _carFlyTouch.fwd   then move += camLook  end
        if _carFlyTouch.back  then move -= camLook  end
        if _carFlyTouch.left  then move -= camRight end
        if _carFlyTouch.right then move += camRight end

        local vert = 0
        if _carFlyTouch.up   then vert =  1 end
        if _carFlyTouch.down then vert = -1 end

        if move.Magnitude > 0 or vert ~= 0 then
            local flatV = move.Magnitude > 0 and move.Unit * speed or Vector3.zero
            carBV.Velocity = Vector3.new(flatV.X, vert*speed, flatV.Z)
        else
            carBV.Velocity = Vector3.zero
        end
    end
end)


local function GetNearestCar(hrp)
    local CivCars=workspace:FindFirstChild("CivCars") if not CivCars then return nil end
    local nearest, nearDist = nil, math.huge
    for _, car in ipairs(CivCars:GetChildren()) do
        if not car:IsA("Model") then continue end
        local seat=car:FindFirstChild("DriveSeat") if not seat then continue end
        if seat.Occupant then continue end
        if not car.PrimaryPart then
            local body=car:FindFirstChild("Body")
            car.PrimaryPart=(body and body:FindFirstChild("#Weight")) or seat
        end
        if not car.PrimaryPart then continue end
        local dist=(car.PrimaryPart.Position-hrp.Position).Magnitude
        if dist<nearDist then nearDist=dist nearest=car end
    end
    return nearest
end

