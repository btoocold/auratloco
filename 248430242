    local function _scrubGunConfig(t)
        -- Only scrub values not used by any gun mod feature
        -- so guns dont feel slow/broken
        pcall(function()
            t["DevNotes"]      = ""
            t["ScriptVersion"] = ""
            t["GunModel"]      = ""
