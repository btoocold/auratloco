-- -- Health ESP + Box ESP (Drawing-based) ----------------------
do
    local _cam       = workspace.CurrentCamera
    local _healthOn  = false
    local _skelOn    = false
    local _skelColor = Color3.fromRGB(255, 255, 255)
    local _skelThick = 1
    local _espData   = {}  -- [player] = { lines={}, hbBg, hbFill, mode }

    local USE_DRAWING = (typeof(Drawing) == "table" or typeof(Drawing) == "userdata")

    -- Skeleton joint connections (R15)
    local BONES = {
        {"Head",        "UpperTorso"},
        {"UpperTorso",  "LowerTorso"},
        {"LowerTorso",  "RightUpperLeg"},
        {"RightUpperLeg","RightLowerLeg"},
        {"RightLowerLeg","RightFoot"},
        {"LowerTorso",  "LeftUpperLeg"},
        {"LeftUpperLeg","LeftLowerLeg"},
        {"LeftLowerLeg","LeftFoot"},
        {"UpperTorso",  "RightUpperArm"},
        {"RightUpperArm","RightLowerArm"},
        {"RightLowerArm","RightHand"},
        {"UpperTorso",  "LeftUpperArm"},
        {"LeftUpperArm","LeftLowerArm"},
        {"LeftLowerArm","LeftHand"},
    }

    -- -- Drawing line helper -----------------------------------
    local function makeLine(thick, col)
        local l = Drawing.new("Line")
        l.Visible = false; l.From = Vector2.zero; l.To = Vector2.zero
        l.Color = col; l.Thickness = thick
        -- Note: no Transparency=1 -- some executors ignore it and show the line anyway
        return l
    end

    -- -- BillboardGui line (mobile) ----------------------------
    -- We can't easily draw 2D screen lines from BillboardGui,
    -- so on mobile we use a BillboardGui dot on each joint instead
    local function makeJointDot(adornee)
        local bb = Instance.new("BillboardGui")
        bb.Adornee        = adornee
        bb.Size           = UDim2.fromOffset(8, 8)
        bb.StudsOffset    = Vector3.zero
        bb.AlwaysOnTop    = true
        bb.ResetOnSpawn   = false
        bb.LightInfluence = 0
        bb.Parent         = LP.PlayerGui
        local dot = Instance.new("Frame", bb)
        dot.Size              = UDim2.fromScale(1, 1)
        dot.BackgroundColor3  = _skelColor
        dot.BorderSizePixel   = 0
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
        return bb
    end

    local function getOrCreate(player)
        if _espData[player] then return _espData[player] end
        local d = { lines = {}, dots = {}, mode = USE_DRAWING and "drawing" or "billboard" }

        if USE_DRAWING then
            for i = 1, #BONES do
                d.lines[i] = makeLine(_skelThick, _skelColor)
            end
            -- only create health bar lines if health ESP is on
            -- creating them upfront causes red/green/yellow lines to appear even when disabled
            if _healthOn then
                d.gh = makeLine(2, Color3.fromRGB(0,255,0))
                d.yh = makeLine(2, Color3.fromRGB(255,200,0))
                d.rh = makeLine(2, Color3.fromRGB(255,0,0))
            end
        else
            -- Billboard dots on each joint
            local char = player.Character
            if char then
                for _, bone in pairs(BONES) do
                    for _, partName in pairs(bone) do
                        if not d.dots[partName] then
                            local part = char:FindFirstChild(partName)
                            if part then
                                d.dots[partName] = makeJointDot(part)
                            end
                        end
                    end
                end
                -- Health bar billboard on HRP
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bb = Instance.new("BillboardGui")
                    bb.Adornee = hrp; bb.Size = UDim2.fromOffset(4, 60)
                    bb.StudsOffset = Vector3.new(-1.4, 0, 0)
                    bb.SizeOffset = Vector2.new(0, 0)
                    bb.AlwaysOnTop = true; bb.ResetOnSpawn = false
                    bb.LightInfluence = 0; bb.Parent = LP.PlayerGui
                    local bg = Instance.new("Frame", bb)
                    bg.Size = UDim2.fromScale(1,1)
                    bg.BackgroundColor3 = Color3.fromRGB(30,30,30)
                    bg.BorderSizePixel = 0
                    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
                    local fill = Instance.new("Frame", bg)
                    fill.AnchorPoint = Vector2.new(0,1)
                    fill.Position = UDim2.fromScale(0,1)
                    fill.Size = UDim2.fromScale(1,1)
                    fill.BackgroundColor3 = Color3.fromRGB(0,255,80)
                    fill.BorderSizePixel = 0
                    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
                    d.hbGui = bb; d.hbFill = fill
                end
            end
        end

        _espData[player] = d
        return d
    end

    local function removeESP(player)
        local d = _espData[player]
        if not d then return end
        if d.mode == "drawing" then
            for _, l in pairs(d.lines) do pcall(function() l:Remove() end) end
            if d.gh then d.gh:Remove() end
            if d.yh then d.yh:Remove() end
            if d.rh then d.rh:Remove() end
        else
            for _, dot in pairs(d.dots) do pcall(function() dot:Destroy() end) end
            if d.hbGui then pcall(function() d.hbGui:Destroy() end) end
        end
        _espData[player] = nil
        HealthBarData[player] = nil
    end

    local function hideDrawing(d)
        for _, l in pairs(d.lines) do l.Visible = false end
        if d.gh then d.gh.Visible = false end
        if d.yh then d.yh.Visible = false end
        if d.rh then d.rh.Visible = false end
    end

    -- Wire health bar functions
    removeHealthBar = function(player) removeESP(player) end
    createHealthBar = function(player) HealthBarData[player] = true end

    local _skelRenderTick = 0
    RunService.RenderStepped:Connect(function()
        local now = tick()
        if now - _skelRenderTick < 0.05 then return end  -- ~20fps instead of every frame
        _skelRenderTick = now

        if not (_healthOn or _skelOn) then
            if USE_DRAWING then
                for _, d in pairs(_espData) do hideDrawing(d) end
            end
            return
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player == LP then continue end
            local char = player.Character
            local hum  = char and char:FindFirstChild("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hum or not hrp then
                local d = _espData[player]
                if d then
                    if d.mode == "drawing" then hideDrawing(d)
                    else
                        for _, dot in pairs(d.dots) do dot.Enabled = false end
                        if d.hbGui then d.hbGui.Enabled = false end
                    end
                end
                continue
            end

            local d = getOrCreate(player)
            if not d then continue end

            local alive = hum.Health > 0

            if d.mode == "drawing" then
                -- Skeleton lines
                if _skelOn and alive then
                    for i, bone in pairs(BONES) do
                        local p0 = char:FindFirstChild(bone[1])
                        local p1 = char:FindFirstChild(bone[2])
                        local l  = d.lines[i]
                        if p0 and p1 and l then
                            local s0, v0 = _cam:WorldToViewportPoint(p0.Position)
                            local s1, v1 = _cam:WorldToViewportPoint(p1.Position)
                            if v0 and v1 then
                                l.From      = Vector2.new(s0.X, s0.Y)
                                l.To        = Vector2.new(s1.X, s1.Y)
                                l.Color     = _skelColor
                                l.Thickness = _skelThick
                                l.Visible   = true
                            else l.Visible = false end
                        elseif l then l.Visible = false end
                    end
                else
                    for _, l in pairs(d.lines) do l.Visible = false end
                end

                -- Health bar
                if _healthOn and alive then
                    local sp, onScreen = _cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local hp = _cam:WorldToViewportPoint(char:FindFirstChild("Head") and char.Head.Position or hrp.Position)
                        local radius = math.clamp((Vector2.new(hp.X,hp.Y)-Vector2.new(sp.X,sp.Y)).Magnitude, 2, math.huge)
                        local pct = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        local barX = sp.X - radius - 4
                        local bottom = sp.Y + radius * 2
                        local fillTo = bottom - (radius * 4 * pct)
                        d.gh.Visible = false; d.yh.Visible = false; d.rh.Visible = false
                        local bar = pct > 0.5 and d.gh or (pct > 0.2 and d.yh or d.rh)
                        bar.From = Vector2.new(barX, bottom); bar.To = Vector2.new(barX, fillTo)
                        bar.Visible = true
                    else
                        if d.gh then d.gh.Visible = false end
                        if d.yh then d.yh.Visible = false end
                        if d.rh then d.rh.Visible = false end
                    end
                else
                    if d.gh then d.gh.Visible = false end
                    if d.yh then d.yh.Visible = false end
                    if d.rh then d.rh.Visible = false end
                end

            else
                -- Billboard dots (mobile)
                local show = _skelOn and alive
                -- Re-adorn dots if character changed
                for _, bone in pairs(BONES) do
                    for _, partName in pairs(bone) do
                        local dot = d.dots[partName]
                        local part = char:FindFirstChild(partName)
                        if dot and part then
                            dot.Adornee = part
                            dot.Enabled = show
                            -- Update color
                            local frame = dot:FindFirstChildOfClass("Frame")
                            if frame then frame.BackgroundColor3 = _skelColor end
                        elseif not dot and part and show then
                            -- Create missing dot
                            d.dots[partName] = makeJointDot(part)
                        end
                    end
                end

                -- Health bar billboard
                if d.hbGui then
                    d.hbGui.Enabled = _healthOn and alive
                    if _healthOn and alive and d.hbFill then
                        local pct = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        d.hbFill.Size = UDim2.fromScale(1, pct)
                        d.hbFill.BackgroundColor3 = pct > 0.5
                            and Color3.fromRGB(0,255,0)
                            or (pct > 0.2 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,0,0))
                    end
                end
            end
        end

        -- Cleanup left players
        for player in pairs(_espData) do
            if not Players:FindFirstChild(player.Name) then removeESP(player) end
        end
    end)

    local _hbTick = 0
    RunService.Heartbeat:Connect(function()
        if not HealthBar_Enabled then return end
        local now = tick()
        local _hbThrottle = _isMobile and 0.1 or 0.05
        if now - _hbTick < _hbThrottle then return end
        _hbTick = now
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not HealthBarData[p] then HealthBarData[p] = true end
        end
    end)

    -- Health ESP toggle
    VisualsLeft:AddToggle('HealthBarToggle', {
        Text = 'Health ESP', Default = false,
        Tooltip = 'Health bar beside each player',
        Callback = function(v)
            HealthBar_Enabled = v; _healthOn = v
            if not v then
                if USE_DRAWING then
                    for _, d in pairs(_espData) do
                        if d.gh then d.gh.Visible=false end
                        if d.yh then d.yh.Visible=false end
                        if d.rh then d.rh.Visible=false end
                    end
                else
                    for _, d in pairs(_espData) do
                        if d.hbGui then d.hbGui.Enabled=false end
                    end
                end
                if not _skelOn then for _, p in pairs(Players:GetPlayers()) do removeESP(p) end end
            end
        end,
    })

    -- Skeleton ESP toggle
    VisualsLeft:AddToggle('BoxESPToggle', {
        Text    = 'Skeleton ESP',
        Default = false,
        Tooltip = 'Draws skeleton lines between player joints -- works on PC and mobile',
        Callback = function(v)
            _skelOn = v
            if not v then
                if USE_DRAWING then
                    for _, d in pairs(_espData) do
                        for _, l in pairs(d.lines) do l.Visible = false end
                    end
                else
                    for _, d in pairs(_espData) do
                        for _, dot in pairs(d.dots) do dot.Enabled = false end
                    end
                end
                if not _healthOn then for _, p in pairs(Players:GetPlayers()) do removeESP(p) end end
            end
        end,
    }):AddColorPicker('BoxESPColor', {
        Default  = Color3.fromRGB(255, 255, 255),
        Title    = 'Skeleton Color',
        Callback = function(v)
            _skelColor = typeof(v) == 'Color3' and v or (v and v.Value) or _skelColor
            if USE_DRAWING then
                for _, d in pairs(_espData) do
                    for _, l in pairs(d.lines) do l.Color = _skelColor end
                end
            else
                for _, d in pairs(_espData) do
                    for _, dot in pairs(d.dots) do
                        local f = dot:FindFirstChildOfClass("Frame")
                        if f then f.BackgroundColor3 = _skelColor end
                    end
                end
            end
        end,
    })

    VisualsLeft:AddSlider('BoxESPThick', {
        Text = 'Skeleton Thickness', Default = 1, Min = 1, Max = 5, Rounding = 0, Compact = false,
        Callback = function(v)
            _skelThick = v
            if USE_DRAWING then
                for _, d in pairs(_espData) do
                    for _, l in pairs(d.lines) do l.Thickness = v end
                end
            end
        end,
    })
end

VisualsLeft:AddSlider('ChamFillSlider', {
    Text = 'Chams Fill Transparency',
    Default = 50,
    Min = 0.0,
