local _mobileJoystick = Vector2.new(0, 0)
do
    local _joyCenter = nil
    local _joyActive = false

    UserInputService.TouchStarted:Connect(function(touch)
        if not Config.TheBronx.carfly then return end
        local vp = workspace.CurrentCamera.ViewportSize
        if touch.Position.X < vp.X * 0.5 then
            _joyCenter = touch.Position
            _joyActive = true
            _mobileJoystick = Vector2.new(0, 0)
        end
    end)

    UserInputService.TouchMoved:Connect(function(touch)
        if not Config.TheBronx.carfly then return end
        if not _joyActive or not _joyCenter then return end
        local vp = workspace.CurrentCamera.ViewportSize
        if touch.Position.X < vp.X * 0.5 then
            local delta = touch.Position - _joyCenter
            local maxRadius = 60
            local clamped = delta.Magnitude > maxRadius and (delta.Unit * maxRadius) or delta
            _mobileJoystick = Vector2.new(clamped.X / maxRadius, -clamped.Y / maxRadius)
        end
    end)

    UserInputService.TouchEnded:Connect(function(touch)
        if not _joyCenter then return end
        local vp = workspace.CurrentCamera.ViewportSize
        if touch.Position.X < vp.X * 0.5 then
            _joyActive = false
            _joyCenter = nil
            _mobileJoystick = Vector2.new(0, 0)
        end
    end)
end

