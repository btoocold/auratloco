-- Anti-Fling
do
    local _antiFlingConn = nil
    local _antiFlingCharConn = nil
    local _childAddedConn = nil
    local _carNoCollideConn = nil
    local MAX_VELOCITY    = 32   -- normal run/jump speed max
    local MAX_ANGULAR     = 2    -- basically no spin allowed
    local MAX_DISPLACEMENT = 20  -- snap back if moved more than 20 studs in one frame
    local _lastSafePos = nil

    local function _applyAntiFling(char)
        if _antiFlingConn then _antiFlingConn:Disconnect() _antiFlingConn = nil end
        if _childAddedConn then _childAddedConn:Disconnect() _childAddedConn = nil end
        local root = char:WaitForChild("HumanoidRootPart", 5)
        local hum = char:WaitForChild("Humanoid", 5)
        if not root or not hum then return end
        _lastSafePos = root.Position

        -- Nuke any foreign BodyMovers that get injected (fling scripts love these)
        local function _checkChild(obj)
            if not Toggles.PF_AntiFling.Value then return end
            if obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyThrust")
                or obj:IsA("BodyAngularVelocity") or obj:IsA("LinearVelocity") or obj:IsA("VectorForce") then
                -- Don't destroy our own fly velocity
                if getgenv().flyData and obj == getgenv().flyData.velocity then return end
                if getgenv().flyData and obj == getgenv().flyData.gyro then return end
                pcall(function() obj:Destroy() end)
            end
        end
        _childAddedConn = root.ChildAdded:Connect(_checkChild)
        -- Clean any already-existing foreign movers
        for _, obj in pairs(root:GetChildren()) do
            task.spawn(_checkChild, obj)
        end

        -- Throttled no-collide scan: other players every 0.5s (cheap), cars every frame (no gap)
        local _noCollideTimer = 0
        local NO_COLLIDE_INTERVAL = 0.5
        local function _setNoCollide()
            if not Toggles.PF_AntiFling.Value then return end
            for _, p in pairs(game:GetService("Players"):GetPlayers()) do
                if p ~= LP and p.Character then
                    for _, part in pairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end
        -- Car noclip on its own Heartbeat — runs every single frame so there's zero gap where a car can clip you
        if _carNoCollideConn then _carNoCollideConn:Disconnect() end
        _carNoCollideConn = RunService.Heartbeat:Connect(function()
            if not Toggles.PF_AntiFling.Value then return end
            local civCars = workspace:FindFirstChild("CivCars")
            if not civCars then return end
            for _, car in pairs(civCars:GetChildren()) do
                for _, part in pairs(car:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)

        _antiFlingConn = RunService.Heartbeat:Connect(function(dt)
            if not Toggles.PF_AntiFling.Value then return end
            if not root or not root.Parent then return end

            -- Hard zero any velocity above threshold
            local vel = root.AssemblyLinearVelocity
            if vel.Magnitude > MAX_VELOCITY then
                root.AssemblyLinearVelocity = Vector3.zero
            end

            -- Kill ALL spin instantly
            if root.AssemblyAngularVelocity.Magnitude > MAX_ANGULAR then
                root.AssemblyAngularVelocity = Vector3.zero
            end

            -- Snap back if displaced too far
            local displacement = (root.Position - _lastSafePos).Magnitude
            if displacement > MAX_DISPLACEMENT and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
                root.Anchored = true
                root.CFrame = CFrame.new(_lastSafePos) * (root.CFrame - root.CFrame.Position)
                root.AssemblyLinearVelocity  = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                task.defer(function() if root then root.Anchored = false end end)
            else
                _lastSafePos = root.Position
            end

            -- Zero out all part velocities in character too
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part ~= root then
