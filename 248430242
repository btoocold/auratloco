do
    local _instantRespawnOn = false
    local _diedConn         = nil
    local _charConn         = nil

    local function _hookDied(char)
        -- Disconnect any previous died connection for this character
        if _diedConn then _diedConn:Disconnect() _diedConn = nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
            or char:WaitForChild("Humanoid", 5)
        if not hum then return end

        _diedConn = hum.Died:Connect(function()
            if not _instantRespawnOn then return end
            -- Fire every known respawn remote immediately, regardless of kill cause
            task.spawn(function()
                -- Method 1: game's own RespawnRE remote
                pcall(function() RepS.RespawnRE:FireServer() end)
                -- Method 2: LoadCharacter remote (used by some games)
                local rc = RepS:FindFirstChild("LoadCharacter")
                if rc and rc:IsA("RemoteEvent") then
                    pcall(function() rc:FireServer() end)
                elseif rc and rc:IsA("RemoteFunction") then
                    pcall(function() rc:InvokeServer() end)
                end
                -- Method 3: native LoadCharacter (works in many games)
                pcall(function() LP:LoadCharacter() end)
                -- Retry loop -- keep hammering until the character actually respawns
                local t0 = tick()
                while _instantRespawnOn and tick() - t0 < 5 do
                    task.wait(0.05)
                    local c = LP.Character
                    local h = c and c:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then break end -- respawned successfully
                    pcall(function() RepS.RespawnRE:FireServer() end)
                    local rc2 = RepS:FindFirstChild("LoadCharacter")
                    if rc2 and rc2:IsA("RemoteEvent") then
                        pcall(function() rc2:FireServer() end)
                    end
                    pcall(function() LP:LoadCharacter() end)
                end
            end)
        end)
    end

    local function _enableInstantRespawn()
        _instantRespawnOn = true
        _G.respawn = true
        -- Hook current character
        if LP.Character then
            _hookDied(LP.Character)
        end
        -- Re-hook on every future respawn
        _charConn = LP.CharacterAdded:Connect(function(char)
            if not _instantRespawnOn then return end
            _hookDied(char)
        end)
    end

    local function _disableInstantRespawn()
        _instantRespawnOn = false
        _G.respawn = false
        if _diedConn  then _diedConn:Disconnect()  _diedConn  = nil end
        if _charConn  then _charConn:Disconnect()   _charConn  = nil end
    end

    PlayerFeatures:AddToggle('PF_InstantRespawn', {
        Text    = 'Instant Respawn',
        Default = false,
        Tooltip = 'Respawns you instantly on death regardless of kill cause',
        Callback = function(v)
            if v then _enableInstantRespawn()
            else      _disableInstantRespawn()
            end
        end,
    })
end

