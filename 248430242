    local label                  = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3             = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.5
    label.Font                   = Enum.Font.SourceSansBold
    label.TextSize               = 11
    label.Text                   = player.Name
    label.Parent                 = billboard
    ESPData2[player]         = ESPData2[player] or {}
    ESPData2[player].NameESP = billboard
end

local function createTracer(player)
    if player == LP then return end
    if not player.Character then return end
    local hrp      = player.Character:FindFirstChild("HumanoidRootPart")
    local localHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not localHrp then return end
    if ESPData2[player] and ESPData2[player].Tracer then return end
    local line        = Instance.new("Part")
    line.Name         = "TracerLine"
    line.Anchored     = true
    line.CanCollide   = false
    line.Transparency = 0
    line.Material     = Enum.Material.Neon
    line.Color        = _tracerColor
    line.Size         = Vector3.new(0.05, 0.05, 1)
    line.Parent       = workspace
    ESPData2[player]        = ESPData2[player] or {}
    ESPData2[player].Tracer = line
end

local function updateTracer(player)
    local data = ESPData2[player]
    if not data or not data.Tracer then return end
    local hrp      = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local localHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not localHrp then
        pcall(function() data.Tracer.Transparency = 1 end)
        return
    end
    local startPos = localHrp.Position
    local endPos   = hrp.Position
    local midPoint = (startPos + endPos) / 2
    pcall(function()
        data.Tracer.Size         = Vector3.new(0.05, 0.05, (endPos - startPos).Magnitude)
        data.Tracer.CFrame       = CFrame.new(midPoint, endPos)
        data.Tracer.Transparency = 0
    end)
end

local _lastHeldName = {}  -- [player] = last known tool name

local function updateHoldingLabel(player)
    if player == LP then return end
    if not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local label = HoldingLabels[player]
    if label and not label.Parent then
        HoldingLabels[player] = nil
        label = nil
    end
    if not label then
        label             = Instance.new("BillboardGui")
        label.Name        = "HoldingLabel"
        label.Adornee     = hrp
        label.AlwaysOnTop = true
        label.Size        = UDim2.new(0, 100, 0, 20)
        label.StudsOffset = Vector3.new(0, -3, 0)
        label.Parent      = hrp
        local tl                  = Instance.new("TextLabel")
        tl.Name                   = "TextLabel"
        tl.Size                   = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextColor3             = Color3.new(1, 1, 1)
        tl.TextStrokeTransparency = 0.5
        tl.Font                   = Enum.Font.SourceSansBold
        tl.TextSize               = 9
        tl.Text                   = ""
        tl.Parent                 = label
        HoldingLabels[player] = label
    end
    local holdingName = "Fists"
    for _, item in pairs(player.Character:GetChildren()) do
        if item:IsA("Tool") then holdingName = item.Name break end
    end
    if _lastHeldName[player] == holdingName then return end  -- nothing changed, skip
    _lastHeldName[player] = holdingName
    local tl = label:FindFirstChild("TextLabel")
    if tl then tl.Text = holdingName end
end

local function setupSecondaryESP(player)
    if player == LP then return end
    if player.Character then
        if NameESP_Enabled    then createNameESP(player)      end
        if Tracer_Enabled     then createTracer(player)       end
        if HoldingESP_Enabled then updateHoldingLabel(player) end
        if HealthBar_Enabled  then createHealthBar(player)    end
    end
    player.CharacterAdded:Connect(function()
        task.wait(0.15)
        removeSecondaryESP(player)
        removeHoldingLabel(player)
        removeHealthBar(player)
        if NameESP_Enabled    then createNameESP(player)      end
        if Tracer_Enabled     then createTracer(player)       end
        if HoldingESP_Enabled then updateHoldingLabel(player) end
        if HealthBar_Enabled  then createHealthBar(player)    end
    end)
end

Players.PlayerRemoving:Connect(function(player)
    removeSecondaryESP(player)
    removeHoldingLabel(player)
    _lastHeldName[player] = nil
end)
