    local function _hideNoisyFitMessage(obj)
        if not _suppressFitMessages or not obj or not obj:IsA('TextLabel') then return end
        local txt = tostring(obj.Text or ''):lower()
        for _, phrase in ipairs(_blockedFitMessages) do
            if txt:find(phrase, 1, true) then
                obj.TextTransparency = 1
                obj.TextStrokeTransparency = 1
                obj.Visible = false
                pcall(function() obj.Size = UDim2.new(0, 0, 0, 0) end)
                pcall(function() obj:Destroy() end)
                return
            end
        end
    end

