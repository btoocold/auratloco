        end
        pg.DescendantAdded:Connect(function(obj)
            if not obj or not obj.Parent then return end
            local ok, isLabel = pcall(function() return obj:IsA('TextLabel') end)
            if not ok or not isLabel then return end
            task.defer(function()
                if obj and obj.Parent then
                    pcall(function() _hideNoisyFitMessage(obj) end)
                end
            end)
            pcall(function()
                obj:GetPropertyChangedSignal('Text'):Connect(function()
                    if obj and obj.Parent then
                        pcall(function() _hideNoisyFitMessage(obj) end)
                    end
                end)
            end)
        end)
    end)

    local function _removeCloth(category, itemName)
        -- The real clothing UI sends: ClothShopRemote:FireServer(ButtonText, Category, ItemName)
        -- Normal removals need the exact item name.
        _callRemote('ClothShopRemote', 'Remove', category, itemName)
        task.wait(0.0)

        -- Shirts/Pants have a built-in Default option in the real shop.
        -- Wearing Default is the reliable reset path for shirt/pants.
        if category == 'Shirts' or category == 'Pants' then
            _callRemote('ClothShopRemote', 'Wear', category, 'Default')
            task.wait(0.0)
        end
    end

    local function _resetShirtPantsToDefault()
        _callRemote('ClothShopRemote', 'Wear', 'Shirts', 'Default')
        task.wait(0.05)
        _callRemote('ClothShopRemote', 'Wear', 'Pants', 'Default')
        task.wait(0.05)

        -- Client visual fallback only. Server should handle the real reset through Wear Default.
        local char = _lp.Character
        if char then
            local shirt = char:FindFirstChildOfClass('Shirt')
            local pants = char:FindFirstChildOfClass('Pants')
            local defaultShirt = _lp:GetAttribute('Shirt')
            local defaultPants = _lp:GetAttribute('Pants')
            if shirt and defaultShirt then pcall(function() shirt.ShirtTemplate = tostring(defaultShirt) end) end
            if pants and defaultPants then pcall(function() pants.PantsTemplate = tostring(defaultPants) end) end
        end
    end

    local function _removeGloves()
        local char = _lp.Character
        local hum = char and char:FindFirstChildOfClass('Humanoid')

        -- If a preset glove is currently worn, activate that same glove again first.
        -- This mirrors the manual left-click behavior and prevents the old glove
        -- visual from staying when switching to another preset.
        if _activeFitGlove then
            _equipAndActivateTool(_activeFitGlove)
            task.wait(0.2)
            _activeFitGlove = nil
        end

        if hum then pcall(function() hum:UnequipTools() end) end

        -- Clean local glove tools only after the toggle-off attempt above.
        for _, itemName in ipairs(_gloveItems) do
            local aliases = _gloveAlias[itemName] or {itemName}
            for _, root in ipairs({char, _lp:FindFirstChildOfClass('Backpack'), _lp:FindFirstChild('Backpack')}) do
                if root then
                    for _, child in ipairs(root:GetChildren()) do
                        local childKey = tostring(child.Name):lower():gsub('%s+', '')
                        for _, n in ipairs(aliases) do
                            local aliasKey = tostring(n):lower():gsub('%s+', '')
                            if childKey == aliasKey and (child:IsA('Tool') or child:IsA('Model') or child:IsA('Accessory')) then
                                pcall(function() child:Destroy() end)
                            end
                        end
                    end
                end
            end
        end
    end

    local function _removeAllPresetClothes(noNotify, skipGloves)
        local seen = {}

        -- Remove every exact preset item first.
        for _, preset in pairs(_fitPresets) do
            if preset.Cloth then
                for _, data in ipairs(preset.Cloth) do
                    local key = data[1] .. '|' .. data[2]
                    if not seen[key] then
                        seen[key] = true
                        _removeCloth(data[1], data[2])
                    end
                end
            end
        end

        -- Strong shirt/pants reset. This is why the old reset wasn't clearing those reliably.
        _resetShirtPantsToDefault()

        -- No broad empty Remove calls here; those caused noisy bottom errors.
        -- Exact preset items are removed above, then shirt/pants default is applied.

        if not skipGloves then
            _removeGloves()
        end

        if not noNotify then
            NotificationLibrary:SendNotification('Fits', 'Clothes reset finished.', 3)
        end
    end

